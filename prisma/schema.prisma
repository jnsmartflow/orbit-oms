  // (app/api/import/obd/route.ts:344) leaves the human's pick alone.
  // Both are meaningless alone — a date with no window is not a slot — so the
  // carry writes them together or not at all.
  // @db.Date (NOT Timestamptz): this is a calendar day, matching
  // orders.dispatchTargetDate. Live FK: mo_orders_dispatchwindowid_fkey
  // (lowercase — Postgres folded the unquoted name) ON DELETE SET NULL.
  dispatchTargetDate       DateTime?              @db.Date
  dispatchWindowId         Int?
