// ─────────────────────────────────────────────
// MRN — MATERIAL RECEIPT NOTE
// ─────────────────────────────────────────────

// Inbound goods receipt (v27.16, 2026-08-20; **v27.17** 2026-08-22 —
// mrn_line_batches.bestBeforeMonth/Year made NULLABLE and retired from every
// surface, see that model's header). The only module that records
// stock coming INTO the depot; it touches nothing in the OBD/orders pipeline.
// Design record: docs/prompts/drafts/web-update-2026-08-20-mrn-module-design.md
//
// All three tables were created BY HAND in the Supabase SQL Editor and are
// hand-mirrored here; never db push, never db pull (CORE §3 — db pull also
// fails P1001 on this machine). camelCase columns, NO @map — the pick_findings
// convention, deliberately NOT pick_assignments' snake_case legacy. Every
// timestamp carries @db.Timestamptz(6) and every date @db.Date, or Prisma
// emits a plain `timestamp` and mismatches the live column (CORE §7.1.c).
//
// Every index and unique name below is ALREADY Prisma's default for its shape,
// so no `map:` argument is needed anywhere in this section — checked name by
// name against pg_indexes, not assumed (contrast pick_findings_order_idx,
// which does need one).

// ⚠ FOUR FKs to `users` on this ONE table (createdById / unloadingStartById /
// unloadingEndById / removedById), plus a fifth from mrn_lines below. ALL FIVE
// relations must stay explicitly NAMED on BOTH sides — here and on the `users`
// model — or Prisma throws an ambiguity ERROR at generate time, not a warning.
// Same discipline as pick_findings' two and pick_assignments' three (CORE
// §7.3), at double the usual scale.
//
// NOT EXPRESSIBLE IN PRISMA — live in Supabase, recorded here by hand:
//   chk_mrn_status         CHECK (status IN ('open','checking','done'))
//   chk_mrn_received_from  CHECK ("receivedFrom" IN ('TPW','CDC'))
// A fourth status value or a third source depot is a SQL ALTER on the
// constraint FIRST — never just a new literal in a route or a new option in a
// segmented control. Same class as chk_pick_assignments_status (CORE §7.4).
//
// ⚠ srNo is UNIQUE per mrnDate and this table SOFT-deletes (isRemoved). The
// srNo/mrnNumber allocator MUST COUNT REMOVED ROWS — it is the one read on
// this table that deliberately does not filter isRemoved, exactly like challan
// sequence allocation (CORE §13). Every other read filters isRemoved=false,
// and a removed MRN disappears from BOTH faces.
//
// ⚠ mrnDate and truckReportingDate are DIFFERENT THINGS, and are usually the
// same day — which is what makes confusing them easy. mrnDate = the IST date
// the MRN was raised; it partners srNo in the unique key and drives billing's
// date stepper. truckReportingDate = the day the truck reported; it is what
// every screen labelled "reported" shows, and what the age tags key off. BOTH
// are immutable after create — editing truckReportingDate later must never
// renumber anything.
model mrn {
  id                 Int      @id @default(autoincrement())
  mrnNumber          String   @unique
  mrnDate            DateTime @db.Date
  srNo               Int
  truckReportingDate DateTime @db.Date
  receivedFrom       String
  receivingWarehouse String   @default("Surat")
  stiRefNo           String?
  deliveryNo         String?
  otrNo              String?
  status             String   @default("open")

  unloadingStartAt   DateTime? @db.Timestamptz(6)
  unloadingStartById Int?
  unloadingStartBy   users?    @relation("MrnUnloadingStartedBy", fields: [unloadingStartById], references: [id])
  unloadingEndAt     DateTime? @db.Timestamptz(6)
  unloadingEndById   Int?
  unloadingEndBy     users?    @relation("MrnUnloadingEndedBy", fields: [unloadingEndById], references: [id])

  // Billing's close-out (v27.19, 2026-09-01). The FOURTH status, 'closed',
  // sits after 'done': the supervisor ends the unloading, then billing records
  // the OTR number and closes the truck. Live CHECK is now
  //   chk_mrn_status: status IN ('open','checking','done','closed')
  // and lib/mrn/types.ts MrnStatus must carry all four — asMrnStatus() THROWS
  // on an unrecognised value, deliberately, so drift is loud.
  //
  // Both columns are NULLABLE and were NOT backfilled: the ten MRNs that
  // predate this are 'done' and never become 'closed'. A backfilled closedAt
  // would be a timestamp for a closing that never happened.
  //
  // 🔴 closedById is ON DELETE SET NULL live, matching unloadingStartById /
  // unloadingEndById / removedById above — Prisma's default for an OPTIONAL
  // relation is already SetNull, so this needs no onDelete: argument, exactly
  // like its three siblings. Do NOT "correct" it to Restrict; that is
  // createdById's rule below and it is a different rule for a different reason.
  closedAt   DateTime? @db.Timestamptz(6)
  closedById Int?
  closedBy   users?    @relation("MrnClosedBy", fields: [closedById], references: [id])

  isRemoved   Boolean   @default(false)
  removedAt   DateTime? @db.Timestamptz(6)
  removedById Int?
  removedBy   users?    @relation("MrnRemovedBy", fields: [removedById], references: [id])

  // ON DELETE RESTRICT live, deliberately unlike the three SET NULL FKs above:
  // an MRN must always know who raised it. Prisma's default action for a
  // REQUIRED relation is already Restrict, so this matches with no onDelete:
  // argument — stated here so nobody "adds the missing one" and changes it.
  createdById Int
  createdBy   users @relation("MrnCreatedBy", fields: [createdById], references: [id])

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  // @updatedAt, NOT a plain @default(now()). The live column is NOT NULL
  // DEFAULT now() with no trigger, so the DB covers INSERT only — precisely
  // the shape that made push_subscriptions.updatedAt a landmine (CORE §13).
  // Every write to this table goes through Prisma, so letting Prisma stamp
  // UPDATEs removes that whole class instead of documenting it.
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  lines  mrn_lines[]
  photos mrn_photos[]

  @@unique([mrnDate, srNo])
  @@index([mrnDate(sort: Desc)])
  @@index([status])
}

// One row per STI line, as pasted by billing.
//
// ⚠ `skuCode` is the raw SAP material code as typed — NOT a catalog row id,
// and deliberately NOT an FK. Resolve it against sku_master_v2.material with a
// raw-code fallback, NEVER via any id: the two catalog tables share ZERO id
// space (CORE §13, the id-space landmine), so an id-based lookup renders a
// confidently WRONG product name and pack. A code absent from the catalog is a
// normal state, not an error — ~27% of distinct active SAP codes resolve in
// neither table, and the screens render "Not in catalog" with a bare code.
//
// ⚠ There is deliberately NO shortQty / excessQty column. Short and Excess are
// DERIVED — max(0, qtySti - physicalQty) and max(0, physicalQty - qtySti) —
// computed at render and at export. Storing them would let two places
// disagree. The report's eight condition columns are the six below plus those
// two derived values.
model mrn_lines {
  id    Int @id @default(autoincrement())
  mrnId Int
  mrn   mrn @relation(fields: [mrnId], references: [id], onDelete: Cascade)

  // The delivery number this line arrived under (v27.20, 2026-09-01). One STI
  // can carry several, so it belongs to the LINE, not the header.
  //
  // 🔴 NO @default("") HERE, AND THE MISMATCH WITH THE LIVE COLUMN IS
  // DELIBERATE AND TEMPORARY. The database currently has DEFAULT '' — pure
  // scaffolding, added so the column could be created NOT NULL on a table with
  // 377 rows in it, and dropped by Part 4 of
  // docs/prompts/drafts/sql-2026-09-01-mrn-delivery-split.sql in STEP 6.
  //
  // Modelling that default here would defeat the column: Prisma would make the
  // field optional on create, and any future writer could omit it and have its
  // lines filed silently under '' — the unnamed group nobody looks in. Leaving
  // it out makes the field REQUIRED in TypeScript, so the compiler catches the
  // omission at the one moment it is cheap. Do not "fix" this to match the DB.
  //
  // ⚠ '' IS A REAL VALUE, NOT A NULL. 32 live lines carry it (MRN-2026-00001,
  // -00003, -00013 had no header delivery number to backfill from). The column
  // is NOT NULL precisely so the unique index below works: Postgres treats
  // NULLs as DISTINCT from each other, so a nullable column would silently
  // permit duplicate line numbers on exactly those rows.
  deliveryNo String

  lineNo      Int
  skuCode     String
  qtySti      Int
  // The one supervisor-shaped column billing fills: it comes off the STI sheet.
  cartonQty   Int?
  physicalQty Int?
  isChecked   Boolean   @default(false)
  checkedAt   DateTime? @db.Timestamptz(6)
  checkedById Int?
  checkedBy   users?    @relation("MrnLineCheckedBy", fields: [checkedById], references: [id])

  // Condition split of what physically arrived. QTD's meaning is UNKNOWN — it
  // is carried through the schema, the UI and the report because the source
  // workbook has it. Do not repurpose it.
  sndQty    Int?
  leakyQty  Int?
  damageQty Int?
  emptyQty  Int?
  qtdQty    Int?
  rejQty    Int?

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  // @updatedAt for the same reason as mrn.updatedAt above.
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  batches mrn_line_batches[]
  photos  mrn_photos[]

  // 🔴 THE KEY GAINED deliveryNo ON 2026-09-01, REPLACING @@unique([mrnId, lineNo]).
  // Each delivery numbers its own lines from 1 (owner ruling), so two deliveries
  // on one truck both have a line 1 and the old pair is no longer unique.
  //
  // ⚠ THE STORED lineNo IS THEREFORE NO LONGER "the nth line of this MRN".
  // It is the nth line OF ITS DELIVERY. Anything that reads it as a position on
  // the truck is now wrong — the supervisor's phone shows a RUNNING POSITION
  // computed across the MRN instead (step 4).
  //
  // Both names below are Prisma's own defaults and match the live indexes
  // exactly — mrn_lines_mrnId_deliveryNo_lineNo_key and
  // mrn_lines_mrnId_deliveryNo_idx, verified against pg_indexes 2026-09-01 —
  // so no `map:` is needed (same situation as orders.@@index([invoiceNo]);
  // contrast pick_findings, which does need one).
  @@unique([mrnId, deliveryNo, lineNo])
  // Backs the per-delivery reads and the DISTINCT that builds billing's tabs.
  @@index([mrnId, deliveryNo])
  @@index([skuCode])
}

// One row per manufacturing batch on a line. USUALLY exactly one; a line
// occasionally splits across two or more (46 tins: 30 from Jun-26, 16 from
// Jul-26), which is what makes this a table rather than four columns on
// mrn_lines. The single-batch case is still a batch row — one owner per
// behaviour, so a split line and a plain line take the identical code path.
//
// NOT EXPRESSIBLE IN PRISMA — live in Supabase, recorded here by hand:
//   chk_mrn_batch_qty        CHECK (qty > 0)
//   chk_mrn_batch_mfg_month  CHECK ("mfgMonth" BETWEEN 1 AND 12)
//   chk_mrn_batch_bb_month   CHECK ("bestBeforeMonth" BETWEEN 1 AND 12)
//                            ⚠ STILL LIVE, and harmless now the column is
//                            nullable: a CHECK passes when its expression is
//                            NULL (NULL is not FALSE), so a row with no
//                            best-before satisfies it. Left in place rather
//                            than dropped — if the field is ever collected
//                            again the guard is already there.
// There is deliberately NO year constraint on either pair — "a reasonable
// year" is a UI judgement that ages, not an invariant (the pick_findings
// precedent).
//
// ⚠ qty > 0 means a line confirmed at physicalQty = 0 carries NO batch row at
// all. That is an ALLOWED state, decided 2026-08-20: a truck genuinely
// bringing none of a line is a real receipt. Mfg and Best-before render "—" on
// screen and blank in the export, and Short derives to the full qtySti. Zero
// batches is not a missing write.
//
// ⚠ SUM(qty) across a line's batches must equal mrn_lines.physicalQty. The DB
// does NOT enforce that — it lives in the confirm route and in the line
// sheet's own arithmetic. Same "dependency no CHECK can hold" class as
// pick_findings' reason↔mfgMonth rule (CORE §7.4).
//
// 🔴 bestBeforeMonth / bestBeforeYear ARE DELIBERATELY UNUSED as of 2026-08-22
// (v27.17), and NULLABLE in live — the ALTER ran through Smart Flow and was
// SELECT-verified before any code changed.
//
// THIS IS NOT A FORGOTTEN FIELD. Nothing collects it and nothing displays it:
// the supervisor does not record a best-before date, so the pickers were
// removed from the line sheet, the requirement was removed from
// validateBatches(), the confirm route no longer accepts it, and the column
// was removed from the desktop lines table. A future session reading these two
// columns as "we capture this, it just isn't shown" would be wrong.
//
// The columns STAY rather than being dropped because the decision is about who
// records the data, not about whether the shape is right — if the depot ever
// starts capturing it, the column, its CHECK and the type are all still here.
// Every row written from 2026-08-22 onward has NULL in both.
//
// ⚠ chk_mrn_batch_bb_month is STILL LIVE and is harmless now the column is
// nullable: a CHECK passes when its expression is NULL (NULL is not FALSE), so
// a row with no best-before satisfies it. Left in place deliberately.
//
// History, so the reversal is not re-reversed: an early design derived these as
// manufacturing + 24 months and rendered them read-only. That was corrected
// 2026-08-20 to TYPED-by-the-supervisor, because shelf life varies by product
// and there is nothing to calculate from. Two days later the field was dropped
// altogether. Do NOT reintroduce a 24-month default in either direction.
model mrn_line_batches {
  id              Int       @id @default(autoincrement())
  lineId          Int
  line            mrn_lines @relation(fields: [lineId], references: [id], onDelete: Cascade)
  batchNo         Int
  qty             Int
  mfgMonth        Int
  mfgYear         Int
  // Nullable since v27.17 — see the block above. Not collected, not displayed.
  bestBeforeMonth Int?
  bestBeforeYear  Int?
  createdAt       DateTime  @default(now()) @db.Timestamptz(6)

  @@unique([lineId, batchNo])
}

// Photographic evidence attached to a truck or to one of its lines
// (v27.19, 2026-09-01). Design: docs/prompts/drafts/web-update-2026-08-31-mrn-photos-otr.md §4.1.
// DDL: docs/prompts/drafts/sql-2026-08-31-mrn-photos-otr.sql. Hand-mirrored —
// db push AND db pull are both banned/broken here (CORE §3).
//
// 🔴 ONE TABLE, NOT TWO, and `lineId` is what carries the difference:
//   NULL  = truck-level (the LR document covers the whole consignment)
//   set   = this SKU line (a leaky/damaged tin on line 18)
// A second table for the truck-level case would have duplicated every column
// to express one nullable pointer.
//
// ⚠ NO `updatedAt`, AND THAT IS THE DESIGN. A photo is immutable — a retake is
// delete-and-capture, never an edit — so there is no second timestamp to keep
// honest and no @updatedAt landmine (CORE §13) to inherit.
//
// ⚠ NO CAPTION COLUMN IN v1. There is no free-text column anywhere in the MRN
// tables (mrn holds identifiers and status, mrn_lines holds only skuCode,
// mrn_line_batches holds none). Adding the first one is its own decision.
//
// ⚠ `storagePath` IS A PATH INSIDE THE BUCKET, NEVER A URL. A stored URL
// expires and leaves a broken image with no way back to the object; the read
// path mints a signed URL per view (the pattern
// app/api/admin/attendance/photo/route.ts:44 already uses).
model mrn_photos {
  id Int @id @default(autoincrement())

  mrnId Int
  mrn   mrn @relation(fields: [mrnId], references: [id], onDelete: Cascade)

  // 🔴 CASCADE IS SAFE ONLY BECAUSE OF A GATE ELSEWHERE. lines PUT does
  // deleteMany + createMany on mrn_lines (app/api/mrn/[mrnId]/lines/route.ts:300),
  // which would take attached photos with it — but that route 409s unless
  // status === 'open' (:116-125), and photos only exist from 'checking' onward.
  // The windows cannot overlap, and the ladder is one-way. If a reopen or
  // un-start is ever added, change this to SetNull in the SAME commit.
  lineId Int?
  line   mrn_lines? @relation(fields: [lineId], references: [id], onDelete: Cascade)

  // Live CHECK chk_mrn_photo_kind: kind IN ('lr','leaky','damage','other').
  // Prisma cannot express a CHECK, so the closed vocabulary is enforced twice —
  // here by the DB, and in TypeScript by the union in lib/mrn/types.ts. Same
  // arrangement as mrn.status / mrn.receivedFrom. Widening it is an ALTER
  // FIRST, then the union.
  //
  // A second live CHECK, chk_mrn_photo_lr_truck_level, enforces
  //   kind <> 'lr' OR "lineId" IS NULL
  // — an LR is a truck-level document and can never belong to one SKU line.
  // Also invisible to Prisma; the write route must uphold it.
  kind String

  // UNIQUE live as mrn_photos_storagePath_key — one row per storage object.
  // Two rows pointing at one object make a delete half-work: the survivor looks
  // intact in Postgres and 404s in the browser.
  storagePath String @unique

  // bytes is NOT NULL because size accounting reads it; the two dimensions are
  // NULLABLE because they are only a thumbnail hint. A future non-camera upload
  // path has a byte count for free but would have to decode the image to learn
  // its dimensions. Design §4.1.
  bytes    Int
  widthPx  Int?
  heightPx Int?

  // NOT NULL, and RESTRICT live — the same rule as mrn.createdById and
  // deliberately NOT the SET NULL the other actor columns get. This row IS
  // evidence; it must always know who produced it.
  capturedById Int
  capturedBy   users @relation("MrnPhotoCapturedBy", fields: [capturedById], references: [id])

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  // Prisma's default names for these three are exactly the live ones —
  // mrn_photos_mrnId_idx, mrn_photos_mrnId_kind_idx, mrn_photos_lineId_idx —
  // so no `map:` is needed (same situation as orders.@@index([invoiceNo])
  // above; contrast pick_findings, which DOES need one). Verified against
  // pg_indexes on 2026-09-01. The @unique above is likewise
  // mrn_photos_storagePath_key by default.
  @@index([mrnId])
  @@index([mrnId, kind])
  @@index([lineId])
}

// ── CI module — Goods Return Note (CI-Form), 2026-09-01 ──────────────────────
//
// The RETURN counterpart to MRN, running the opposite way: MRN is stock coming
// IN from TPW/CDC and is started by billing; CI is stock coming BACK from a
// customer and is started by the FLOOR SUPERVISOR on his phone, then finished
// by the billing operator at the desk.
//
// Spec: docs/prompts/drafts/web-update-2026-08-31-ci-module.md (v3.1, §6).
// DDL:  sql/2026-08-31-ci-module.sql — ALREADY RUN against production.
//
// ⚠ HAND-MIRRORED FROM THE LIVE DATABASE, field by field, on 2026-09-01.
// `npx prisma db pull` cannot run on this machine (P1001 — the Supabase direct
// host is IPv6-only, the depot ISP is IPv4-only; CORE §3). These three models
// were reconciled against information_schema.columns for name, type,
// nullability and numeric precision. Never `db push`, never `db pull`.
//
// 🔴 THREE TABLES, NOT FOUR — THERE IS DELIBERATELY NO BATCH CHILD TABLE.
// MRN needs mrn_line_batches because one inbound line can split across
// manufacturing dates. A CI takes a single quantity per line and has nothing to
// split, and v1 captures no manufacturing dates at all. Copying MRN's schema
// wholesale is the obvious mistake, which is why this is written down. If mfg
// dates are ever added they need a child table — a mfgMonth/mfgYear pair on the
// line cannot express a split — and do NOT copy MRN's bestBefore* pair, nullable
// since v27.17 and retired from every surface.

// The reason picker's vocabulary. A MASTER TABLE, NOT A CHECK CONSTRAINT
// (spec §3.1): the list will change, and a CHECK makes every change a schema
// migration. Retire a reason with isActive = false and NEVER DELETE — old CIs
// must keep pointing at the reason they were raised under, which is also why
// ci_returns snapshots `reasonLabel` beside the FK.
//
// 8 rows live (sortOrder 1-8; the first three isPinned, shown above a divider
// in the picker with the rest under "More"). They are ALSO in prisma/seed.ts —
// without that, a wipe-and-reseed leaves this table EMPTY and the reason picker
// breaks with no error message.
model ci_reason_master {
  id        Int      @id @default(autoincrement())
  code      String   @unique
  label     String
  sortOrder Int
  isPinned  Boolean  @default(false)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  ciReturns ci_returns[] @relation("CiReturnReason")
}

// The CI header. 32 columns.
//
// 🔴 FIVE LIVE CHECK CONSTRAINTS — NOT EXPRESSIBLE IN PRISMA (CORE §7.4), so
// they are invisible in this file and are recorded here by hand:
//   chk_ci_returns_status         CHECK (status IN ('draft','submitted','closed','returned_to_floor'))
//   chk_ci_returns_return_type    CHECK ("returnType" IN ('full','part'))
//   chk_ci_returns_material_moved CHECK ("materialMoved" IN ('moved','not_moved'))
//   chk_ci_returns_source         CHECK (source IN ('manual','auto_finding','auto_bill_only','floor'))
//                                   (auto_bill_only added 2026-09-22, Schema v27.39;
//                                    floor added 2026-09-22, Schema v27.40)
//   chk_ci_returns_complete_when_not_draft
//     CHECK (status = 'draft' OR ("materialMoved" IS NOT NULL
//            AND "materialReceivedDate" IS NOT NULL
//            AND "reasonId" IS NOT NULL AND "reasonLabel" IS NOT NULL))
//
// 🔴 THE FIFTH ONE IS LOAD-BEARING: IT IS WHAT STOPS AN INCOMPLETE CI BEING
// SUBMITTED. Those four columns are NULLABLE precisely so a draft can exist
// before the supervisor has answered the details step (owner ruling
// 2026-09-01 — a draft carries NULL, never a placeholder). This CHECK is what
// makes that safe: nullable in a draft, MANDATORY the moment status stops
// being 'draft'. Without it, "nullable" would mean a submitted CI could be
// missing its reason.
//
// ⚠ IT IS THE BACKSTOP, NOT THE ERROR MESSAGE. app/api/ci/[ciId]/submit/route.ts
// validates all four itself and names the missing one, because a raw
// "violates check constraint chk_ci_returns_complete_when_not_draft" reaching a
// supervisor's phone is not something he can act on. If that string ever
// surfaces in the UI, the route's guard has a hole — fix the guard, do not
// weaken the CHECK.
//
// ⚠ A NULL "materialMoved" also satisfies chk_ci_returns_material_moved above:
// `NULL = ANY(ARRAY[...])` is NULL, and a CHECK passes on anything that is not
// FALSE. The two constraints therefore compose correctly and neither needed
// changing when the columns went nullable.
// A FIFTH status value needs a SQL ALTER on chk_ci_returns_status in the
// Supabase SQL Editor FIRST — never just a new string in application code. THE
// COUNT IS OVER WHAT THE CHECK PERMITS, NOT OVER WHAT ANY CODE WRITES: the
// CHECK permits FOUR and the ladder writes THREE, because 'returned_to_floor'
// is in the list from day one (spec §11.1) and is written by nothing. So the
// fourth value needs no ALTER — it is already allowed — and the next NEW one is
// the fifth. (CLAUDE_CI.md §2 already words it this way: "A FIFTH value needs
// a SQL ALTER on chk_ci_returns_status FIRST".)
// This is the same trap chk_pick_assignments_status documents, and it is why
// 'returned_to_floor' was allowed up front: an unused value costs nothing,
// ALTERing a live CHECK later does not.
//
// 🔴 THREE FKs TO `users` — supervisorId / billingOperatorId / voidedById. All
// three carry an explicitly NAMED @relation on BOTH sides (back-relations on the
// users model). An unnamed one is a Prisma ambiguity ERROR at generate time, not
// a warning — CORE §7.3.
model ci_returns {
  id       Int     @id @default(autoincrement())
  // ⚠ NULLABLE, AND THAT IS THE WHOLE POINT (spec §6, "ciNumber is NULLABLE").
  // A DRAFT CARRIES NO NUMBER: the write order is insert header → insert lines →
  // allocate the number and flip to 'submitted', so a failure part-way leaves a
  // numberless draft rather than a numbered CI with no lines on the floor's
  // screen. Every list, board, marker and search filters `status <> 'draft'`, so
  // a null-numbered row is never user-visible; if one is visible, the FILTER is
  // missing, not the number.
  // ⚠ Postgres treats NULLs as DISTINCT under a unique index, so any number of
  // concurrent drafts coexist. The live index has NO `NULLS NOT DISTINCT` — do
  // not add it, it would permit exactly one draft at a time depot-wide.
  ciNumber String? @unique
  status   String

  // ── the bill ──────────────────────────────────────────────────────────────
  // 🔴 orderId IS THE IDENTITY OF THE BILL, never invoiceNo (spec §4).
  orderId      Int
  order        orders                 @relation("CiReturnOrder", fields: [orderId], references: [id], onDelete: Restrict)
  // Snapshot, and also the TEXT join key to import_raw_line_items — there is NO
  // FK from `orders` to its line items; Picking and Floor both join on the
  // string, and CI does the same.
  obdNumber    String
  // ⚠ NULLABLE ON PURPOSE AND LOAD-BEARING (spec §4). 5.0% of bills dispatched
  // in the last 30 days carry no invoice number, and 429 `dispatched` rows going
  // back to 2026-05-15 never received one. The supervisor is NEVER BLOCKED.
  // 🔴 DO NOT BUILD A BACK-FILL JOB. The CI holds orderId, so any screen reads
  // the invoice number through the order at render time and it simply appears
  // once SAP sends it. This is the ONE place CI deliberately does not snapshot:
  // print and export must PREFER the live order value and fall back to this,
  // never the reverse. A patch job would fight that and could rewrite a closed
  // document.
  invoiceNo    String?
  invoiceDate  DateTime?              @db.Date
  soNumber     String?
  customerId   Int?
  customer     delivery_point_master? @relation("CiReturnCustomer", fields: [customerId], references: [id], onDelete: SetNull)
  customerCode String?
  customerName String?

  // ── stage 1 (floor supervisor, phone) ─────────────────────────────────────
  // `returnType` is answered on the FIRST screen (Full bill / Part), so it is
  // NOT NULL — a draft cannot exist without it.
  returnType           String
  // 🔴 THE NEXT FOUR ARE NULLABLE, AND THAT IS THE OWNER'S RULING (2026-09-01).
  // A DRAFT CARRIES NULL FOR THE STAGE-1 ANSWERS — no placeholders, ever.
  //
  // The details screen that collects them comes AFTER the line selection, so
  // between the draft insert and the details step these genuinely have no
  // value. The earlier shape forced the draft route to invent defaults
  // ("not_moved", today, reason 1) that were never true and had to be patched
  // before submit; inventing a fact to satisfy a NOT NULL is how a wrong fact
  // reaches a printed document when the patch is later forgotten.
  //
  // What makes this safe is chk_ci_returns_complete_when_not_draft (see the
  // block above this model): the moment `status` stops being 'draft' all four
  // must be present. Nullable in a draft, mandatory in a record.
  materialMoved        String?
  materialReceivedDate DateTime?         @db.Date
  reasonId             Int?
  reason               ci_reason_master? @relation("CiReturnReason", fields: [reasonId], references: [id], onDelete: Restrict)
  // Snapshot beside the FK, so renaming a reason never rewrites history.
  // Nullable for the same reason as `reasonId` above — they are written
  // together, at the details step, and the CHECK requires both on anything that
  // is not a draft.
  reasonLabel          String?
  reasonRemark         String?
  supervisorId         Int
  supervisor           users             @relation("CiReturnSupervisor", fields: [supervisorId], references: [id], onDelete: Restrict)
  submittedAt          DateTime?         @db.Timestamptz(6)

  // ── stage 2 (billing operator, desk) ──────────────────────────────────────
  ciDate            DateTime? @db.Date
  // 🔴 TWO SEPARATE NUMBERS, AND ONLY ONE OF THEM IS LABELLED (spec §5).
  // `ciNumber` above is OrbitOMS's own reference, allocated at submit.
  // `sapCiNumber` is SAP's, typed by billing after punching — and the billing
  // screen labels THAT field plain "CI number", which is exactly why the two
  // look mergeable. THEY ARE NOT. Merging leaves every pending CI with no way to
  // name it for the hours or days before SAP sees it.
  sapCiNumber       String?
  ciValue           Decimal?  @db.Decimal(12, 2)
  billingOperatorId Int?
  billingOperator   users?    @relation("CiReturnBillingOperator", fields: [billingOperatorId], references: [id], onDelete: SetNull)
  closedAt          DateTime? @db.Timestamptz(6)

  // ── void (never hard-delete a numbered document) ───────────────────────────
  // ═══════════════════════════════════════════════════════════════════════
  // 🔴 WHO RAISED THIS — A HUMAN, OR THE FINDINGS PATH (2026-09-01, step 15)
  // ═══════════════════════════════════════════════════════════════════════
  //
  //   'manual'       — the supervisor walked the /ci New flow himself.
  //   'auto_finding' — raised as a SIDE EFFECT of confirming a pick finding on
  //                    an already-invoiced bill (lib/ci/auto.ts).
  //   'auto_bill_only' — (2026-09-22) raised by the system for a bill-only
  //                    order: a full-bill, material-not-moved CI against a bill
  //                    billing tagged 'ci'. Owner: the Billing · Telephonic tab,
  //                    NOT BUILT YET — nothing writes this value today. Allowed
  //                    by chk_ci_returns_source since Schema v27.39.
  //   'floor'        — (2026-09-22) raised from the Floor desk for ticked
  //                    bills: full bill, material not moved, and the bill is
  //                    taken off the floor (app/api/floor/ci/route.ts).
  //                    Allowed by chk_ci_returns_source since Schema v27.40.
  //
  // ⚠ NOT COSMETIC. It is the only thing that tells billing a document was
  // assembled by the system rather than stated by a person, and it is the key
  // the reconcile in lib/ci/auto.ts finds its own CI by — orderId + source.
  // Without it a second confirm could not tell "the CI I raised" from "a CI the
  // supervisor raised by hand for the same bill", and would edit his.
  //
  // ⚠ DEFAULT 'manual' IS LOAD-BEARING: every write path that predates this
  // column — draft/route.ts and every screen — keeps working untouched and its
  // rows stay correctly labelled. Do not make it required.
  //
  // Column and CHECK both already live (verified 2026-09-01 against
  // information_schema: text, NOT NULL, DEFAULT 'manual'::text, and
  // chk_ci_returns_source). Mirrored here by hand — never db push (CORE §3).
  source String @default("manual")

  isVoided   Boolean   @default(false)
  voidReason String?
  voidRemark String?
  voidedAt   DateTime? @db.Timestamptz(6)
  voidedById Int?
  voidedBy   users?    @relation("CiReturnVoidedBy", fields: [voidedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  // ⚠ A REAL @updatedAt, NOT a plain @default(now()). The live column is
  // NOT NULL DEFAULT now(), which covers the INSERT only; @updatedAt is what
  // restamps it on every UPDATE. Getting this wrong is the shape that made
  // push_subscriptions.updatedAt a landmine (CORE §13) — and CI's live marker
  // keys on MAX(updatedAt), so a column that silently stops moving freezes the
  // board. Same as `mrn`.
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  lines ci_return_lines[]

  // Index names below match the LIVE ones exactly (verified against pg_indexes
  // 2026-09-01) — Prisma's defaults happen to be identical, so no `map:` is
  // needed on any of them. Do not rename a field without checking that again.
  @@index([orderId])
  @@index([status])
  @@index([materialReceivedDate])
  // 🔴 BOTH search keys, and this pair IS spec §4's ruling in schema form: the
  // supervisor searches by invoice number OR OBD number, because 5% of bills
  // never get an invoice number at all.
  @@index([invoiceNo])
  @@index([obdNumber])
}

// One returned line. 12 columns.
model ci_return_lines {
  id            Int        @id @default(autoincrement())
  ciReturnId    Int
  ciReturn      ci_returns @relation(fields: [ciReturnId], references: [id], onDelete: Cascade)
  lineNumber    Int
  // A plain nullable Int, NOT a foreign key — deliberate. Spec §6 calls it a
  // "pointer back to import_raw_line_items" and names ON DELETE only for
  // ciReturnId; the live table has no FK here either. (Contrast pick_findings,
  // which does carry a UNIQUE FK to that table.)
  rawLineItemId Int?

  // 🔴 The raw SAP material code. Resolved against `sku_master_v2.material` and
  // NOTHING ELSE — never a catalog row id. The old `sku_master` and
  // `sku_master_v2` assign COMPLETELY DIFFERENT ids to the same material code
  // (CORE §13, the id-space landmine), so following an id would print a
  // confidently WRONG product name on a signed goods-return document.
  skuCode        String
  skuDescription String?
  packCode       String?

  // ⚠ SNAPSHOT of import_raw_line_items.unitQty, which is SAP's DELIVERY
  // quantity. THERE IS NO INVOICED-QUANTITY COLUMN ANYWHERE IN THIS DATABASE —
  // do not label this "invoiced qty" on a screen or in a later doc. Snapshotted
  // because a re-import PATCHES the raw line in place, and a closed CI must not
  // silently change what it claims was delivered.
  deliveryQty       Int?
  // What came back, in TINS — the only number the supervisor types.
  returnedQty       Int
  // Litres are CALCULATED, never typed (spec §6):
  //   litresPerTin      = import_raw_line_items.volumeLine / unitQty  (snapshot)
  //   returnedQtyLitres = litresPerTin × returnedQty                  (at save)
  // 🔴 GUARD THE DIVISION: unitQty is nullable and could be 0, giving
  // null/Infinity, which prints as garbage. If it is null or 0, leave
  // litresPerTin NULL and render the litres cell blank.
  // (12,3) NOT (12,2) — pack sizes carry three decimals and a 0.925 L pack would
  // round away at two (spec §6).
  litresPerTin      Decimal? @db.Decimal(12, 3)
  returnedQtyLitres Decimal? @db.Decimal(12, 3)

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  // Live name ci_return_lines_ciReturnId_lineNumber_key — Prisma's default for
  // this pair is identical, so no `map:`. No separate index on ciReturnId: it is
  // the LEADING column here, which already serves every lookup by parent.
  @@unique([ciReturnId, lineNumber])
}

// ── Billing · Telephonic — SO tags (2026-09-22) ──────────────────────────────
//
// A telephonic order has no mail order, so nothing tells OrbitOMS it should be
// held or is a bill-only CI order. Billing types the SO number with a tag
// (normally right after punching it in SAP, before the OBD exists); when the
// OBD lands the import holds the bill and, for a CI tag, raises the CI.
//
// DDL: sql/2026-09-22-billing-telephonic.sql — ALREADY RUN against production
// 2026-09-22 and verified. Hand-mirrored from information_schema / pg_constraint
// / pg_indexes the same day. Never `db push`, never `db pull` (CORE §3).

// The waiting list — one row per SO number typed. 13 columns.
//
// 🔴 TWO LIVE CHECK CONSTRAINTS — NOT EXPRESSIBLE IN PRISMA (CORE §7.4):
//   chk_so_tags_tag    CHECK (tag = ANY (ARRAY['hold','ci']))
//   chk_so_tags_status CHECK (status = ANY (ARRAY['waiting','matched']))
//
// 🔴 "EXPIRED" IS DERIVED, NOT STORED. There is no 'expired' status and the
// CHECK refuses one. A tag is expired when
//   status = 'waiting' AND expiresAt < now()
// so no job has to flip rows at the 15-day mark, and the screen can never
// disagree with the clock. expiresAt (addedAt + 15 days) is set by the add
// route, not defaulted in the database.
//
// 🔴 A "LIVE" TAG IS status 'waiting' OR 'matched', isRemoved = false,
// expiresAt > now(). NOT 'waiting' only: the first OBD flips the tag to
// 'matched', and a second OBD on the same SO must still find it.
//
// 🔴 A PARTIAL UNIQUE INDEX — NOT EXPRESSIBLE IN PRISMA, recorded by hand:
//   so_tags_soNumber_live_key
//     UNIQUE ("soNumber") WHERE "isRemoved" = false
//   The duplicate backstop (the add route checks first and names the existing
//   tag). A removed tag frees its SO for remove + re-add. Do NOT model it as
//   @@unique([soNumber]) — Prisma would describe a full unique that does not
//   exist. Consequence: `findUnique({ where: { soNumber } })` is NOT available;
//   callers use findFirst / findMany with isRemoved: false. Same class as
//   trips_date_type_seq_live_key.
//
// No CI data lives on the tag. The tab reads a CI live through the matched
// order (ci_returns WHERE orderId AND source = 'auto_bill_only'), the rule
// CLAUDE_CI.md §5 applies to the invoice number. The one exception is
// so_tag_matches.ciSkipReason, below.
//
// TWO FKs TO `users` — both NAMED on both sides (CORE §7.3). Live names are
// Prisma's defaults (so_tags_pkey, so_tags_addedById_fkey,
// so_tags_removedById_fkey — checked against pg_constraint 2026-09-22), so no
// `map:` is needed.
model so_tags {
  id          Int       @id @default(autoincrement())
  soNumber    String
  // 'hold' | 'ci' — chk_so_tags_tag.
  tag         String
  // 'waiting' | 'matched' — chk_so_tags_status. Never 'expired' (see header).
  status      String    @default("waiting")
  // RESTRICT: who asked for the hold / CI is the record — same rule as
  // ci_returns.supervisorId. Users are deactivated, never deleted.
  addedById   Int
  addedBy     users     @relation("SoTagAddedBy", fields: [addedById], references: [id], onDelete: Restrict)
  addedAt     DateTime  @default(now()) @db.Timestamptz(6)
  matchedAt   DateTime? @db.Timestamptz(6)
  expiresAt   DateTime  @db.Timestamptz(6)
  isRemoved   Boolean   @default(false)
  removedAt   DateTime? @db.Timestamptz(6)
  // SET NULL: an optional actor stamp, like ci_returns.voidedById.
  removedById Int?
  removedBy   users?    @relation("SoTagRemovedBy", fields: [removedById], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  // No trigger on the live column (NOT NULL DEFAULT now()) — @updatedAt is what
  // advances it on every update.
  updatedAt   DateTime  @default(now()) @updatedAt @db.Timestamptz(6)
  // true = written because a mail order is marked CI (mo_orders.billOnlyAt),
  // not typed on the Telephonic tab (2026-09-24, Schema v27.41). A FLAG, not a
  // moOrderId: one live tag per SO can be shared by two marked mail orders;
  // owners are found by mo_orders WHERE soNumber AND billOnlyAt IS NOT NULL.
  // Live: boolean NOT NULL DEFAULT false.
  fromMailOrder Boolean @default(false)

  matches so_tag_matches[] @relation("SoTagMatchTag")

  // ⚠ NO @@unique ON soNumber — the live uniqueness is the PARTIAL index
  // so_tags_soNumber_live_key (see the header), which Prisma cannot express.
}

// One row per OBD a tag hit. 6 columns. What makes "Held · 2 bills" and
// "Couldn't raise" honest.
//
// 🔴 ciSkipReason IS THE ONE PLACE CI STATE IS STORED ON THE TELEPHONIC SIDE.
// Everything else about the CI is read live from ci_returns. When the auto-CI
// REFUSES (e.g. an active line with no delivered quantity) there is no
// ci_returns row to read, so the reason lives here. Null otherwise.
//
// Both FKs are ON DELETE RESTRICT: nothing in the app deletes these rows or
// their parents (tags and orders are soft-removed), so an accidental delete
// must FAIL rather than cascade away the record of what was held.
//
// Live names are Prisma's defaults — so_tag_matches_pkey,
// so_tag_matches_soTagId_fkey, so_tag_matches_orderId_fkey,
// so_tag_matches_soTagId_orderId_key, so_tag_matches_orderId_idx (checked
// against pg_constraint / pg_indexes 2026-09-22) — so no `map:` is needed.
model so_tag_matches {
  id           Int      @id @default(autoincrement())
  soTagId      Int
  soTag        so_tags  @relation("SoTagMatchTag", fields: [soTagId], references: [id], onDelete: Restrict)
  orderId      Int
  order        orders   @relation("SoTagMatchOrder", fields: [orderId], references: [id], onDelete: Restrict)
  // Snapshot, for display without a join.
  obdNumber    String
  appliedAt    DateTime @default(now()) @db.Timestamptz(6)
  // Null unless the tag could not be fully applied (auto-CI refused, or bill
  // already dispatched) — see the header.
  ciSkipReason String?

  // A re-import must never record the same match twice. soTagId leads, so this
  // also serves "every bill this tag hit".
  @@unique([soTagId, orderId])
  // The referencing side of the orderId FK — Postgres does not index it, and
  // without it a delete on orders scans this table to enforce the RESTRICT.
  @@index([orderId])
}

// ── CHALLAN ORDERS — SO links (2026-10-06, Schema v27.60) ────────────────────
//
// One row per SO number billing pastes against an ORB order (a challan order,
// orders.isChallanOrder). The SO is pasted BEFORE the SAP OBD exists (design
// D10), so it cannot live on `orders`. One ORB order → many SOs (part-billing,
// F5); one SO → one ORB order among rows that are not unlinked (F5).
// Design: docs/prompts/drafts/web-update-2026-10-06-challan-orders.md.
// DDL: sql/2026-10-06-challan-orders-ddl.sql — RUN LIVE 2026-10-06 by the owner
// and verified; the text below is the live read-back. Never db push / db pull.
//
// status:
//   'waiting'  — SO pasted, its OBD not imported yet
//   'linked'   — the import found an OBD for the SO. linkedOrderId is the FIRST
//                such OBD only; every SAP bill carries its own
//                orders.challanOrderId, which is the per-OBD truth.
//   'unlinked' — billing took a wrong SO off (M5), from 'waiting' only. The row
//                is KEPT as the audit trail; it is never hard-deleted.
//
// 🔴 FOUR LIVE CHECK CONSTRAINTS — NOT EXPRESSIBLE IN PRISMA, live text:
//   chk_challan_order_so_links_status:   CHECK ((status = ANY (ARRAY['waiting'::text, 'linked'::text, 'unlinked'::text])))
//   chk_challan_order_so_links_so_shape: CHECK (("soNumber" ~ '^[0-9]{10}$'::text))
//   chk_challan_order_so_links_shape:    CHECK ((((status = 'waiting'::text) AND ("linkedOrderId" IS NULL) AND ("obdLinkedAt" IS NULL) AND ("unlinkedAt" IS NULL) AND ("unlinkedById" IS NULL)) OR ((status = 'linked'::text) AND ("linkedOrderId" IS NOT NULL) AND ("obdLinkedAt" IS NOT NULL) AND ("unlinkedAt" IS NULL) AND ("unlinkedById" IS NULL)) OR ((status = 'unlinked'::text) AND ("linkedOrderId" IS NULL) AND ("obdLinkedAt" IS NULL) AND ("unlinkedAt" IS NOT NULL))))
//   chk_challan_order_so_links_not_self: CHECK ((("linkedOrderId" IS NULL) OR ("linkedOrderId" <> "orbOrderId")))
// A new status value = ALTER the CHECK first, then the vocabulary in code
// (CORE §3's status-string rule).
//
// 🔴 A PARTIAL UNIQUE INDEX — NOT EXPRESSIBLE IN PRISMA, live text:
//   CREATE UNIQUE INDEX "challan_order_so_links_soNumber_live_key" ON
//     public.challan_order_so_links USING btree ("soNumber") WHERE (status <> 'unlinked'::text)
//   F5 and the import's lookup index. Do NOT model it as @@unique([soNumber]) —
//   an unlinked row frees its SO for a fresh paste. Consequence: no findUnique by
//   soNumber; use findFirst with status: { not: 'unlinked' }. Same class as
//   so_tags_soNumber_live_key.
//
// FOUR relations, all NAMED on both sides: two FKs to `orders` (orbOrderId,
// linkedOrderId) and two to `users` (linkedById, unlinkedById) — CORE §7.3.
// onDelete is spelled out to match live: orders RESTRICT ×2, linkedBy RESTRICT,
// unlinkedBy SET NULL. Every constraint and index name is Prisma's default, so
// no `map:` anywhere.
//
// Live-feed triggers trg_live_changes_challan_order_so_links_{ins,upd,del}
// (AFTER, FOR EACH STATEMENT, live_changes_child_*('order','parent','orbOrderId'))
// — the so_tag_matches pattern: a paste / link / unlink writes no orders row.
model challan_order_so_links {
  id            Int       @id @default(autoincrement())
  orbOrderId    Int
  orbOrder      orders    @relation("ChallanSoLinkOrbOrder", fields: [orbOrderId], references: [id], onDelete: Restrict)
  // 10 digits — chk_challan_order_so_links_so_shape (normaliseSoNumber's rule).
  soNumber      String
  // 'waiting' | 'linked' | 'unlinked' — chk_challan_order_so_links_status.
  status        String    @default("waiting")
  linkedOrderId Int?
  linkedOrder   orders?   @relation("ChallanSoLinkLinkedOrder", fields: [linkedOrderId], references: [id], onDelete: Restrict)
  obdLinkedAt   DateTime? @db.Timestamptz(6)
  // RESTRICT: who pasted the SO is the record of who linked it.
  linkedById    Int
  linkedBy      users     @relation("ChallanSoLinkLinkedBy", fields: [linkedById], references: [id], onDelete: Restrict)
  linkedAt      DateTime  @default(now()) @db.Timestamptz(6)
  // SET NULL: an optional actor stamp; status + unlinkedAt still say what happened.
  unlinkedById  Int?
  unlinkedBy    users?    @relation("ChallanSoLinkUnlinkedBy", fields: [unlinkedById], references: [id], onDelete: SetNull)
  unlinkedAt    DateTime? @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @db.Timestamptz(6)
  // No trigger on the live column (NOT NULL DEFAULT now()) — @updatedAt advances it.
  updatedAt     DateTime  @default(now()) @updatedAt @db.Timestamptz(6)

  // Prisma's default names = the live ones, so no `map:`.
  @@index([orbOrderId])
  @@index([linkedOrderId])
}

// ─────────────────────────────────────────────
// BILLING · PICK DELETE — same-SO decisions (2026-09-27, Schema v27.42)
// ─────────────────────────────────────────────
// One row per billing decision on a same-SO group: 'all_ok' (keep every bill)
// or 'pick_delete' (one bill cancelled as a duplicate). Undo stamps undoneAt /
// undoneById; a row is never deleted. The duplicate-SO RULE stays Picking's
// (lib/picking/duplicate-so.ts reads the active all_ok rows); only Billing
// writes this table. Created by hand in the Supabase SQL Editor
// (docs/prompts/drafts/2026-09-27-pick-delete-table.sql, run live 2026-09-27).
//
// ⚠ orderIds / keptOrderIds are written SORTED ASCENDING — the first partial
//   unique index below depends on it.
//
// 🔴 NOT EXPRESSIBLE IN PRISMA — live only, quoted from pg_constraint /
//   pg_indexes 2026-09-27. No @@unique for either partial index, so there is no
//   findUnique on them; a double press surfaces as P2002.
//   pick_delete_decisions_all_ok_live_key UNIQUE ("soNumber","orderIds")
//     WHERE kind='all_ok' AND "undoneAt" IS NULL
//   pick_delete_decisions_deleted_live_key UNIQUE ("deletedOrderId")
//     WHERE kind='pick_delete' AND "undoneAt" IS NULL
//   chk_pick_delete_decisions_kind: CHECK ((kind = ANY (ARRAY['all_ok'::text, 'pick_delete'::text])))
//   chk_pick_delete_decisions_member: CHECK ((("deletedOrderId" IS NULL) OR ("deletedOrderId" = ANY ("orderIds"))))
//   chk_pick_delete_decisions_set: CHECK ((cardinality("orderIds") >= 2))
//   chk_pick_delete_decisions_shape: CHECK ((((kind = 'all_ok'::text) AND ("deletedOrderId" IS NULL) AND ("deletedFromStage" IS NULL) AND ("deletedPickerId" IS NULL)) OR ((kind = 'pick_delete'::text) AND ("deletedOrderId" IS NOT NULL) AND ("deletedFromStage" IS NOT NULL))))
//   chk_pick_delete_decisions_undo: CHECK ((("undoneById" IS NULL) OR ("undoneAt" IS NOT NULL)))
//   A new `kind` value needs a SQL ALTER on the CHECK FIRST (CORE §3).
// Every FK name is Prisma's default, so no `map:` on the relations.
model pick_delete_decisions {
  id               Int       @id @default(autoincrement())
  soNumber         String
  // 'all_ok' | 'pick_delete' — chk_pick_delete_decisions_kind.
  kind             String
  // The exact set decided on, sorted ascending, ≥ 2 ids.
  orderIds         Int[]
  // pick_delete only. RESTRICT: the decision is the record of why it died.
  deletedOrderId   Int?
  deletedOrder     orders?   @relation("PickDeleteDeletedOrder", fields: [deletedOrderId], references: [id], onDelete: Restrict)
  // pick_delete only — the stage at delete time; Undo returns a
  // pending_tint_assignment bill to the tint queue, every other to pending_picking.
  deletedFromStage String?
  // Who held the pick assignment when it was deleted (the assignment row itself
  // is gone) — scopes the picker's "pick deleted today" card.
  deletedPickerId  Int?
  deletedPicker    users?    @relation("PickDeleteDeletedPicker", fields: [deletedPickerId], references: [id], onDelete: SetNull)
  keptOrderIds     Int[]     @default([])
  decidedById      Int
  decidedBy        users     @relation("PickDeleteDecidedBy", fields: [decidedById], references: [id], onDelete: Restrict)
  decidedAt        DateTime  @default(now()) @db.Timestamptz(6)
  undoneAt         DateTime? @db.Timestamptz(6)
  // SET NULL, so chk_pick_delete_decisions_undo is one-directional on purpose.
  undoneById       Int?
  undoneBy         users?    @relation("PickDeleteUndoneBy", fields: [undoneById], references: [id], onDelete: SetNull)
  createdAt        DateTime  @default(now()) @db.Timestamptz(6)
  // No trigger on the live column (NOT NULL DEFAULT now()) — @updatedAt is what
  // advances it. The Picking/Floor markers read MAX(updatedAt) as a clock.
  updatedAt        DateTime  @default(now()) @updatedAt @db.Timestamptz(6)

  @@index([soNumber], map: "pick_delete_decisions_so_idx")
  @@index([decidedAt(sort: Desc)], map: "pick_delete_decisions_decided_idx")
  @@index([deletedPickerId, decidedAt], map: "pick_delete_decisions_picker_idx")
  @@index([deletedOrderId], map: "pick_delete_decisions_deleted_order_idx")
}

// ─────────────────────────────────────────────
// TRIP MODULE — trips + trip_drops (2026-09-09)
// ─────────────────────────────────────────────

// One LOAD leaving the depot. 24 columns.
//
// Applied BY HAND in the Supabase SQL Editor 2026-09-09 and hand-mirrored here —
// db push and db pull are both banned (CORE §3), and db pull additionally fails
// on this machine with P1001. DDL of record:
// docs/prompts/drafts/web-update-2026-09-09-trip-schema.md §D.
//
// 🔴 SEVEN LIVE CHECK CONSTRAINTS — NOT EXPRESSIBLE IN PRISMA (CORE §7.4), so
// they are invisible in this file and are recorded here by hand:
//   chk_trips_status     CHECK (status IN ('draft','released','dispatched','cancelled'))
//     ⚠ 'loading' was REMOVED from this CHECK on 2026-09-14. Nothing had ever
//       written it and production held zero rows at it. It comes back only
//       alongside the loading screen, by ALTER, never by code assuming it.
//   chk_trips_type_code  CHECK ("typeCode" IN ('L','U','I','C'))
//     ⚠ This line read ('L','U','I') until 2026-09-15. The LIVE constraint has
//       admitted 'C' all along (pg_constraint, verified) and production holds a
//       Cross trip, C-260911-01.
//   chk_trips_seq_positive        CHECK (seq >= 1)
//   chk_trips_vehicle_one_of
//     CHECK (NOT ("vehicleId" IS NOT NULL AND "adhocVehicleNo" IS NOT NULL))
//   chk_trips_dispatched_complete
//     CHECK (status <> 'dispatched'
//            OR ("dispatchedAt" IS NOT NULL AND "dispatchedById" IS NOT NULL))
//   chk_trips_cancelled_complete
//     CHECK (status <> 'cancelled'
//            OR ("cancelledAt" IS NOT NULL AND "cancelledById" IS NOT NULL))
//   chk_trips_number_shape   (rewritten slice 5, 2026-09-15)
//     base = "typeCode" || '-' || to_char("tripDate",'YYMMDD') || '-'
//            || lpad(seq::text, greatest(2, length(seq::text)), '0')
//     CHECK (CASE WHEN status = 'cancelled'
//              THEN "tripNumber" ~ ('^' || base || '-C([2-9]|[1-9][0-9]+)?$')
//              ELSE "tripNumber" = base END)
//     A live trip carries its number exactly; a cancelled trip carries it with
//     -C, -C2, -C3 … (lib/trips/number.ts cancelledTripNumber). The original
//     read `lpad(seq::text, 2, '0')`, and Postgres lpad TRUNCATES — seq 100
//     rendered '10' and the 100th trip of a day would have been refused.
//
// 🔴 A PARTIAL UNIQUE INDEX — NOT EXPRESSIBLE IN PRISMA, recorded by hand:
//   trips_date_type_seq_live_key
//     UNIQUE ("tripDate","typeCode",seq) WHERE status <> 'cancelled'
//   It REPLACED the full UNIQUE trips_date_type_seq_key on 2026-09-15, so a
//   cancelled trip no longer holds its seq and the next trip can reuse it. Do
//   NOT model it as @@unique — Prisma would describe a full unique that does not
//   exist. Same class as orders_billing_pending_idx (CORE §7).
//
// 🔴 A SIXTH STATUS VALUE NEEDS A SQL ALTER ON chk_trips_status FIRST — never
// just a new string in application code. Same trap chk_pick_assignments_status
// and chk_ci_returns_status document: `status` is a plain String here, Prisma
// validates nothing, and a wrong literal reaches Postgres as a raw constraint
// violation on somebody's screen. Import the vocabulary, never retype it
// (CORE §3's status-string rule).
//
// ⚠ 'ready' IS DELIBERATELY NOT IN THAT LIST. A trip is ready when every bill
// under it is at pick_checked, and that is DERIVED AT READ TIME, never stored —
// a stored 'ready' would drift the moment a bill is added or unassigned and
// nothing would correct it. Owner decision, 2026-09-09.
//
// ⚠ chk_trips_number_shape IS WHAT KEEPS THE TWO UNIQUES HONEST. `tripNumber`
// is UNIQUE over every row and (tripDate, typeCode, seq) is UNIQUE over the
// trips that are not cancelled — not redundant, because they fail differently:
// the text catches the allocator's P2002 race, the triple catches a duplicate
// seq that a mis-formatted number would let through. The CHECK is what stops
// those two ever disagreeing about the same row, and it is why cancelling
// RENAMES the trip: the text unique still covers a cancelled row.
// ⚠ Postgres lpad TRUNCATES to its width ('100' padded to 2 is '10'), which is
// why the CHECK pads to greatest(2, length). Do not reimplement the formatter
// as a two-character slice, and do not narrow the CHECK back to a bare 2.
//
// 🔴 EIGHT FKs TO `users` — createdById / releasedById / dispatchedById /
// cancelledById / shownById (slice 8) / sentToBillingById / billingCopiedById
// (both slice 9, 2026-09-15) / billingDoneById (Print v2, 2026-10-05, v27.56 —
// live name trips_billingdonebyid_fkey, lowercase: created unquoted). All eight
// carry an explicitly NAMED @relation on BOTH sides (back-relations tripsCreated
// / tripsReleased / tripsDispatched / tripsCancelled / tripsShown /
// tripsSentToBilling / tripsBillingCopied / tripsBillingDone on the users model). An unnamed one is a Prisma ambiguity
// ERROR at generate time, not a warning — CORE §7.3. Same discipline as the
// Mrn* / PickFinding* / CiReturn* clusters.
//
// ⚠ driverName / driverPhone are SNAPSHOTS taken when the trip is built, NOT
// reads through `vehicleId`. The master's driver changes when a transporter
// swaps a man onto a van; a sheet printed last week must keep saying who
// actually drove it. It is also what lets a trip with only an `adhocVehicleNo`
// still name a driver.
//
// ⚠ `typeCode` is denormalised beside `deliveryTypeId` ON PURPOSE. The trip
// number embeds a letter and that letter must survive a rename in
// delivery_type_master. The FK carries the classification; typeCode carries the
// number's own component, and chk_trips_number_shape ties them together.
//
// ⚠ `Cross` IS 'C'. delivery_type_master holds Local / Upcountry / IGT / Cross
// and chk_trips_type_code admits all four letters. (This note said Cross had no
// letter and the CHECK refused it; the live constraint never did — corrected
// 2026-09-15.)
//
// ⚠ `transporterId` is the TRIP'S OWN, nullable, defaulted from the vehicle
// when one is chosen but overridable. Do not derive it from `vehicleId` at read
// time (owner decision). Vehicle and transporter are BOTH optional: a trip must
// be creatable with neither.
//
// ⚠ `transporterTripNo` is the CARRIER'S own docket — NTS calls it L41/L42, a
// hired transporter gives a docket number. Free text, not validated, NOT
// unique: it is their reference, not ours. During the NTS parallel run it holds
// the matching NTS trip number. It is not comparable to `tripNumber`: NTS's own
// counter runs monthly, not per day (measured 2026-09-08/09).
model trips {
  id                Int                   @id @default(autoincrement())
  tripNumber        String                @unique
  tripDate          DateTime              @db.Date
  typeCode          String
  deliveryTypeId    Int
  deliveryType      delivery_type_master  @relation(fields: [deliveryTypeId], references: [id])
  seq               Int
  dispatchWindowId  Int?
  dispatchWindow    dispatch_slot_master? @relation("TripDispatchWindow", fields: [dispatchWindowId], references: [id])
  transporterId     Int?
  transporter       transporter_master?   @relation(fields: [transporterId], references: [id])
  vehicleId         Int?
  vehicle           vehicle_master?       @relation(fields: [vehicleId], references: [id])
  adhocVehicleNo    String?
  driverName        String?
  driverPhone       String?
  transporterTripNo String?
  /// gc | ace | big, or null (chk_trips_vehicle_size, sql/2026-09-21-trips-vehicle-size.sql).
  /// Required on the Upcountry trip form; read by the admin Load plan check.
  vehicleSize       String?
  /// Hand trip — the dealer collects, no vehicle (2026-09-24, Schema v27.41).
  /// Live: boolean NOT NULL DEFAULT false. Set on create, never changed; a Hand
  /// trip refuses a vehicle/plate and so stays `draft` for life (harmless).
  isHand            Boolean               @default(false)
  /// Diesel given for the trip, rupees (Schema v27.54, 2026-10-04). Live
  /// numeric(10,2) + chk_trips_diesel_amount_nonneg (NULL or >= 0). Optional.
  dieselAmount      Decimal?              @db.Decimal(10, 2)
  /// The dispatch time the planner types, FOR REPORTS ONLY (Schema v27.54).
  /// Required in the Edit drawer, nullable in the DB. NEVER feeds dispatchedAt,
  /// never moves status, never closes a trip.
  manualDispatchAt  DateTime?             @db.Timestamptz(6)
  note              String?
  status            String                @default("draft")
  releasedAt        DateTime?             @db.Timestamptz(6)
  releasedById      Int?
  releasedBy        users?                @relation("TripReleasedBy", fields: [releasedById], references: [id], onDelete: SetNull)
  dispatchedAt      DateTime?             @db.Timestamptz(6)
  dispatchedById    Int?
  dispatchedBy      users?                @relation("TripDispatchedBy", fields: [dispatchedById], references: [id], onDelete: SetNull)
  cancelledAt       DateTime?             @db.Timestamptz(6)
  cancelledById     Int?
  cancelledBy       users?                @relation("TripCancelledBy", fields: [cancelledById], references: [id], onDelete: SetNull)
  // SHOWN TO THE FLOOR (slice 8, 2026-09-15). With desk control on, a WAITING
  // bill on a trip reaches the supervisor's Assign tab only once its trip is
  // shown; a bill on no trip is always visible. Null = not shown. Written by
  // POST /api/floor/trips/[id]/show and by turning desk control on (the
  // no-cliff rule, lib/trips/show.ts). The FIFTH FK to `users`, so it carries a
  // named relation on both sides like its four siblings.
  shownAt           DateTime?             @db.Timestamptz(6)
  shownById         Int?
  shownBy           users?                @relation("TripShownBy", fields: [shownById], references: [id], onDelete: SetNull)
  // SENT TO BILLING (slice 9, 2026-09-15). The planner's Send to billing puts the
  // trip on the Billing screen's Print tab. Null = not sent. Written by
  // POST /api/floor/trips/[id]/billing (lib/trips/billing.ts). The SIXTH FK to
  // `users`, named on both sides like its siblings.
  sentToBillingAt   DateTime?             @db.Timestamptz(6)
  sentToBillingById Int?
  sentToBillingBy   users?                @relation("TripSentToBillingBy", fields: [sentToBillingById], references: [id], onDelete: SetNull)
  // THE LATEST COPY on the Print tab (slice 9). Copy stamps it; a copy of the
  // numbers that arrived since moves it again. The NUMBERS copied live in each
  // `invoices_copied` activity row's detail, never here — a trip can be copied
  // more than once (lib/billing/print.ts). The SEVENTH FK to `users`.
  billingCopiedAt   DateTime?             @db.Timestamptz(6)
  billingCopiedById Int?
  billingCopiedBy   users?                @relation("TripBillingCopiedBy", fields: [billingCopiedById], references: [id], onDelete: SetNull)
  // BILLING DONE (Print v2, 2026-10-05, Schema v27.56). Billing's manual "Done —
  // all copied" on the Print tab moves the trip to "Done today". Null = not done.
  // From v2 `billingCopiedAt` above means only "the latest copy press"; which
  // BILLS were copied lives in trip_bill_copies, one row per (trip, bill). The
  // EIGHTH FK to `users`, named on both sides. ⚠ The live FK was created
  // UNQUOTED, so its stored name is lowercase — hence the explicit `map:`.
  billingDoneAt     DateTime?             @db.Timestamptz(6)
  billingDoneById   Int?
  billingDoneBy     users?                @relation("TripBillingDoneBy", fields: [billingDoneById], references: [id], onDelete: SetNull, map: "trips_billingdonebyid_fkey")
  createdAt        DateTime              @default(now()) @db.Timestamptz(6)
  createdById       Int
  createdBy         users                 @relation("TripCreatedBy", fields: [createdById], references: [id])
  updatedAt         DateTime              @default(now()) @updatedAt @db.Timestamptz(6)

  drops    trip_drops[]
  activity trip_activity[]
  // Re-deliveries (v27.53): TWO relations to trip_redeliveries, so both are NAMED.
  redeliveries          trip_redeliveries[] @relation("TripRedeliveryTrip")
  redeliveriesPrevious  trip_redeliveries[] @relation("TripRedeliveryPrevTrip")
  // Billing Print v2 (v27.56): the bills billing has copied on THIS trip.
  billCopies            trip_bill_copies[]  @relation("TripBillCopyTrip")

  // ⚠ NO @@unique ON (tripDate, typeCode, seq) SINCE 2026-09-15. The live
  // uniqueness is the PARTIAL index trips_date_type_seq_live_key (see the header
  // above), which Prisma cannot express. It replaced the full
  // trips_date_type_seq_key.
  // Three hand-made index names, none of which is what Prisma would generate,
  // so every one carries an explicit `map:` — same rule admin_audit_log follows
  // (CORE §7.13).
  @@index([tripDate(sort: Desc)], map: "trips_date_idx")
  @@index([status], map: "trips_status_idx")
  @@index([vehicleId], map: "trips_vehicle_idx")
}

// One STOP on a trip. 11 columns.
//
// A drop is a CUSTOMER, not a bill — two bills for one shop are one stop. That
// matches what the existing trip sheet already counts (CLAUDE_TRIP_REPORT.md
// §4: "Drops = unique customers, not bill rows — counted by custCode").
//
// Applied by hand 2026-09-09 and hand-mirrored here (CORE §3). DDL of record:
// the trip-schema draft §D2.
//
// 🔴 TWO LIVE CHECK CONSTRAINTS — NOT EXPRESSIBLE IN PRISMA, recorded by hand:
//   chk_trip_drops_seq_positive  CHECK ("dropSeq" >= 1)
//   chk_trip_drops_key
//     CHECK ("dropKey" = CASE WHEN "customerId" IS NOT NULL
//                             THEN 'c:' || "customerId"::text
//                             ELSE 's:' || "shipToCode" END)
//
// 🔴 `dropKey` IS THE GROUPING IDENTITY AND THE SECOND CHECK IS WHAT MAKES IT
// TRUSTWORTHY. The grouping rule is COALESCE(shipToOverrideCustomerId,
// customerId) — the expression six places in lib/floor and lib/picking already
// write. But 482 live bills carry NO customerId at all and 259 carry
// shipToOverride = true with a NULL override id (measured 2026-09-09). A key
// that is the FK alone therefore collapses unrelated shops onto one stop, and
// NULLS NOT DISTINCT inverts that into the opposite bug. The prefixed text key
// is total, survives an unmatched bill, and is inspectable with a plain SELECT
// instead of hiding the rule in a constraint modifier nothing reads.
//
// ⚠ THE 'c:' / 's:' PREFIXES ARE LOAD-BEARING. customerId 1856 and a SAP
// shipToCode of '1856' are different things in different id spaces; the
// prefixes are what stop them colliding. Same class of mistake CORE §13's
// id-space landmine records — never compare ids across spaces.
//
// ⚠ dropKey is WRITTEN BY THE APPLICATION, not generated by Postgres. The CHECK
// proves it cannot drift from the two columns it is built from; it does not
// fill it in. Every insert must compute it.
//
// ⚠ A free-text ship-to redirect (shipToOverride true, override id NULL) groups
// under its ORIGINAL customer, which is wrong for a delivery and is the only
// answer the data supports. The fix is upstream, in how those redirects are
// captured — do not invent an address here.
//
// ⚠ ON DELETE: tripId CASCADEs, so deleting a trip deletes its drops, and
// orders.tripDropId is ON DELETE SET NULL, so those bills return to the pool
// rather than being deleted. That chain is a safety net, NOT a workflow — a
// trip is CANCELLED by status, never deleted.
//
// Built to receive delivery / POD rows from the future driver app
// (web-update-2026-09-09-floor-trip-module.md §3.1). The ordered-drop shape
// exists from day one so that app attaches to rows that are already here.
model trip_drops {
  id           Int                    @id @default(autoincrement())
  tripId       Int
  trip         trips                  @relation(fields: [tripId], references: [id], onDelete: Cascade)
  dropSeq      Int
  customerId   Int?
  customer     delivery_point_master? @relation(fields: [customerId], references: [id])
  shipToCode   String
  dropKey      String
  customerName String
  areaName     String?
  routeName    String?
  note         String?
  createdAt    DateTime               @default(now()) @db.Timestamptz(6)

  orders       orders[]
  // Re-deliveries on this stop (v27.53). ON DELETE RESTRICT on their side: a
  // stop holding a re-delivery cannot be deleted.
  redeliveries trip_redeliveries[] @relation("TripRedeliveryDrop")

  // Live names trip_drops_trip_key_key and trip_drops_trip_seq_key. Prisma's
  // defaults would be trip_drops_tripId_dropKey_key and
  // trip_drops_tripId_dropSeq_key, so both `map:`s are REQUIRED.
  //
  // TWO uniques, answering different questions: the first is the stop's
  // IDENTITY (one customer, one stop per trip), the second is its ORDER (no two
  // stops share a position). Neither implies the other.
  @@unique([tripId, dropKey], map: "trip_drops_trip_key_key")
  @@unique([tripId, dropSeq], map: "trip_drops_trip_seq_key")
  // Hand-made names again, so both carry an explicit `map:`. tripId is already
  // the leading column of both uniques above; the standalone index is what the
  // live DDL created and is mirrored rather than second-guessed.
  @@index([tripId], map: "trip_drops_trip_idx")
  @@index([customerId], map: "trip_drops_customer_idx")
}

// ─────────────────────────────────────────────────────────────────────────────
// TRIP ACTIVITY (2026-09-14, slice 2)
//
// 🔴 WHAT A TRIP REMEMBERED BEFORE THIS TABLE: four moments. created / released
// / dispatched / cancelled, each a pair of columns on `trips`, each written
// once. Nothing recorded who swapped the van, when a bill joined the load, how
// often the slot moved, or who edited the note — the only trace an edit left was
// `updatedAt`, which says something changed without saying what, and is
// overwritten by the next edit. Worse on cancel: the bills are detached
// (tripDropId = null) and there is then NO record of which bills were ever on
// the trip. 49 cancelled trips are in exactly that state.
//
// This table is the story between the four moments. The stamps on `trips` STAY
// — nothing was backfilled and nothing was migrated off them.
//
// ⚠ ONE ROW PER PRESS, NEVER PER BILL. Attaching 40 bills writes ONE row
// carrying 40 ids. A row per bill would bury the events somebody reads back,
// which is the same reasoning app/api/floor/trips/[id]/bills/route.ts already
// gives for writing no `order_status_logs` rows on that path.
//
// ⚠ TWO TEXT COLUMNS ON PURPOSE, exactly as admin_audit_log carries. `summary`
// is the rendered line, written once at the source so no screen re-derives the
// wording; `detail` is the machine facts, so the cancel record's OBD list stays
// QUERYABLE rather than trapped inside a sentence.
//
// 🔴 onDelete: Restrict, AND THAT IS THE POINT. Trips are never hard-deleted —
// cancelling is a status, not a delete — so Restrict costs nothing today and
// turns that convention into a guarantee the database enforces. Cascade would
// have made a trip's whole history vanish with one DELETE, silently, which is
// the one thing an audit table must never do. trip_drops uses Cascade because
// a drop is part of the trip; this is a record ABOUT the trip and outlives it.
//
// ⚠ THE VOCABULARY IS OWNED BY lib/trips/activity.ts AND FENCED BY
// chk_trip_activity_action. Never retype an action literal in a route (CORE §3's
// status-string rule) — a typo'd action passes every type check and is refused
// by the database, which is the failure you want, but the constant is why it
// never gets that far.
//   chk_trip_activity_action CHECK (action IN ('created','bills_added',
//     'bills_removed','vehicle_changed','details_changed','cancelled',
//     'released','dispatched','renamed','shown','taken_back',
//     'sent_to_billing','taken_back_from_billing','invoices_copied',
//     'redelivery_added','redelivery_removed'))   — 16 values, live 2026-10-03
//   'renamed' added 2026-09-15 (slice 5) for the one-off migration that renamed
//   already-cancelled trips to <number>-C. 'shown' and 'taken_back' added
//   2026-09-15 (slice 8) for Show to floor and its take-back. 'sent_to_billing',
//   'taken_back_from_billing' and 'invoices_copied' added 2026-09-15 (slice 9,
//   sql/2026-09-15-slice9-print-tab.sql). 'redelivery_added' and
//   'redelivery_removed' added 2026-10-03 (Schema v27.53,
//   sql/2026-10-03-trip-redelivery.sql).
//
// ⚠ BOTH 'dispatched' AND 'released' ARE STILL WRITTEN. Slice 4 was dropped and
// Mark dispatched stays. Since slice 6 (2026-09-15) 'released' comes from
// POST …/confirm (no floor caller) and the slice 6 migration; a vehicle set in
// the create / PATCH routes records the move as `confirmed: true` in its own
// row's detail. Every ACTION stays in the vocabulary so historic rows keep
// rendering — a log that stops explaining its own old rows is worse than one
// that carries retired verbs.
// ─────────────────────────────────────────────────────────────────────────────
model trip_activity {
  id        Int      @id @default(autoincrement())
  tripId    Int
  trip      trips    @relation(fields: [tripId], references: [id], onDelete: Restrict)
  /// One of lib/trips/activity.ts's TRIP_ACTIONS. Fenced by chk_trip_activity_action.
  action    String
  actorId   Int
  actor     users    @relation("TripActivityActor", fields: [actorId], references: [id])
  /// The rendered line, written at the source. Never re-derived by a screen.
  summary   String
  /// The machine facts. Shape depends on `action` — see lib/trips/activity.ts.
  detail    Json?
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  // Hand-made index names, so both carry an explicit `map:` — the same rule
  // trips and trip_drops above follow (CORE §7.13).
  //
  // The first is THE read: the panel asks for one trip's rows oldest-first, and
  // a composite on (tripId, createdAt) answers it from the index alone. The
  // second is for a future cross-trip audit view; it has no caller today.
  @@index([tripId, createdAt], map: "trip_activity_trip_idx")
  @@index([createdAt(sort: Desc)], map: "trip_activity_created_idx")
}

// ─────────────────────────────────────────────────────────────────────────────
// TRIP RE-DELIVERIES (2026-10-03, Schema v27.53, sql/2026-10-03-trip-redelivery.sql)
//
// A bill that already went out on a truck and came back undelivered, put on a
// LATER trip as attempt 2, 3 … One row per (trip, bill). Plan of record:
// docs/prompts/drafts/web-update-2026-10-03-trip-redelivery.md (rev 5, §3).
// Applied by hand in the Supabase SQL Editor 2026-10-03 11:25 IST and
// hand-mirrored here (CORE §3).
//
// 🔴 NEVER WRITES `orders`. The bill keeps its own tripDropId (its FIRST trip),
// its stage and its hold — no trip action changes a bill's status or hold
// (CLAUDE_FLOOR_TRIPS.md §13). Every reader that reaches bills through
// orders.tripDropId (counts, isReady, the Print tab, picking) is blind to this
// table by construction.
//
// ⚠ ROWS ARE DELETED ON REMOVE. No status column in v1 (outcomes arrive with
// the driver app), which is why the unique below is a full unique, not partial.
//
// 🔴 TWO LIVE CHECK CONSTRAINTS — NOT EXPRESSIBLE IN PRISMA, live text:
//   chk_trip_redeliveries_attempt: CHECK (("attemptNo" >= 2))
//   chk_trip_redeliveries_reason:  CHECK ((reason = ANY (ARRAY['site_closed'::text, 'wrong_dispatch'::text])))
// A new reason = ALTER the CHECK first, then the vocabulary constant in code.
//
// 🔴 ON DELETE RESTRICT on trip, stop and order. Trips and orders are never
// hard-deleted; the stop is the one that matters: app/api/floor/trips/[id]/
// bills/route.ts deletes a stop when it holds no orders, and a stop deleted
// under a re-delivery must FAIL LOUDLY rather than cascade the row away or
// leave it pointing nowhere. prevTrip and createdBy keep the default rule, like
// trips.createdById.
//
// ⚠ LANDMINE: tripId and tripDropId are written from the same trip_drops row;
// nothing ties them. Two pointers that can disagree with nothing in the
// database to catch it — the shipToOverride / shipToOverrideCustomerId shape
// (CORE §7.3). Always write both from one drop read.
//
// Live-feed triggers trg_live_changes_trip_redeliveries_{ins,upd,del} (AFTER,
// FOR EACH STATEMENT, live_changes_child_*('trip','parent','tripId')) — the
// trip_drops pattern. TWO FKs to `trips`, so both relations are NAMED.
// ─────────────────────────────────────────────────────────────────────────────
model trip_redeliveries {
  id              Int        @id @default(autoincrement())
  tripId          Int
  trip            trips      @relation("TripRedeliveryTrip", fields: [tripId], references: [id], onDelete: Restrict)
  tripDropId      Int
  tripDrop        trip_drops @relation("TripRedeliveryDrop", fields: [tripDropId], references: [id], onDelete: Restrict)
  orderId         Int
  order           orders     @relation("TripRedeliveryOrder", fields: [orderId], references: [id], onDelete: Restrict)
  /// Snapshot at add time.
  obdNumber       String
  /// Snapshot at add time; screens read the live orders.invoiceNo.
  invoiceNo       String?
  /// >= 2 (chk_trip_redeliveries_attempt).
  attemptNo       Int
  /// The Orbit trip of the previous attempt; null if none.
  prevTripId      Int?
  prevTrip        trips?     @relation("TripRedeliveryPrevTrip", fields: [prevTripId], references: [id])
  /// site_closed | wrong_dispatch (chk_trip_redeliveries_reason).
  reason          String
  note            String?
  /// The same-day "Truck came back" tick was given.
  confirmedReturn Boolean    @default(false)
  createdAt       DateTime   @default(now()) @db.Timestamptz(6)
  createdById     Int
  createdBy       users      @relation("TripRedeliveryCreatedBy", fields: [createdById], references: [id])
  updatedAt       DateTime   @default(now()) @updatedAt @db.Timestamptz(6)

  // Hand-made names, so every one carries an explicit `map:`.
  @@unique([tripId, orderId], map: "trip_redeliveries_trip_order_key")
  @@index([tripDropId], map: "trip_redeliveries_drop_idx")
  @@index([orderId], map: "trip_redeliveries_order_idx")
}

// ─────────────────────────────────────────────────────────────────────────────
// BILLING PRINT v2 — per-bill copy (2026-10-05, Schema v27.56,
// sql/2026-10-05-billing-print-v2.sql — applied live by Smart Flow the same day)
// ─────────────────────────────────────────────────────────────────────────────
//
// One row per (trip, bill) whose OBD number billing has copied on the Print
// tab. Keyed per TRIP on purpose: a bill moved to another trip reads uncopied
// there (a new truck is a new print run). NEVER writes orders — a copy is not a
// stage event, and an orders write would fire every orders-keyed marker.
//
// 🔴 TWO LIVE CHECK CONSTRAINTS — NOT EXPRESSIBLE IN PRISMA, live text:
//   chk_trip_bill_copies_kind:  CHECK ((kind = ANY (ARRAY['bulk'::text, 'single'::text, 'review'::text, 'backfill'::text])))
//   chk_trip_bill_copies_actor: CHECK (((kind = 'backfill'::text) OR ("copiedById" IS NOT NULL)))
// bulk = "Copy N OBDs" · single = "Copy this one" on a ready bill · review =
// "Mark done" on a bill with a confirmed pick finding · backfill = written once
// from the old invoices_copied rows (copiedById nullable for that kind only).
// A new kind = ALTER the CHECK first, then the vocabulary constant in code.
//
// 🔴 trip_bill_copies_trip_order_key UNIQUE ("tripId","orderId") IS THE RACE
// GUARD: two presses on one bill → the second is skipped (createMany
// skipDuplicates). Do not drop it.
//
// ON DELETE RESTRICT on trip and order (trips and orders are never deleted);
// copiedBy keeps the default rule, like trips.createdById. Three relations to
// three different models, all NAMED anyway (the trips-family convention).
//
// Live-feed triggers trg_live_changes_trip_bill_copies_{ins,upd,del} (AFTER,
// FOR EACH STATEMENT, live_changes_child_*('trip','parent','tripId')) — the
// trip_drops / trip_redeliveries pattern.
model trip_bill_copies {
  id         Int      @id @default(autoincrement())
  tripId     Int
  trip       trips    @relation("TripBillCopyTrip", fields: [tripId], references: [id], onDelete: Restrict)
  orderId    Int
  order      orders   @relation("TripBillCopyOrder", fields: [orderId], references: [id], onDelete: Restrict)
  /// Snapshot: the OBD number that went on the clipboard.
  obdNumber  String
  /// Snapshot at copy time; screens read the live orders.invoiceNo.
  invoiceNo  String?
  /// bulk | single | review | backfill (chk_trip_bill_copies_kind).
  kind       String
  copiedAt   DateTime @default(now()) @db.Timestamptz(6)
  /// Null only on a 'backfill' row (chk_trip_bill_copies_actor).
  copiedById Int?
  copiedBy   users?   @relation("TripBillCopyCopiedBy", fields: [copiedById], references: [id], onDelete: NoAction)
  createdAt  DateTime @default(now()) @db.Timestamptz(6)

  // Hand-made names, so every one carries an explicit `map:`.
  @@unique([tripId, orderId], map: "trip_bill_copies_trip_order_key")
  @@index([orderId], map: "trip_bill_copies_order_idx")
}

// ─────────────────────────────────────────────
// FREIGHT TRIPS (2026-10-02, Schema v27.51, sql/2026-10-02-freight-trips.sql)
// ─────────────────────────────────────────────
//
// A REPORT-ONLY "paper trip" layer over HELD bills — NOT Orbit's `trips` above.
// Ops group held bills into a freight trip with its own vehicle / transporter /
// driver; a future freight report reads the active freight trip's vehicle for a
// bill instead of its real trip. Code: lib/freight-trips/*, app/api/freight-trips/*.
//
// 🔴 A FREIGHT TRIP NEVER WRITES orders, trips, trip_drops, trip_activity or
// order_status_logs. A held bill stays held; the floor never sees freight.
// 🔴 NO live_changes trigger on these three tables, on purpose (CORE §13): the
// generic trip trigger would publish freight ids as entity='trip' into Floor's
// feed, where they are a different id space.
// Rows are never deleted: cancel / remove stamp removedAt, and freight_trip_activity
// is ON DELETE RESTRICT.

model freight_trips {
  id             Int       @id @default(autoincrement())
  tripNumber     String    @unique // F-YYMMDD-NN, never reused (lib/freight-trips/number.ts)
  tripDate       DateTime  @db.Date
  seq            Int
  vehicleId      Int?
  vehicle        vehicle_master?     @relation(fields: [vehicleId], references: [id])
  adhocVehicleNo String?
  transporterId  Int?
  transporter    transporter_master? @relation(fields: [transporterId], references: [id])
  driverName     String? // SNAPSHOT — copied from vehicle_master or typed; never read through vehicleId
  driverPhone    String? // SNAPSHOT
  note           String?
  manualDispatchAt DateTime? @db.Timestamptz(6) // planner's dispatch time, IST — required on save, nullable in DB (v27.55)
  status         String    @default("active") // FREIGHT_TRIP_STATUS (lib/freight-trips/status.ts)
  cancelledAt    DateTime? @db.Timestamptz(6)
  cancelledById  Int?
  cancelledBy    users?    @relation("FreightTripCancelledBy", fields: [cancelledById], references: [id], onDelete: SetNull)
  createdAt      DateTime  @default(now()) @db.Timestamptz(6)
  createdById    Int
  createdBy      users     @relation("FreightTripCreatedBy", fields: [createdById], references: [id])
  updatedAt      DateTime  @default(now()) @updatedAt @db.Timestamptz(6)
  bills          freight_trip_bills[]
  activity       freight_trip_activity[]

  // Live CHECKs, not expressible here (sql/2026-10-02-freight-trips.sql):
  //   chk_freight_trips_status            status IN ('active','cancelled')
  //   chk_freight_trips_seq_positive      seq >= 1
  //   chk_freight_trips_number_shape      "tripNumber" = 'F-' || YYMMDD("tripDate") || '-' || lpad(seq, greatest(2, len))
  //   chk_freight_trips_vehicle_one_of    NOT (vehicleId AND adhocVehicleNo)
  //   chk_freight_trips_cancelled_complete status <> 'cancelled' OR (cancelledAt AND cancelledById)
  // Its index leads on tripDate: serves the day's list AND the report's date range.
  @@unique([tripDate, seq])
}

model freight_trip_bills {
  id            Int       @id @default(autoincrement())
  freightTripId Int
  freightTrip   freight_trips @relation(fields: [freightTripId], references: [id], onDelete: Restrict)
  orderId       Int
  order         orders    @relation("FreightTripBillOrder", fields: [orderId], references: [id], onDelete: Restrict)
  addedAt       DateTime  @default(now()) @db.Timestamptz(6)
  addedById     Int
  addedBy       users     @relation("FreightTripBillAddedBy", fields: [addedById], references: [id])
  removedAt     DateTime? @db.Timestamptz(6)
  removedById   Int?
  removedBy     users?    @relation("FreightTripBillRemovedBy", fields: [removedById], references: [id], onDelete: SetNull)
  removedReason String? // REMOVED_REASON: removed | trip_cancelled (chk_freight_trip_bills_removed_reason)

  // 🔴 THE RULE "one bill on at most ONE active freight trip" is a PARTIAL unique
  // index, live-only and NOT modellable here — do NOT add @@unique([orderId]):
  //   freight_trip_bills_order_active_key UNIQUE ("orderId") WHERE "removedAt" IS NULL
  // A P2002 from it reports meta.target = ["orderId"] (field names — lib/trips/number.ts note).
  // chk_freight_trip_bills_removed_complete: (removedAt IS NULL) = (removedReason IS NULL)
  //   AND (removedById IS NULL OR removedAt IS NOT NULL).
  @@index([freightTripId])
  @@index([orderId])
}

model freight_trip_activity {
  id            Int      @id @default(autoincrement())
  freightTripId Int
  freightTrip   freight_trips @relation(fields: [freightTripId], references: [id], onDelete: Restrict)
  action        String   // FREIGHT_ACTIONS (chk_freight_trip_activity_action)
  actorId       Int
  actor         users    @relation("FreightTripActivityActor", fields: [actorId], references: [id])
  summary       String
  detail        Json?
  createdAt     DateTime @default(now()) @db.Timestamptz(6)

  @@index([freightTripId, createdAt])
  @@index([createdAt(sort: Desc)], map: "freight_trip_activity_created_idx")
}

// ─────────────────────────────────────────────
// SALES-OFFICER OTP LOGIN (2026-09-29, Schema v27.43)
// ─────────────────────────────────────────────
// Applied BY HAND in the Supabase SQL Editor 2026-09-29 and hand-mirrored here
// (never db push / db pull — CORE §3). DDL of record:
// sql/2026-09-29-so-login-tables.sql. Code: lib/so-auth/, app/api/so-lab/auth/*.
// 🔴 SO login is deliberately SEPARATE from staff NextAuth — do not merge it
// into lib/auth.ts (docs/prompts/drafts/code-update-2026-09-29-so-otp-login.md).
//
// LIVE CHECKs not expressible in Prisma:
//   chk_so_order_access_revoke        ("revokedById" IS NULL OR "revokedAt" IS NOT NULL)
//   chk_so_order_access_revoke_order  ("revokedAt" IS NULL OR "revokedAt" >= "grantedAt")
//   chk_so_login_codes_email_normalised, chk_so_login_codes_hash_not_plain (>= 32 chars),
//   chk_so_login_codes_attempts (>= 0), chk_so_login_codes_expiry, chk_so_login_codes_used
//   chk_so_sessions_hash_not_plain (>= 32 chars), chk_so_sessions_expiry, chk_so_sessions_revoked

// Sales-officer order access. SEPARATE from sales_officer_master on purpose:
// editing the SO master must not grant or revoke order access — only a
// superuser route does (not built yet).
// 🔴 PARTIAL UNIQUE INDEX so_order_access_live_key ("salesOfficerId")
//    WHERE "revokedAt" IS NULL — exists in Supabase only; Prisma cannot model
//    it. Never add @@unique([salesOfficerId]): revoked rows are history, and a
//    re-grant is a NEW row.
model so_order_access {
  id             Int                  @id @default(autoincrement())
  salesOfficerId Int
  salesOfficer   sales_officer_master @relation("SoOrderAccessOfficer", fields: [salesOfficerId], references: [id], onDelete: Restrict)
  grantedById    Int
  grantedBy      users                @relation("SoOrderAccessGrantedBy", fields: [grantedById], references: [id], onDelete: Restrict)
  grantedAt      DateTime             @default(now()) @db.Timestamptz(6)
  revokedAt      DateTime?            @db.Timestamptz(6)
  // SET NULL, so chk_so_order_access_revoke is one-directional on purpose.
  revokedById    Int?
  revokedBy      users?               @relation("SoOrderAccessRevokedBy", fields: [revokedById], references: [id], onDelete: SetNull)
  note           String?
  updatedAt      DateTime             @default(now()) @updatedAt @db.Timestamptz(6)

  @@index([salesOfficerId], map: "so_order_access_so_idx")
}

// One row per OTP issued. codeHash only — chk_so_login_codes_hash_not_plain
// makes a plaintext 6-digit code unstorable. email is stored lower(btrim()).
model so_login_codes {
  id             Int                  @id @default(autoincrement())
  salesOfficerId Int
  salesOfficer   sales_officer_master @relation("SoLoginCodeOfficer", fields: [salesOfficerId], references: [id], onDelete: Cascade)
  email          String
  codeHash       String
  expiresAt      DateTime             @db.Timestamptz(6)
  attempts       Int                  @default(0)
  usedAt         DateTime?            @db.Timestamptz(6)
  requestedIp    String?
  createdAt      DateTime             @default(now()) @db.Timestamptz(6)

  @@index([salesOfficerId, createdAt(sort: Desc)], map: "so_login_codes_so_created_idx")
  @@index([requestedIp, createdAt(sort: Desc)], map: "so_login_codes_ip_created_idx")
}

// Server-side SO sessions. The cookie carries a random token; only its SHA-256
// hash is stored. Valid = not revoked AND not expired AND a live
// so_order_access row AND sales_officer_master.isActive — re-checked on every
// read (lib/so-auth/session.ts getSoSession).
model so_sessions {
  id             Int                  @id @default(autoincrement())
  tokenHash      String               @unique(map: "so_sessions_tokenHash_key")
  salesOfficerId Int
  salesOfficer   sales_officer_master @relation("SoSessionOfficer", fields: [salesOfficerId], references: [id], onDelete: Cascade)
  createdAt      DateTime             @default(now()) @db.Timestamptz(6)
  expiresAt      DateTime             @db.Timestamptz(6)
  lastSeenAt     DateTime             @default(now()) @db.Timestamptz(6)
  revokedAt      DateTime?            @db.Timestamptz(6)
  userAgent      String?
  ip             String?

  @@index([salesOfficerId], map: "so_sessions_so_idx")
}

// ── LIVE FEED — the change book (v27.45, 2026-09-30) ─────────────────────────
// sql/2026-09-30-live-changes.sql · design docs/prompts/drafts/
// code-discovery-2026-09-29-live-change-feed.md (§C) · record
// docs/prompts/drafts/code-update-2026-09-30-live-changes-step1.md
//
// One narrow line per changed entity ('order' | 'trip' | 'config'), WRITTEN
// ONLY BY DATABASE TRIGGERS (today: the three trg_live_changes_orders_*
// statement triggers on `orders`). App code must NEVER insert, update or
// delete here — Prisma cannot even create a row (txId is Unsupported).
// Nothing reads it yet (step 1 of §M); the catch-up API and the 3-day prune
// come in later steps.
//
// 🔴 THE CURSOR IS ("txId", seq), NOT seq ALONE. seq is drawn at INSERT, not at
// commit, so `seq > lastSeq` would skip a transaction that commits late. The
// catch-up read (raw SQL, $queryRaw — xid8 is Unsupported in Prisma 5) returns
// only lines below the commit-safe horizon:
//   WHERE ("txId", seq) > ($cursorTx, $cursorSeq)
//     AND "txId" < pg_snapshot_xmin(pg_current_snapshot())
//   ORDER BY "txId", seq
// Checks chk_live_changes_entity (order|trip|config) and chk_live_changes_op
// (I|U|D) are live-only. seq is GENERATED ALWAYS AS IDENTITY (modelled as
// autoincrement; never written by the app). anon/authenticated are REVOKEd.
model live_changes {
  seq         BigInt                @id @default(autoincrement())
  txId        Unsupported("xid8")   @default(dbgenerated("pg_current_xact_id()"))
  entity      String
  entityId    String
  op          String
  sourceTable String
  createdAt   DateTime              @default(now()) @db.Timestamptz(6)

  @@index([txId, seq], map: "live_changes_tx_seq_idx")
}

// The prune watermark — one row, id 'live_changes'. The prune job (step 2)
// sets prunedThroughTxId to the highest txId it deleted; a client cursor
// older than it is told to do one full reload. Written by raw SQL only (xid8),
// which must stamp updatedAt itself.
model live_feed_meta {
  id                String              @id
  prunedThroughTxId Unsupported("xid8")?
  prunedAt          DateTime?           @db.Timestamptz(6)
  updatedAt         DateTime            @default(now()) @db.Timestamptz(6)
}

// ─────────────────────────────────────────────
// SO ORDER PIPELINE PHASE B — drafts + favourites per SO (2026-10-01, Schema v27.49)
// ─────────────────────────────────────────────
// Applied BY HAND in the Supabase SQL Editor 2026-09-30 and hand-mirrored here
// (never db push / db pull — CORE §3). DDL of record:
// sql/2026-09-30-so-drafts-favourites.sql. Code: lib/so-order/store.ts,
// app/api/so-lab/{state,live-draft,drafts,favourites,stars}, app/so-lab/_board/so-storage.ts.
// Every FK → sales_officer_master ON DELETE CASCADE (personal UI state).
// Row-count caps (20 drafts, 8 favourites refused-not-evicted, 200 stars per
// list) and the 24 h live-draft expiry are CODE rules — a CHECK cannot count rows.

// Named drafts (was po2_saved_drafts on the phone). snapshot = the V2Snapshot
// shape, migrated ON READ by migrateLine on the client.
// LIVE CHECKs not expressible here: chk_so_saved_drafts_client_id (1-64),
// chk_so_saved_drafts_name (≤ 60), chk_so_saved_drafts_label (≤ 200),
// chk_so_saved_drafts_snapshot_shape (object with lines[]),
// chk_so_saved_drafts_snapshot_size (≤ 65536 bytes), chk_so_saved_drafts_snapshot_version (≥ 1).
model so_saved_drafts {
  id              Int                  @id @default(autoincrement())
  salesOfficerId  Int
  salesOfficer    sales_officer_master @relation("SoSavedDraftOfficer", fields: [salesOfficerId], references: [id], onDelete: Cascade)
  clientId        String
  name            String?
  label           String
  snapshot        Json
  snapshotVersion Int                  @default(1) @db.SmallInt
  savedAt         DateTime             @default(now()) @db.Timestamptz(6)
  createdAt       DateTime             @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime             @default(now()) @updatedAt @db.Timestamptz(6)

  @@unique([salesOfficerId, clientId], map: "so_saved_drafts_so_client_key")
  @@index([salesOfficerId, savedAt(sort: Desc)], map: "so_saved_drafts_so_saved_idx")
}

// The in-progress order (was po2_draft), ONE row per SO. The phone stays
// primary; the server copy is written on screen change, page hide, and at most
// once per 60 s while editing. Empty order → DELETE. 24 h expiry on read.
// UPDATE … WHERE revision = expected (optimistic concurrency).
// LIVE CHECKs: chk_so_live_drafts_snapshot_shape, _snapshot_size, _snapshot_version,
// _revision (≥ 1), _device_id (≤ 64).
model so_live_drafts {
  salesOfficerId  Int                  @id
  salesOfficer    sales_officer_master @relation("SoLiveDraftOfficer", fields: [salesOfficerId], references: [id], onDelete: Cascade)
  snapshot        Json
  snapshotVersion Int                  @default(1) @db.SmallInt
  revision        Int                  @default(1)
  deviceId        String?
  createdAt       DateTime             @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime             @default(now()) @updatedAt @db.Timestamptz(6)
}

// Favourite board tiles (was po2_fav_products). tileKey = V2BoardTile.key,
// a FROZEN identifier (CLAUDE_PO2.md §6). Cap 8, the 9th REFUSED — code.
// LIVE CHECK: chk_so_fav_products_tile_key (1-200).
model so_fav_products {
  id             Int                  @id @default(autoincrement())
  salesOfficerId Int
  salesOfficer   sales_officer_master @relation("SoFavProductOfficer", fields: [salesOfficerId], references: [id], onDelete: Cascade)
  tileKey        String
  addedAt        DateTime             @default(now()) @db.Timestamptz(6)

  @@unique([salesOfficerId, tileKey], map: "so_fav_products_so_tile_key")
}

// Both star lists (was po2_starred_dealers 'dealer' / po2_starred_shipto
// 'shipto'). Fuse 200 per list — code.
// LIVE CHECKs: chk_so_starred_dealers_list (IN ('dealer','shipto')),
// chk_so_starred_dealers_code (btrim 1-40), chk_so_starred_dealers_name (≤ 200).
model so_starred_dealers {
  id             Int                  @id @default(autoincrement())
  salesOfficerId Int
  salesOfficer   sales_officer_master @relation("SoStarredDealerOfficer", fields: [salesOfficerId], references: [id], onDelete: Cascade)
  list           String
  customerCode   String
  name           String
  area           String?
  starredAt      DateTime             @default(now()) @db.Timestamptz(6)

  @@unique([salesOfficerId, list, customerCode], map: "so_starred_dealers_so_list_code_key")
}
