generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────

enum StatusDomain {
  dispatch
  tinting
  pick_list
  import
  workflow
  priority
}

enum SlotRuleType {
  time_based
  default
}

enum TinterType {
  TINTER
  ACOTONE
}

enum PackCode {
  ml_500  @map("500ml")
  L_0_9   @map("0.9L")
  L_0_925 @map("0.925L")
  L_1     @map("1L")
  L_3_6   @map("3.6L")
  L_3_7   @map("3.7L")
  L_4     @map("4L")
  L_9     @map("9L")
  L_9_25  @map("9.25L")
  L_10    @map("10L")
  L_15    @map("15L")
  L_18    @map("18L")
  L_18_5  @map("18.5L")
  L_20    @map("20L")
  L_22    @map("22L")
  L_30    @map("30L")
  L_40    @map("40L")
}

enum CustomerSalesOfficerRole {
  PRIMARY
  BACKUP
  JUNIOR
}

// ─────────────────────────────────────────────
// PHASE 1 — Config / Status
// ─────────────────────────────────────────────

model system_config {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

model role_master {
  id          Int          @id @default(autoincrement())
  name        String       @unique
  description String?
  users       users[]
  userRoles   user_roles[]
}

model user_roles {
  id          Int      @id @default(autoincrement())
  userId      Int
  roleId      Int
  isPrimary   Boolean  @default(false)
  createdAt   DateTime @default(now())
  createdById Int?

  user      users       @relation("UserRoleAssignments", fields: [userId], references: [id], onDelete: Cascade)
  role      role_master @relation(fields: [roleId], references: [id])
  createdBy users?      @relation("UserRoleCreator", fields: [createdById], references: [id])

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
}

model role_permissions {
  id        Int      @id @default(autoincrement())
  roleSlug  String // matches ROLES constants: "admin","dispatcher","support","tint_manager","tint_operator","floor_supervisor","picker"
  pageKey   String // e.g. "floor", "tint_manager", "import_obd", "customers", etc.
  canView   Boolean  @default(false)
  canImport Boolean  @default(false)
  canExport Boolean  @default(false)
  canEdit   Boolean  @default(false)
  canDelete Boolean  @default(false)
  updatedAt DateTime @updatedAt

  @@unique([roleSlug, pageKey])
}

model users {
  id                        Int                      @id @default(autoincrement())
  email                     String                   @unique
  phone                     String?                  @unique
  password                  String
  name                      String
  roleId                    Int
  role                      role_master              @relation(fields: [roleId], references: [id])
  isActive                  Boolean                  @default(true)
  createdAt                 DateTime                 @default(now())
  updatedAt                 DateTime                 @updatedAt
  // Attendance fields (v27.0 + v27.1 rollout flag)
  attendanceConsentAt       DateTime?                @db.Timestamptz(6)
  attendanceConsentVersion  String?
  attendanceExempt          Boolean                  @default(false)
  attendanceTestUser        Boolean                  @default(false)
  // Billing v2 rollout (Phase 0, 2026-07-30) — per-USER opt-in for the new
  // Billing UI on /mail-orders. Column was created in the Supabase SQL Editor
  // and is hand-mirrored here; db push/pull are banned (CORE §3) and db pull
  // additionally fails on this machine with P1001.
  //
  // Deliberately NOT cached onto the JWT the way attendanceTestUser is — it is
  // read fresh per page load by lib/billing/flag.ts, so switching a user OFF
  // takes effect immediately instead of after the 5-minute token stale window.
  // See that file's header before "optimising" it into lib/auth.ts.
  billingV2TestUser         Boolean                  @default(false)
  // Notes-band text size on /mail-orders, in PIXELS (2026-08-07). Created in the
  // Supabase SQL Editor and hand-mirrored here — db push/pull are banned
  // (CORE §3) and db pull additionally fails on this machine with P1001.
  //
  // Live column: integer NOT NULL DEFAULT 11, with
  // chk_users_notes_font_size CHECK (notesFontSize >= 11 AND <= 20)
  // (widened from 15 on 2026-08-07).
  // Prisma cannot express that CHECK, so the 11-20 bound is enforced twice in
  // code — the API route rejects out-of-range writes, and
  // lib/mail-orders/notes-font-size.ts clamps on read. Widening the range means
  // changing the constraint AND both of those.
  //
  // Like billingV2TestUser above, deliberately NOT cached onto the JWT: it is
  // read fresh per page load in the mail-orders layout. Caching it behind the
  // 5-minute token stale window would let a reload show the OLD size after the
  // operator had already changed it.
  notesFontSize             Int                      @default(11)
  // Phase 2 back-relations
  importBatches             import_batches[]
  statusLogs                order_status_logs[]
  manualTintEntries         manual_tint_entries[]    @relation("ManualTintEntryPerformedBy")
  tintAssignmentsAsOperator tint_assignments[]       @relation("TintAssignmentOperator")
  tintAssignmentsAsManager  tint_assignments[]       @relation("TintAssignmentManager")
  tintLogs                  tint_logs[]
  // Phase 3 back-relations
  splitsAsOperator          order_splits[]           @relation("SplitOperator")
  splitsAsManager           order_splits[]           @relation("SplitManager")
  splitStatusLogs           split_status_logs[]      @relation("SplitStatusLogUser")
  tinterIssueEntries        tinter_issue_entries[]
  tinterIssueEntriesB       tinter_issue_entries_b[]
  shadeMasters              shade_master[]
  // Phase 3.5 back-relations
  challansPrinted           delivery_challans[]      @relation("ChallanPrintedBy")
  // Phase 4 back-relations
  plansCreated              dispatch_plans[]         @relation("PlanCreatedBy")
  plansConfirmed            dispatch_plans[]         @relation("PlanConfirmedBy")
  plansDispatched           dispatch_plans[]         @relation("PlanDispatchedBy")
  dispatchPlanOrders        dispatch_plan_orders[]   @relation("DPOrderAddedBy")
  pickListsAsPicker         pick_lists[]             @relation("PickListPicker")
  pickListsAssigned         pick_lists[]             @relation("PickListAssignedBy")
  pickListsVerified         pick_lists[]             @relation("PickListVerifiedBy")
  changesCreated            dispatch_change_queue[]  @relation("ChangeCreatedBy")
  changesAcknowledged       dispatch_change_queue[]  @relation("ChangeAcknowledgedBy")
  splitsPickedBy            order_splits[]           @relation("SplitPickedBy")
  ordersPickedBy            orders[]                 @relation("OrderPickedBy")
  pickAssignmentsAsPicker   pick_assignments[]       @relation("PickAssignmentPicker")
  pickAssignmentsAssigned   pick_assignments[]       @relation("PickAssignmentAssignedBy")
  pickAssignmentsChecked    pick_assignments[]       @relation("PickAssignmentCheckedBy")
  // Picking findings (2026-08-07) — TWO FKs from one table to `users`, so BOTH
  // sides must stay explicitly named or Prisma throws an ambiguity ERROR at
  // generate time. Same rule as the three PickAssignment* relations above.
  pickFindingsReported      pick_findings[]          @relation("PickFindingReportedBy")
  pickFindingsRecorded      pick_findings[]          @relation("PickFindingRecordedBy")
  // MRN back-relations (2026-08-20, v27.16) — FOUR FKs from `mrn` to `users`
  // plus ONE from `mrn_lines`. All five relations MUST stay explicitly named on
  // BOTH sides or Prisma throws an ambiguity ERROR at generate time, not a
  // warning. Same rule as the two PickFinding* above and the three
  // PickAssignment* before them — this is the largest such cluster in the
  // schema, so it is also the easiest one to half-edit.
  mrnsCreated               mrn[]                    @relation("MrnCreatedBy")
  mrnsUnloadingStarted      mrn[]                    @relation("MrnUnloadingStartedBy")
  mrnsUnloadingEnded        mrn[]                    @relation("MrnUnloadingEndedBy")
  mrnsRemoved               mrn[]                    @relation("MrnRemovedBy")
  mrnLinesChecked           mrn_lines[]              @relation("MrnLineCheckedBy")
  // Mail Order back-relations
  mailOrdersPunched         mo_orders[]              @relation("MoOrderPunchedBy")
  lineStatuses              mo_line_status[]
  // Multi-role back-relations
  userRoles                 user_roles[]             @relation("UserRoleAssignments")
  userRolesCreated          user_roles[]             @relation("UserRoleCreator")
  // Attendance back-relations (v27.0)
  attendanceRecords         attendance_records[]     @relation("AttendanceUser")
  attendanceRecordsCreated  attendance_records[]     @relation("AttendanceCreatedBy")
  attendanceSummaries       attendance_summary[]
  attendanceSettingsUpdated attendance_settings[]
  // OT (overtime) approval back-relations
  attendanceOtApprovals        attendance_records[]  @relation("AttendanceOtApprover")
  attendanceOtGraceCounters    attendance_ot_grace[] @relation("AttendanceOtGraceUser")
  attendanceOtAudits           attendance_ot_audit[] @relation("AttendanceOtAuditUser")
  attendanceOtAuditsPerformed  attendance_ot_audit[] @relation("AttendanceOtAuditPerformer")
  // TM Remove OBD / Operator Skip / Pause back-relations
  ordersRemoved                orders[]              @relation("OrderRemovedBy")
  ordersRestored               orders[]              @relation("OrderRestoredBy")
  // Picking early-release (5b, 2026-07-20) — FOURTH named users relation on
  // `orders`, alongside OrderPickedBy / OrderRemovedBy / OrderRestoredBy.
  // All four MUST stay explicitly named on both sides: an unnamed relation
  // here is a Prisma ambiguity ERROR, not a warning (CLAUDE_CORE.md §7.3).
  ordersPickEarlyReleased      orders[]              @relation("OrderPickEarlyReleasedBy")
  ordersInvoicedBy             orders[]              @relation("OrderInvoicedBy")
  billingSettingsUpdated       billing_settings[]    @relation("BillingSettingsUpdatedBy")
  tintSkipsAsActor             tint_skip_events[]    @relation("SkipActor")
  tintPausesAsOp               tint_pause_events[]   @relation("PauseOperator")
  tintPauseResumes             tint_pause_events[]   @relation("PauseResumer")
  // Sampling Library back-relations
  samplingRegisterCreated      sampling_register[]   @relation("SamplingRegisterCreatedBy")
  samplingUsageEntries         sampling_usage_log[]  @relation("SamplingUsageOperator")
  // Web Push — one user → many devices. Single FK to users, so no named relation.
  pushSubscriptions            push_subscriptions[]
  // Admin audit trail — one user → many logged actions. Single FK to users, so
  // no named relation (contrast the PickFinding*/Mrn* clusters above, which have
  // several FKs to `users` and MUST stay named on both sides — CORE §7.3).
  adminAuditLogs               admin_audit_log[]
  // CI (Goods Return Note) back-relations (2026-09-01) — THREE FKs from
  // `ci_returns` to `users`: supervisorId / billingOperatorId / voidedById.
  // ⚠ ALL THREE MUST STAY EXPLICITLY NAMED ON BOTH SIDES. Three FKs to the same
  // model is exactly the ambiguity CORE §7.3 records: an unnamed one is a Prisma
  // ERROR at generate time, not a warning. Same discipline as the Mrn*/
  // PickFinding* clusters above.
  ciReturnsAsSupervisor        ci_returns[]          @relation("CiReturnSupervisor")
  ciReturnsAsBillingOperator   ci_returns[]          @relation("CiReturnBillingOperator")
  ciReturnsVoided              ci_returns[]          @relation("CiReturnVoidedBy")
}

// Web Push device subscriptions. Table created by hand in Supabase (11 cols,
// endpoint UNIQUE). camelCase columns, no @map. Timestamps carry
// @db.Timestamptz(6) or Prisma emits plain `timestamp` and mismatches the live
// column (CLAUDE_CORE.md §7.1.c). `updatedAt` has a DB DEFAULT now() but NO
// trigger — it is a PLAIN field (NOT @updatedAt); every write sets it
// explicitly (see lib/push/send.ts + the subscribe/unsubscribe routes).
model push_subscriptions {
  id           Int       @id @default(autoincrement())
  userId       Int
  user         users     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint     String    @unique(map: "push_subscriptions_endpoint_key")
  p256dh       String
  auth         String
  userAgent    String?
  isActive     Boolean   @default(true)
  failureCount Int       @default(0)
  lastSeenAt   DateTime? @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime  @default(now()) @db.Timestamptz(6)
}

// Admin audit trail — WHO changed WHAT, for the admin writes that record no
// actor on the row itself (v27.18, 2026-09-01). Table created BY HAND in the
// Supabase SQL Editor by the owner and hand-mirrored here; never db push, never
// db pull (CORE §3 — db pull also fails P1001 on this machine). camelCase
// columns, NO @map — the live names already match.
//
// `createdAt` carries @db.Timestamptz(6) or Prisma emits plain `timestamp` and
// silently mismatches the live `timestamp with time zone` (CORE §7.1.c).
//
// APPEND-ONLY BY CONVENTION, not by constraint. Nothing in the schema stops an
// UPDATE or DELETE — the discipline lives in the fact that `lib/audit/log.ts` is
// the only writer and only ever inserts. Do not add an edit path.
//
// 🔴 `id` is BigInt, matching the live BIGSERIAL and the tint_skip_events /
// tint_pause_events precedent. JSON.stringify THROWS on a BigInt
// ("Do not know how to serialize a BigInt"), so a future read API must convert
// (`Number(row.id)` or `.toString()`) before returning rows. The write helper is
// safe today only because it never returns the created row.
//
// 🔴 beforeData / afterData MUST NEVER contain a password or a password hash.
// The redaction lives in lib/audit/log.ts, not here — Prisma cannot enforce it.
model admin_audit_log {
  id         BigInt   @id @default(autoincrement())
  userId     Int
  user       users    @relation(fields: [userId], references: [id])
  entity     String
  entityId   String?
  action     String
  summary    String?
  beforeData Json?
  afterData  Json?
  createdAt  DateTime @default(now()) @db.Timestamptz(6)

  // Explicit `map:` on all three — the live index names are hand-made and do
  // not match what Prisma would generate by default. Same reason
  // pick_findings_order_idx carries one (CORE §7.4).
  @@index([createdAt(sort: Desc)], map: "admin_audit_log_created_idx")
  @@index([entity, entityId], map: "admin_audit_log_entity_idx")
  @@index([userId], map: "admin_audit_log_user_idx")
}

model status_master {
  id          Int          @id @default(autoincrement())
  domain      StatusDomain
  code        String
  label       String
  sortOrder   Int
  isActive    Boolean      @default(true)
  description String?
  createdAt   DateTime     @default(now())

  @@unique([domain, code])
}

// ─────────────────────────────────────────────
// PHASE 1 — SKU Hierarchy
// ─────────────────────────────────────────────

model product_category {
  id           Int            @id @default(autoincrement())
  name         String         @unique
  isActive     Boolean        @default(true)
  createdAt    DateTime       @default(now())
  productNames product_name[]
  skus         sku_master[]
}

model product_name {
  id         Int              @id @default(autoincrement())
  name       String           @unique
  categoryId Int
  category   product_category @relation(fields: [categoryId], references: [id])
  isActive   Boolean          @default(true)
  createdAt  DateTime         @default(now())
  skus       sku_master[]
}

model base_colour {
  id        Int          @id @default(autoincrement())
  name      String       @unique
  isActive  Boolean      @default(true)
  createdAt DateTime     @default(now())
  skus      sku_master[]
}

model sku_master {
  id                Int                          @id @default(autoincrement())
  skuCode           String                       @unique
  skuName           String
  productCategoryId Int
  productCategory   product_category             @relation(fields: [productCategoryId], references: [id])
  productNameId     Int
  productName       product_name                 @relation(fields: [productNameId], references: [id])
  baseColourId      Int
  baseColour        base_colour                  @relation(fields: [baseColourId], references: [id])
  packSize          String
  containerType     String
  unitsPerCarton    Int?
  isActive          Boolean                      @default(true)
  createdAt         DateTime                     @default(now())
  updatedAt         DateTime                     @updatedAt
  // Phase 2 back-relation
  enrichedLineItems import_enriched_line_items[]
}

// ─────────────────────────────────────────────
// PHASE 1 — Transporter / Vehicle
// ─────────────────────────────────────────────

model transporter_master {
  id            Int              @id @default(autoincrement())
  name          String           @unique
  contactPerson String?
  phone         String?
  email         String?
  isActive      Boolean          @default(true)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  vehicles      vehicle_master[]
}

// ─────────────────────────────────────────────
// PHASE 1 — Geography & Delivery
// ─────────────────────────────────────────────

model delivery_type_master {
  id                      Int                         @id @default(autoincrement())
  name                    String                      @unique
  createdAt               DateTime                    @default(now())
  areas                   area_master[]
  slotConfigs             delivery_type_slot_config[]
  dispatchDeliveryPoints  delivery_point_master[]     @relation("DispatchDeliveryType")
  reportingDeliveryPoints delivery_point_master[]     @relation("ReportingDeliveryType")
}

model slot_master {
  id                 Int                         @id @default(autoincrement())
  name               String                      @unique
  slotTime           String
  isNextDay          Boolean                     @default(false)
  isActive           Boolean                     @default(true)
  sortOrder          Int
  createdAt          DateTime                    @default(now())
  updatedAt          DateTime                    @updatedAt
  slotConfigs        delivery_type_slot_config[]
  orders             orders[]                    @relation("OrderCurrentSlot")
  ordersOriginalSlot orders[]                    @relation("OrderOriginalSlot")
  ordersArrival        orders[]                    @relation("OrderArrivalSlot")
  dispatchPlans        dispatch_plans[]
}

model dispatch_slot_master {
  id         Int      @id @default(autoincrement())
  windowTime String
  label      String?
  sortOrder  Int
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  orders     orders[] @relation("OrderDispatchWindow")
  // Phase 2 slot intent on the mail order. A SECOND relation on this table, but
  // to a DIFFERENT model, so there is no ambiguity trap — named on both sides
  // anyway, matching the house pattern.
  moOrders   mo_orders[] @relation("MoOrderDispatchWindow")
}

model delivery_type_slot_config {
  id             Int                  @id @default(autoincrement())
  deliveryTypeId Int
  deliveryType   delivery_type_master @relation(fields: [deliveryTypeId], references: [id])
  slotId         Int
  slot           slot_master          @relation(fields: [slotId], references: [id])
  slotRuleType   SlotRuleType
  windowStart    String?
  windowEnd      String?
  isDefault      Boolean              @default(false)
  isActive       Boolean              @default(true)
  sortOrder      Int
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@unique([deliveryTypeId, slotId])
}

model route_master {
  id                    Int                     @id @default(autoincrement())
  name                  String                  @unique
  description           String?
  /// The loading bay this route's material is stacked at (2026-08-21).
  /// NULLABLE and NOT UNIQUE — several routes share a bay (bay 1 serves Adajan,
  /// Parvat, Navsari, Chikhli, Bhagal and Olpad), and HAND / No Route have none.
  /// It is NOT a route id and it is NOT per delivery type: bay 1 carries Local
  /// and Upcountry routes both, so the number alone never identifies a lane.
  /// Column already exists in Supabase and was hand-mirrored here — CORE §3
  /// (never db push, never db pull, ALTER in the SQL Editor then generate).
  bayNumber             Int?
  isActive              Boolean                 @default(true)
  createdAt             DateTime                @default(now())
  areaRoutes            area_route_map[]
  primaryAreas          area_master[]           @relation("AreaPrimaryRoute")
  customerPrimaryRoutes delivery_point_master[] @relation("CustomerPrimaryRoute")
}

model area_master {
  id             Int                     @id @default(autoincrement())
  name           String
  deliveryTypeId Int
  deliveryType   delivery_type_master    @relation(fields: [deliveryTypeId], references: [id])
  primaryRouteId Int?
  primaryRoute   route_master?           @relation("AreaPrimaryRoute", fields: [primaryRouteId], references: [id])
  isActive       Boolean                 @default(true)
  createdAt      DateTime                @default(now())
  areaRoutes     area_route_map[]
  subAreas       sub_area_master[]
  deliveryPoints delivery_point_master[]
}

model area_route_map {
  id      Int          @id @default(autoincrement())
  areaId  Int
  area    area_master  @relation(fields: [areaId], references: [id])
  routeId Int
  route   route_master @relation(fields: [routeId], references: [id])

  @@unique([areaId, routeId])
}

model sub_area_master {
  id             Int                     @id @default(autoincrement())
  name           String
  areaId         Int
  area           area_master             @relation(fields: [areaId], references: [id])
  isActive       Boolean                 @default(true)
  createdAt      DateTime                @default(now())
  deliveryPoints delivery_point_master[]
}

// ─────────────────────────────────────────────
// PHASE 1 — Sales Officer
// ─────────────────────────────────────────────

model sales_officer_master {
  id                      Int                       @id @default(autoincrement())
  name                    String
  employeeCode            String
  email                   String?                   @unique
  phone                   String?
  isActive                Boolean                   @default(true)
  createdAt               DateTime                  @default(now())
  deliveryPoints          delivery_point_master[]
  groups                  sales_officer_group[]
  samplingRegisterEntries sampling_register[]
  customerLinks           customer_sales_officers[] @relation("CustomerSOLinks")
  contactLinks            delivery_point_contacts[] @relation("ContactSOLinks")
}

model sales_officer_group {
  id             Int                     @id @default(autoincrement())
  name           String                  @unique
  salesOfficerId Int
  salesOfficer   sales_officer_master    @relation(fields: [salesOfficerId], references: [id])
  isActive       Boolean                 @default(true)
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  customers      delivery_point_master[]
}

// ─────────────────────────────────────────────
// PHASE 1 — Customers
// ─────────────────────────────────────────────

model customer_type_master {
  id             Int                     @id @default(autoincrement())
  name           String                  @unique
  isActive       Boolean                 @default(true)
  createdAt      DateTime                @default(now())
  deliveryPoints delivery_point_master[]

  @@map("customer_type_master")
}

model premises_type_master {
  id             Int                     @id @default(autoincrement())
  name           String                  @unique
  isActive       Boolean                 @default(true)
  createdAt      DateTime                @default(now())
  deliveryPoints delivery_point_master[]

  @@map("premises_type_master")
}

model contact_role_master {
  id        Int                       @id @default(autoincrement())
  name      String                    @unique
  isActive  Boolean                   @default(true)
  createdAt DateTime                  @default(now())
  contacts  delivery_point_contacts[]
}

model delivery_point_master {
  id                      Int                       @id @default(autoincrement())
  customerCode            String                    @unique
  customerName            String
  areaId                  Int
  area                    area_master               @relation(fields: [areaId], references: [id])
  subAreaId               Int?
  subArea                 sub_area_master?          @relation(fields: [subAreaId], references: [id])
  salesOfficerId          Int?
  salesOfficer            sales_officer_master?     @relation(fields: [salesOfficerId], references: [id])
  primaryRouteId          Int?
  primaryRoute            route_master?             @relation("CustomerPrimaryRoute", fields: [primaryRouteId], references: [id])
  dispatchDeliveryTypeId  Int?
  dispatchDeliveryType    delivery_type_master?     @relation("DispatchDeliveryType", fields: [dispatchDeliveryTypeId], references: [id])
  reportingDeliveryTypeId Int?
  reportingDeliveryType   delivery_type_master?     @relation("ReportingDeliveryType", fields: [reportingDeliveryTypeId], references: [id])
  customerTypeId          Int?
  customerType            customer_type_master?     @relation(fields: [customerTypeId], references: [id])
  premisesTypeId          Int?
  premisesType            premises_type_master?     @relation(fields: [premisesTypeId], references: [id])
  salesOfficerGroupId     Int?
  salesOfficerGroup       sales_officer_group?      @relation(fields: [salesOfficerGroupId], references: [id])
  address                 String?
  customerRating          String?
  isKeyCustomer           Boolean                   @default(false)
  isKeySite               Boolean                   @default(false)
  acceptsPartialDelivery  Boolean                   @default(true)
  workingHoursStart       String?
  workingHoursEnd         String?
  noDeliveryDays          String[]
  latitude                Float?
  longitude               Float?
  isActive                Boolean                   @default(true)
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt
  contacts                delivery_point_contacts[]
  // Phase 2 back-relation
  orders                  orders[]                  @relation("OrderCustomer")
  // Ship-to override back-relation (2026-07-07)
  shipToOverrideOrders    orders[]                  @relation("OrderShipToOverride")
  // mo_orders ship-to override back-relation (2026-07-07)
  mo_orders_shipToOverride mo_orders[]              @relation("MoOrderShipToOverride")
  // Sampling Library back-relation
  samplingRegisterEntries sampling_register[]
  samplingUsageLogEntries sampling_usage_log[]
  // Phase 1 multi-SO back-relation
  salesOfficerLinks       customer_sales_officers[]
  // CI returns back-relation (2026-09-01). ci_returns has ONE FK here
  // (customerId, ON DELETE SET NULL) but the relation is NAMED anyway, to match
  // the name carried on the ci_returns side — spec §6 lists it as
  // @relation("CiReturnCustomer"). A name on one side only is a Prisma error.
  ciReturns               ci_returns[]              @relation("CiReturnCustomer")
