/// Picking findings — what the floor ACTUALLY found on a checked line (short
/// quantity, or old manufacturing date). Table created by hand in the Supabase
/// SQL Editor and hand-mirrored here; db push/pull are banned (CORE §3) and db
/// pull additionally fails on this machine with P1001. Column list, types and
/// nullability re-verified against information_schema before this model was
/// written — do not re-guess them.
///
/// camelCase columns, NO @map — unlike its neighbour `pick_assignments`, which
/// is snake_case-mapped because it predates that rule (CORE §7.4). Do not
/// "harmonise" the two.
///
/// WHY THE FK IS SAFE. `rawLineItemId` points at import_raw_line_items.id, a
/// real autoincrement PK. A re-import PATCHES a matched line in place
/// (lib/import-upsert/lines.ts — matched on lineId+skuCodeRaw, then
/// `update where id`) and SOFT-removes an absent one (lineStatus =
/// 'removed_by_import'); there is no hard delete of that table anywhere in the
/// repo, so a finding's target row cannot vanish underneath it. Four other
/// tables already FK the same id (import_enriched_line_items, split_line_items,
/// delivery_challan_formulas, tinter_issue_entries).
///
/// obdNumber / lineId / skuCodeRaw are DENORMALISED COPIES, deliberately — a
/// finding is a record of what a human observed, and it must still read
/// correctly if its line is later soft-removed by a re-import. Do not drop them
/// as "derivable"; the FK answers a different question.
/// ⚠ `lineId` here is TEXT (nullable), NOT the Int that import_raw_line_items
/// carries. That is what the live column is — a copy for display, not a join key.
///
/// NOT EXPRESSIBLE IN PRISMA — live in Supabase, recorded here by hand:
///   chk_pick_findings_reason  CHECK (reason IN ('short_quantity','old_mfg'))
///     — same shape as chk_pick_assignments_status (CLAUDE_PICKING.md §7): a
///       THIRD reason string needs a SQL ALTER first, never just a new literal
///       in application code.
///   pick_findings_confirmed_idx  ON ("recordedById") WHERE "recordedById" IS NOT NULL
///     — partial index, same class as orders_billing_pending_idx. Do NOT model
///       it as @@index.
model pick_findings {
  id            Int                   @id @default(autoincrement())
  orderId       Int
  order         orders                @relation(fields: [orderId], references: [id])
  // One finding per raw line — UNIQUE live (pick_findings_rawLineItemId_key),
  // which makes this a one-to-one from the line's side. Uniqueness is expressed
  // HERE, on the id, never on the (obdNumber, lineId, skuCodeRaw) tuple: that
  // tuple is not unique in live data.
  rawLineItemId Int                   @unique
  rawLineItem   import_raw_line_items @relation(fields: [rawLineItemId], references: [id])
  obdNumber     String
  lineId        String?
  skuCodeRaw    String?
  qtyOrdered    Int
  qtyFound      Int
  reason        String
  remarks       String?
  // Manufacturing month/year — the OLD MFG half of `reason`, added 2026-08-08.
  // Live columns (integer, nullable) created by hand in the Supabase SQL Editor
  // and mirrored here; never db push (CORE §3).
  //
  // ⚠ REASON-DEPENDENT, and the DB does NOT enforce the dependency. Both are
  // REQUIRED when reason = 'old_mfg' and forced to NULL when reason =
  // 'short_quantity' — that rule lives in the two write routes
  // (app/api/picking/findings/report|confirm), because a CHECK spanning three
  // columns would also have to be re-stated here as a comment nobody can run.
  // A row with reason='short_quantity' and a non-null mfgMonth is a BUG in a
  // write path, not a state the schema permits by design.
  //
  // NOT EXPRESSIBLE IN PRISMA — live in Supabase, recorded here by hand:
  //   chk_pick_findings_mfg_month  CHECK (mfgMonth IS NULL OR mfgMonth BETWEEN 1 AND 12)
  //     — same class as chk_pick_findings_reason above. The routes validate the
  //       1-12 range themselves so a bad value returns a clean 400 instead of a
  //       raw constraint violation; this constraint is the backstop, not the
  //       first line of defence. There is deliberately NO year constraint —
  //       "reasonable year" is a UI judgement that will age, not an invariant.
  mfgMonth      Int?
  mfgYear       Int?
  // TWO FKs to `users` on one table — BOTH relations MUST stay explicitly named
  // on both sides (here and on the users model), or Prisma throws an ambiguity
  // ERROR at generate time, not a warning. Same discipline as pick_assignments'
  // three named users relations and orders' five (CORE §7.3).
  //   reported = the picker/supervisor who saw it on the floor
  //   recorded = whoever confirmed it downstream
  reportedById  Int?
  reportedBy    users?                @relation("PickFindingReportedBy", fields: [reportedById], references: [id])
  reportedAt    DateTime?             @db.Timestamptz(6)
  recordedById  Int?
  recordedBy    users?                @relation("PickFindingRecordedBy", fields: [recordedById], references: [id])
  recordedAt    DateTime?             @db.Timestamptz(6)
  // @db.Timestamptz(6) is REQUIRED on every timestamp here — without it Prisma
  // emits plain `timestamp` and mismatches the live column (CORE §7.1.c).
  createdAt     DateTime              @default(now()) @db.Timestamptz(6)

  // `map:` is required — the live index is pick_findings_order_idx, whereas
  // Prisma's default name for this would be pick_findings_orderId_idx.
  @@index([orderId], map: "pick_findings_order_idx")
}

