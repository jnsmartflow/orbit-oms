// ─────────────────────────────────────────────
// MRN — MATERIAL RECEIPT NOTE
// ─────────────────────────────────────────────

// Inbound goods receipt (v27.16, 2026-08-20; **v27.17** 2026-08-22 —
// mrn_line_batches.bestBeforeMonth/Year made NULLABLE and retired from every
// surface, see that model's header). The only module that records
// stock coming INTO the depot; it touches nothing in the OBD/orders pipeline.
// Design record: docs/prompts/drafts/web-update-2026-08-20-mrn-module-design.md
//
// All three tables were created BY HAND in the Supabase SQL Editor and are
// hand-mirrored here; never db push, never db pull (CORE §3 — db pull also
// fails P1001 on this machine). camelCase columns, NO @map — the pick_findings
// convention, deliberately NOT pick_assignments' snake_case legacy. Every
// timestamp carries @db.Timestamptz(6) and every date @db.Date, or Prisma
// emits a plain `timestamp` and mismatches the live column (CORE §7.1.c).
//
// Every index and unique name below is ALREADY Prisma's default for its shape,
// so no `map:` argument is needed anywhere in this section — checked name by
// name against pg_indexes, not assumed (contrast pick_findings_order_idx,
// which does need one).

// ⚠ FOUR FKs to `users` on this ONE table (createdById / unloadingStartById /
// unloadingEndById / removedById), plus a fifth from mrn_lines below. ALL FIVE
// relations must stay explicitly NAMED on BOTH sides — here and on the `users`
// model — or Prisma throws an ambiguity ERROR at generate time, not a warning.
// Same discipline as pick_findings' two and pick_assignments' three (CORE
// §7.3), at double the usual scale.
//
// NOT EXPRESSIBLE IN PRISMA — live in Supabase, recorded here by hand:
//   chk_mrn_status         CHECK (status IN ('open','checking','done'))
//   chk_mrn_received_from  CHECK ("receivedFrom" IN ('TPW','CDC'))
// A fourth status value or a third source depot is a SQL ALTER on the
// constraint FIRST — never just a new literal in a route or a new option in a
// segmented control. Same class as chk_pick_assignments_status (CORE §7.4).
//
// ⚠ srNo is UNIQUE per mrnDate and this table SOFT-deletes (isRemoved). The
// srNo/mrnNumber allocator MUST COUNT REMOVED ROWS — it is the one read on
// this table that deliberately does not filter isRemoved, exactly like challan
// sequence allocation (CORE §13). Every other read filters isRemoved=false,
// and a removed MRN disappears from BOTH faces.
//
// ⚠ mrnDate and truckReportingDate are DIFFERENT THINGS, and are usually the
// same day — which is what makes confusing them easy. mrnDate = the IST date
// the MRN was raised; it partners srNo in the unique key and drives billing's
// date stepper. truckReportingDate = the day the truck reported; it is what
// every screen labelled "reported" shows, and what the age tags key off. BOTH
// are immutable after create — editing truckReportingDate later must never
// renumber anything.
model mrn {
  id                 Int         @id @default(autoincrement())
  mrnNumber          String      @unique
  mrnDate            DateTime    @db.Date
  srNo               Int
  truckReportingDate DateTime    @db.Date
  receivedFrom       String
  receivingWarehouse String      @default("Surat")
  stiRefNo           String?
  deliveryNo         String?
  otrNo              String?
  status             String      @default("open")

  unloadingStartAt   DateTime?   @db.Timestamptz(6)
  unloadingStartById Int?
  unloadingStartBy   users?      @relation("MrnUnloadingStartedBy", fields: [unloadingStartById], references: [id])
  unloadingEndAt     DateTime?   @db.Timestamptz(6)
  unloadingEndById   Int?
  unloadingEndBy     users?      @relation("MrnUnloadingEndedBy", fields: [unloadingEndById], references: [id])

  isRemoved          Boolean     @default(false)
  removedAt          DateTime?   @db.Timestamptz(6)
  removedById        Int?
  removedBy          users?      @relation("MrnRemovedBy", fields: [removedById], references: [id])

  // ON DELETE RESTRICT live, deliberately unlike the three SET NULL FKs above:
  // an MRN must always know who raised it. Prisma's default action for a
  // REQUIRED relation is already Restrict, so this matches with no onDelete:
  // argument — stated here so nobody "adds the missing one" and changes it.
  createdById        Int
  createdBy          users       @relation("MrnCreatedBy", fields: [createdById], references: [id])

  createdAt          DateTime    @default(now()) @db.Timestamptz(6)
  // @updatedAt, NOT a plain @default(now()). The live column is NOT NULL
  // DEFAULT now() with no trigger, so the DB covers INSERT only — precisely
  // the shape that made push_subscriptions.updatedAt a landmine (CORE §13).
  // Every write to this table goes through Prisma, so letting Prisma stamp
  // UPDATEs removes that whole class instead of documenting it.
  updatedAt          DateTime    @updatedAt @db.Timestamptz(6)

  lines              mrn_lines[]

  @@unique([mrnDate, srNo])
  @@index([mrnDate(sort: Desc)])
  @@index([status])
}

// One row per STI line, as pasted by billing.
//
// ⚠ `skuCode` is the raw SAP material code as typed — NOT a catalog row id,
// and deliberately NOT an FK. Resolve it against sku_master_v2.material with a
// raw-code fallback, NEVER via any id: the two catalog tables share ZERO id
// space (CORE §13, the id-space landmine), so an id-based lookup renders a
// confidently WRONG product name and pack. A code absent from the catalog is a
// normal state, not an error — ~27% of distinct active SAP codes resolve in
// neither table, and the screens render "Not in catalog" with a bare code.
//
// ⚠ There is deliberately NO shortQty / excessQty column. Short and Excess are
// DERIVED — max(0, qtySti - physicalQty) and max(0, physicalQty - qtySti) —
// computed at render and at export. Storing them would let two places
// disagree. The report's eight condition columns are the six below plus those
// two derived values.
model mrn_lines {
  id          Int                @id @default(autoincrement())
  mrnId       Int
  mrn         mrn                @relation(fields: [mrnId], references: [id], onDelete: Cascade)
  lineNo      Int
  skuCode     String
  qtySti      Int
  // The one supervisor-shaped column billing fills: it comes off the STI sheet.
  cartonQty   Int?
  physicalQty Int?
  isChecked   Boolean            @default(false)
  checkedAt   DateTime?          @db.Timestamptz(6)
  checkedById Int?
  checkedBy   users?             @relation("MrnLineCheckedBy", fields: [checkedById], references: [id])

  // Condition split of what physically arrived. QTD's meaning is UNKNOWN — it
  // is carried through the schema, the UI and the report because the source
  // workbook has it. Do not repurpose it.
  sndQty      Int?
  leakyQty    Int?
  damageQty   Int?
  emptyQty    Int?
  qtdQty      Int?
  rejQty      Int?

  createdAt   DateTime           @default(now()) @db.Timestamptz(6)
  // @updatedAt for the same reason as mrn.updatedAt above.
  updatedAt   DateTime           @updatedAt @db.Timestamptz(6)

  batches     mrn_line_batches[]

  @@unique([mrnId, lineNo])
  @@index([skuCode])
}

// One row per manufacturing batch on a line. USUALLY exactly one; a line
// occasionally splits across two or more (46 tins: 30 from Jun-26, 16 from
// Jul-26), which is what makes this a table rather than four columns on
// mrn_lines. The single-batch case is still a batch row — one owner per
// behaviour, so a split line and a plain line take the identical code path.
//
// NOT EXPRESSIBLE IN PRISMA — live in Supabase, recorded here by hand:
//   chk_mrn_batch_qty        CHECK (qty > 0)
//   chk_mrn_batch_mfg_month  CHECK ("mfgMonth" BETWEEN 1 AND 12)
//   chk_mrn_batch_bb_month   CHECK ("bestBeforeMonth" BETWEEN 1 AND 12)
//                            ⚠ STILL LIVE, and harmless now the column is
//                            nullable: a CHECK passes when its expression is
//                            NULL (NULL is not FALSE), so a row with no
//                            best-before satisfies it. Left in place rather
//                            than dropped — if the field is ever collected
//                            again the guard is already there.
// There is deliberately NO year constraint on either pair — "a reasonable
// year" is a UI judgement that ages, not an invariant (the pick_findings
// precedent).
//
// ⚠ qty > 0 means a line confirmed at physicalQty = 0 carries NO batch row at
// all. That is an ALLOWED state, decided 2026-08-20: a truck genuinely
// bringing none of a line is a real receipt. Mfg and Best-before render "—" on
// screen and blank in the export, and Short derives to the full qtySti. Zero
// batches is not a missing write.
//
// ⚠ SUM(qty) across a line's batches must equal mrn_lines.physicalQty. The DB
// does NOT enforce that — it lives in the confirm route and in the line
// sheet's own arithmetic. Same "dependency no CHECK can hold" class as
// pick_findings' reason↔mfgMonth rule (CORE §7.4).
//
// 🔴 bestBeforeMonth / bestBeforeYear ARE DELIBERATELY UNUSED as of 2026-08-22
// (v27.17), and NULLABLE in live — the ALTER ran through Smart Flow and was
// SELECT-verified before any code changed.
//
// THIS IS NOT A FORGOTTEN FIELD. Nothing collects it and nothing displays it:
// the supervisor does not record a best-before date, so the pickers were
// removed from the line sheet, the requirement was removed from
// validateBatches(), the confirm route no longer accepts it, and the column
// was removed from the desktop lines table. A future session reading these two
// columns as "we capture this, it just isn't shown" would be wrong.
//
// The columns STAY rather than being dropped because the decision is about who
// records the data, not about whether the shape is right — if the depot ever
// starts capturing it, the column, its CHECK and the type are all still here.
// Every row written from 2026-08-22 onward has NULL in both.
//
// ⚠ chk_mrn_batch_bb_month is STILL LIVE and is harmless now the column is
// nullable: a CHECK passes when its expression is NULL (NULL is not FALSE), so
// a row with no best-before satisfies it. Left in place deliberately.
//
// History, so the reversal is not re-reversed: an early design derived these as
// manufacturing + 24 months and rendered them read-only. That was corrected
// 2026-08-20 to TYPED-by-the-supervisor, because shelf life varies by product
// and there is nothing to calculate from. Two days later the field was dropped
// altogether. Do NOT reintroduce a 24-month default in either direction.
model mrn_line_batches {
  id              Int       @id @default(autoincrement())
  lineId          Int
  line            mrn_lines @relation(fields: [lineId], references: [id], onDelete: Cascade)
  batchNo         Int
  qty             Int
  mfgMonth        Int
  mfgYear         Int
  // Nullable since v27.17 — see the block above. Not collected, not displayed.
  bestBeforeMonth Int?
  bestBeforeYear  Int?
  createdAt       DateTime  @default(now()) @db.Timestamptz(6)

  @@unique([lineId, batchNo])
}

// ── CI module — Goods Return Note (CI-Form), 2026-09-01 ──────────────────────
//
// The RETURN counterpart to MRN, running the opposite way: MRN is stock coming
// IN from TPW/CDC and is started by billing; CI is stock coming BACK from a
// customer and is started by the FLOOR SUPERVISOR on his phone, then finished
// by the billing operator at the desk.
//
// Spec: docs/prompts/drafts/web-update-2026-08-31-ci-module.md (v3.1, §6).
// DDL:  sql/2026-08-31-ci-module.sql — ALREADY RUN against production.
//
// ⚠ HAND-MIRRORED FROM THE LIVE DATABASE, field by field, on 2026-09-01.
// `npx prisma db pull` cannot run on this machine (P1001 — the Supabase direct
// host is IPv6-only, the depot ISP is IPv4-only; CORE §3). These three models
// were reconciled against information_schema.columns for name, type,
// nullability and numeric precision. Never `db push`, never `db pull`.
//
// 🔴 THREE TABLES, NOT FOUR — THERE IS DELIBERATELY NO BATCH CHILD TABLE.
// MRN needs mrn_line_batches because one inbound line can split across
// manufacturing dates. A CI takes a single quantity per line and has nothing to
// split, and v1 captures no manufacturing dates at all. Copying MRN's schema
// wholesale is the obvious mistake, which is why this is written down. If mfg
// dates are ever added they need a child table — a mfgMonth/mfgYear pair on the
// line cannot express a split — and do NOT copy MRN's bestBefore* pair, nullable
// since v27.17 and retired from every surface.

// The reason picker's vocabulary. A MASTER TABLE, NOT A CHECK CONSTRAINT
// (spec §3.1): the list will change, and a CHECK makes every change a schema
// migration. Retire a reason with isActive = false and NEVER DELETE — old CIs
// must keep pointing at the reason they were raised under, which is also why
// ci_returns snapshots `reasonLabel` beside the FK.
//
// 8 rows live (sortOrder 1-8; the first three isPinned, shown above a divider
// in the picker with the rest under "More"). They are ALSO in prisma/seed.ts —
// without that, a wipe-and-reseed leaves this table EMPTY and the reason picker
// breaks with no error message.
model ci_reason_master {
  id        Int          @id @default(autoincrement())
  code      String       @unique
  label     String
  sortOrder Int
  isPinned  Boolean      @default(false)
  isActive  Boolean      @default(true)
  createdAt DateTime     @default(now()) @db.Timestamptz(6)

  ciReturns ci_returns[] @relation("CiReturnReason")
}

// The CI header. 31 columns.
//
// 🔴 THREE LIVE CHECK CONSTRAINTS — NOT EXPRESSIBLE IN PRISMA (CORE §7.4), so
// they are invisible in this file and are recorded here by hand:
//   chk_ci_returns_status         CHECK (status IN ('draft','submitted','closed','returned_to_floor'))
//   chk_ci_returns_return_type    CHECK ("returnType" IN ('full','part'))
//   chk_ci_returns_material_moved CHECK ("materialMoved" IN ('moved','not_moved'))
//   chk_ci_returns_complete_when_not_draft
//     CHECK (status = 'draft' OR ("materialMoved" IS NOT NULL
//            AND "materialReceivedDate" IS NOT NULL
//            AND "reasonId" IS NOT NULL AND "reasonLabel" IS NOT NULL))
//
// 🔴 THE FOURTH ONE IS LOAD-BEARING: IT IS WHAT STOPS AN INCOMPLETE CI BEING
// SUBMITTED. Those four columns are NULLABLE precisely so a draft can exist
// before the supervisor has answered the details step (owner ruling
// 2026-09-01 — a draft carries NULL, never a placeholder). This CHECK is what
// makes that safe: nullable in a draft, MANDATORY the moment status stops
// being 'draft'. Without it, "nullable" would mean a submitted CI could be
// missing its reason.
//
// ⚠ IT IS THE BACKSTOP, NOT THE ERROR MESSAGE. app/api/ci/[ciId]/submit/route.ts
// validates all four itself and names the missing one, because a raw
// "violates check constraint chk_ci_returns_complete_when_not_draft" reaching a
// supervisor's phone is not something he can act on. If that string ever
// surfaces in the UI, the route's guard has a hole — fix the guard, do not
// weaken the CHECK.
//
// ⚠ A NULL "materialMoved" also satisfies chk_ci_returns_material_moved above:
// `NULL = ANY(ARRAY[...])` is NULL, and a CHECK passes on anything that is not
// FALSE. The two constraints therefore compose correctly and neither needed
// changing when the columns went nullable.
// A FOURTH status value needs a SQL ALTER on chk_ci_returns_status in the
// Supabase SQL Editor FIRST — never just a new string in application code. This
// is the same trap chk_pick_assignments_status documents, and it is why
// 'returned_to_floor' is already in the list from day one (spec §11.1) even
// though no UI writes it yet: allowing an unused value costs nothing, ALTERing a
// live CHECK later does not.
//
// 🔴 THREE FKs TO `users` — supervisorId / billingOperatorId / voidedById. All
// three carry an explicitly NAMED @relation on BOTH sides (back-relations on the
// users model). An unnamed one is a Prisma ambiguity ERROR at generate time, not
// a warning — CORE §7.3.
model ci_returns {
  id                   Int                    @id @default(autoincrement())
  // ⚠ NULLABLE, AND THAT IS THE WHOLE POINT (spec §6, "ciNumber is NULLABLE").
  // A DRAFT CARRIES NO NUMBER: the write order is insert header → insert lines →
  // allocate the number and flip to 'submitted', so a failure part-way leaves a
  // numberless draft rather than a numbered CI with no lines on the floor's
  // screen. Every list, board, marker and search filters `status <> 'draft'`, so
  // a null-numbered row is never user-visible; if one is visible, the FILTER is
  // missing, not the number.
  // ⚠ Postgres treats NULLs as DISTINCT under a unique index, so any number of
  // concurrent drafts coexist. The live index has NO `NULLS NOT DISTINCT` — do
  // not add it, it would permit exactly one draft at a time depot-wide.
  ciNumber             String?                @unique
  status               String

  // ── the bill ──────────────────────────────────────────────────────────────
  // 🔴 orderId IS THE IDENTITY OF THE BILL, never invoiceNo (spec §4).
  orderId              Int
  order                orders                 @relation("CiReturnOrder", fields: [orderId], references: [id], onDelete: Restrict)
  // Snapshot, and also the TEXT join key to import_raw_line_items — there is NO
  // FK from `orders` to its line items; Picking and Floor both join on the
  // string, and CI does the same.
  obdNumber            String
  // ⚠ NULLABLE ON PURPOSE AND LOAD-BEARING (spec §4). 5.0% of bills dispatched
  // in the last 30 days carry no invoice number, and 429 `dispatched` rows going
  // back to 2026-05-15 never received one. The supervisor is NEVER BLOCKED.
  // 🔴 DO NOT BUILD A BACK-FILL JOB. The CI holds orderId, so any screen reads
  // the invoice number through the order at render time and it simply appears
  // once SAP sends it. This is the ONE place CI deliberately does not snapshot:
  // print and export must PREFER the live order value and fall back to this,
  // never the reverse. A patch job would fight that and could rewrite a closed
  // document.
  invoiceNo            String?
  invoiceDate          DateTime?              @db.Date
  soNumber             String?
  customerId           Int?
  customer             delivery_point_master? @relation("CiReturnCustomer", fields: [customerId], references: [id], onDelete: SetNull)
  customerCode         String?
  customerName         String?

  // ── stage 1 (floor supervisor, phone) ─────────────────────────────────────
  // `returnType` is answered on the FIRST screen (Full bill / Part), so it is
  // NOT NULL — a draft cannot exist without it.
  returnType           String
  // 🔴 THE NEXT FOUR ARE NULLABLE, AND THAT IS THE OWNER'S RULING (2026-09-01).
  // A DRAFT CARRIES NULL FOR THE STAGE-1 ANSWERS — no placeholders, ever.
  //
  // The details screen that collects them comes AFTER the line selection, so
  // between the draft insert and the details step these genuinely have no
  // value. The earlier shape forced the draft route to invent defaults
  // ("not_moved", today, reason 1) that were never true and had to be patched
  // before submit; inventing a fact to satisfy a NOT NULL is how a wrong fact
  // reaches a printed document when the patch is later forgotten.
  //
  // What makes this safe is chk_ci_returns_complete_when_not_draft (see the
  // block above this model): the moment `status` stops being 'draft' all four
  // must be present. Nullable in a draft, mandatory in a record.
  materialMoved        String?
  materialReceivedDate DateTime?              @db.Date
  reasonId             Int?
  reason               ci_reason_master?      @relation("CiReturnReason", fields: [reasonId], references: [id], onDelete: Restrict)
  // Snapshot beside the FK, so renaming a reason never rewrites history.
  // Nullable for the same reason as `reasonId` above — they are written
  // together, at the details step, and the CHECK requires both on anything that
  // is not a draft.
  reasonLabel          String?
  reasonRemark         String?
  supervisorId         Int
  supervisor           users                  @relation("CiReturnSupervisor", fields: [supervisorId], references: [id], onDelete: Restrict)
  submittedAt          DateTime?              @db.Timestamptz(6)

  // ── stage 2 (billing operator, desk) ──────────────────────────────────────
  ciDate               DateTime?              @db.Date
  // 🔴 TWO SEPARATE NUMBERS, AND ONLY ONE OF THEM IS LABELLED (spec §5).
  // `ciNumber` above is OrbitOMS's own reference, allocated at submit.
  // `sapCiNumber` is SAP's, typed by billing after punching — and the billing
  // screen labels THAT field plain "CI number", which is exactly why the two
  // look mergeable. THEY ARE NOT. Merging leaves every pending CI with no way to
  // name it for the hours or days before SAP sees it.
  sapCiNumber          String?
  ciValue              Decimal?               @db.Decimal(12, 2)
  billingOperatorId    Int?
  billingOperator      users?                 @relation("CiReturnBillingOperator", fields: [billingOperatorId], references: [id], onDelete: SetNull)
  closedAt             DateTime?              @db.Timestamptz(6)

  // ── void (never hard-delete a numbered document) ───────────────────────────
  isVoided             Boolean                @default(false)
  voidReason           String?
  voidRemark           String?
  voidedAt             DateTime?              @db.Timestamptz(6)
  voidedById           Int?
  voidedBy             users?                 @relation("CiReturnVoidedBy", fields: [voidedById], references: [id], onDelete: SetNull)

  createdAt            DateTime               @default(now()) @db.Timestamptz(6)
  // ⚠ A REAL @updatedAt, NOT a plain @default(now()). The live column is
  // NOT NULL DEFAULT now(), which covers the INSERT only; @updatedAt is what
  // restamps it on every UPDATE. Getting this wrong is the shape that made
  // push_subscriptions.updatedAt a landmine (CORE §13) — and CI's live marker
  // keys on MAX(updatedAt), so a column that silently stops moving freezes the
  // board. Same as `mrn`.
  updatedAt            DateTime               @updatedAt @db.Timestamptz(6)

  lines                ci_return_lines[]

  // Index names below match the LIVE ones exactly (verified against pg_indexes
  // 2026-09-01) — Prisma's defaults happen to be identical, so no `map:` is
  // needed on any of them. Do not rename a field without checking that again.
  @@index([orderId])
  @@index([status])
  @@index([materialReceivedDate])
  // 🔴 BOTH search keys, and this pair IS spec §4's ruling in schema form: the
  // supervisor searches by invoice number OR OBD number, because 5% of bills
  // never get an invoice number at all.
  @@index([invoiceNo])
  @@index([obdNumber])
}

// One returned line. 12 columns.
model ci_return_lines {
  id                Int        @id @default(autoincrement())
  ciReturnId        Int
  ciReturn          ci_returns @relation(fields: [ciReturnId], references: [id], onDelete: Cascade)
  lineNumber        Int
  // A plain nullable Int, NOT a foreign key — deliberate. Spec §6 calls it a
  // "pointer back to import_raw_line_items" and names ON DELETE only for
  // ciReturnId; the live table has no FK here either. (Contrast pick_findings,
  // which does carry a UNIQUE FK to that table.)
  rawLineItemId     Int?

  // 🔴 The raw SAP material code. Resolved against `sku_master_v2.material` and
  // NOTHING ELSE — never a catalog row id. The old `sku_master` and
  // `sku_master_v2` assign COMPLETELY DIFFERENT ids to the same material code
  // (CORE §13, the id-space landmine), so following an id would print a
  // confidently WRONG product name on a signed goods-return document.
  skuCode           String
  skuDescription    String?
  packCode          String?

  // ⚠ SNAPSHOT of import_raw_line_items.unitQty, which is SAP's DELIVERY
  // quantity. THERE IS NO INVOICED-QUANTITY COLUMN ANYWHERE IN THIS DATABASE —
  // do not label this "invoiced qty" on a screen or in a later doc. Snapshotted
  // because a re-import PATCHES the raw line in place, and a closed CI must not
  // silently change what it claims was delivered.
  deliveryQty       Int?
  // What came back, in TINS — the only number the supervisor types.
  returnedQty       Int
  // Litres are CALCULATED, never typed (spec §6):
  //   litresPerTin      = import_raw_line_items.volumeLine / unitQty  (snapshot)
  //   returnedQtyLitres = litresPerTin × returnedQty                  (at save)
  // 🔴 GUARD THE DIVISION: unitQty is nullable and could be 0, giving
  // null/Infinity, which prints as garbage. If it is null or 0, leave
  // litresPerTin NULL and render the litres cell blank.
  // (12,3) NOT (12,2) — pack sizes carry three decimals and a 0.925 L pack would
  // round away at two (spec §6).
  litresPerTin      Decimal?   @db.Decimal(12, 3)
  returnedQtyLitres Decimal?   @db.Decimal(12, 3)

  createdAt         DateTime   @default(now()) @db.Timestamptz(6)

  // Live name ci_return_lines_ciReturnId_lineNumber_key — Prisma's default for
  // this pair is identical, so no `map:`. No separate index on ciReturnId: it is
  // the LEADING column here, which already serves every lookup by parent.
  @@unique([ciReturnId, lineNumber])
}
