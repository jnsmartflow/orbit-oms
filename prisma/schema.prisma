  // Phase 4 back-relations
  dispatchPlanOrders       dispatch_plan_orders[]
  pickListItems            pick_list_items[]
  changeQueue              dispatch_change_queue[]
  pickAssignment           pick_assignments?
  // Picking findings (2026-08-07) — many per order, one per raw line.
  // pick_findings has exactly ONE FK to `orders`, so this back-relation needs
  // no @relation name (same rule as push_subscriptions → users).
  pickFindings             pick_findings[]
  // CI returns (2026-09-01) — many CIs may be raised against one bill. NAMED
  // (@relation("CiReturnOrder")) because ci_returns is the side that could grow
  // a second FK here later; the name costs nothing now and is not a rename then.
  // ⚠ NO BEHAVIOUR HANGS OFF THIS. Spec §2: a CI never changes the order's
  // workflowStage or any other column — the FK is a stored link only.
  ciReturns                ci_returns[]              @relation("CiReturnOrder")
  // Billing · Telephonic SO tags (2026-09-22) — one row per tag that hit this
  // bill. NAMED in the CiReturnOrder style. A stored link only: the hold the
  // tag applies is written to dispatchStatus/heldAt like any other hold.
  soTagMatches             so_tag_matches[]          @relation("SoTagMatchOrder")
  // Billing · Pick delete (2026-09-27, Schema v27.42) — the decision that
  // cancelled THIS bill as a same-SO duplicate. NAMED in the SoTagMatchOrder
  // style. A stored link only: the cancel itself is workflowStage/dispatchStatus.
  pickDeleteDecisions      pick_delete_decisions[]   @relation("PickDeleteDeletedOrder")
  // Freight Trips (2026-10-02, Schema v27.51) — membership rows only. A STORED
  // LINK: no freight action ever writes this order (lib/freight-trips/*).
  freightTripBills         freight_trip_bills[]      @relation("FreightTripBillOrder")
  // Trip re-deliveries (2026-10-03, Schema v27.53) — this bill put on a LATER
  // trip after a truck came back. A STORED LINK: no re-delivery action writes
  // this order; its own tripDropId, stage and hold are untouched.
  tripRedeliveries         trip_redeliveries[]       @relation("TripRedeliveryOrder")
  // Billing Print v2 (2026-10-05, Schema v27.56) — this bill copied on a trip.
  // A STORED LINK: copying never writes this order (lib/billing/print.ts).
  tripBillCopies           trip_bill_copies[]        @relation("TripBillCopyOrder")
  // TM Remove OBD (Feature 1)
  isRemoved                Boolean                   @default(false)
  removalReason            String?
  removalRemark            String?
  removedAt                DateTime?                 @db.Timestamptz(6)
  removedById              Int?
  removedBy                users?                    @relation("OrderRemovedBy", fields: [removedById], references: [id])
  restoredAt               DateTime?                 @db.Timestamptz(6)
  restoredById             Int?
  restoredBy               users?                    @relation("OrderRestoredBy", fields: [restoredById], references: [id])
  // Operator Skip / Pause back-relations (Features 2 & 3)
  skipEvents               tint_skip_events[]
  pauseEvents              tint_pause_events[]
  // Hide (Feature A — manual one-off hide)
  isHidden                 Boolean                   @default(false)
  hiddenById               Int?
  hiddenReason             String?
  hiddenAt                 DateTime?                 @db.Timestamptz(6)
  // Picking manual early-release (5b, 2026-07-20). A supervisor may unlock a
  // future-dated bill so it can be picked TODAY. Persisted (not session-only)
  // so the release survives refresh and is visible to all three supervisors.
  //
  // Modelled as timestamp + actor columns, NOT as a new status/stage value —
  // the same call made for Checked/Approved (pick_assignments.checkedAt /
  // checkedById). `workflowStage` is untouched by a release: the bill stays
  // at `pending_picking`, it only stops being classified `upcoming` by
  // lib/picking/queue.ts's zone expression. Nothing new to teach
  // lib/workflow-stages.ts, and chk_pick_assignments_status is not involved.
  //
  // @db.Timestamptz(6) is REQUIRED — without it Prisma emits plain
  // `timestamp` and mismatches the live column (CLAUDE_CORE.md §7.1.c).
  pickEarlyReleasedAt      DateTime?                 @db.Timestamptz(6)
  pickEarlyReleasedById    Int?
  pickEarlyReleasedBy      users?                    @relation("OrderPickEarlyReleasedBy", fields: [pickEarlyReleasedById], references: [id])

  // Picking visibility marker (2026-09-09). Timestamp + actor, the SAME
  // modelling call as pickEarlyReleasedAt/ById directly above and as
  // invoicedAt/ById below — never a new workflowStage value and never a new
  // pick_assignments.status string (chk_pick_assignments_status is a live
  // CHECK constraint invisible in this file; CLAUDE_PICKING.md §7).
  //
  // ⚠ NOTHING CONSUMES THESE YET. Columns applied by hand in the Supabase SQL
  // Editor and mirrored here; no query, route, component or seed entry reads
  // or writes them at the time of this commit.
  //
  // @db.Timestamptz(6) is REQUIRED — without it Prisma emits plain `timestamp`
  // and mismatches the live column (CLAUDE_CORE.md §7.1.c). The @relation MUST
  // be named: `orders` carries many FKs to `users` and an unnamed one is a
  // Prisma ambiguity ERROR, not a warning.
  pickVisibleAt   DateTime? @db.Timestamptz(6)
  pickVisibleById Int?
  pickVisibleBy   users?    @relation("OrderPickVisibleBy", fields: [pickVisibleById], references: [id])

  // Billing · Picking tab mark-done marker (2026-07-30).
  // Timestamp + actor, NOT a new workflowStage value — same call already
  // made for pickedAt/ById, removedAt/ById, restoredAt/ById and
  // pickEarlyReleasedAt/ById. A bill leaves the billing Pending list when
  // invoicedAt is set; clearing it returns the bill to Pending (Undo).
  // @db.Timestamptz(6) is REQUIRED (CORE §7.1.c). The @relation MUST be
  // named — `orders` has many FKs to `users` and an unnamed one throws a
  // Prisma ambiguity error.
  invoicedAt   DateTime? @db.Timestamptz(6)
  invoicedById Int?
  invoicedBy   users?    @relation("OrderInvoicedBy", fields: [invoicedById], references: [id])

  // ── TRIP MODULE (2026-09-09) ──────────────────────────────────────────────
  //
  // THE ONE TRIP POINTER. Reach the trip via trip_drops.tripId — there is
  // deliberately NO `tripId` column here (owner decision). Two pointers can
  // disagree about the same bill and nothing in the database would catch it;
  // the `shipToOverride` boolean beside `shipToOverrideCustomerId` above is the
  // same shape and CORE §7.3 already flags it as a pair to keep in step by hand.
  //
  // NULL is the normal state — most bills are on no trip.
  //
  // Live FK: orders_tripDropId_fkey ... ON DELETE SET NULL. Removing a stop
  // returns its bills to the pool; it must never delete an order. Backed by
  // orders_tripDropId_idx, which is Prisma's default name for this shape, so
  // the @@index below needs no `map:`.
  tripDropId Int?
  tripDrop   trip_drops? @relation(fields: [tripDropId], references: [id], onDelete: SetNull)

  // The `loaded` stage's timestamp + actor (2026-09-09) — the SAME modelling
  // call as pickEarlyReleasedAt/ById, pickVisibleAt/ById and invoicedAt/ById
  // above: never a new pick_assignments.status string, because
  // chk_pick_assignments_status is a live CHECK invisible in this file that
  // permits only 'assigned' and 'picked' (CLAUDE_PICKING.md §7).
  //
  // ⚠ `loaded` ITSELF IS A workflowStage VALUE, and orders carries NO CHECK on
  // that column (verified live 2026-09-09: the only constraint on this table is
  // orders_obdNumber_key). So adding the stage is a constants edit in
  // lib/workflow-stages.ts with zero migration — these two columns are the
  // audit trail beside it, not the stage itself.
  //
  // @db.Timestamptz(6) is REQUIRED — without it Prisma emits a plain
  // `timestamp` and mismatches the live column (CORE §7.1.c). The @relation
  // MUST be named: this is the SEVENTH FK from `orders` to `users` and an
  // unnamed one is a Prisma ambiguity ERROR, not a warning (CORE §7.3).
  loadedAt   DateTime? @db.Timestamptz(6)
  loadedById Int?
  loadedBy   users?    @relation("OrderLoadedBy", fields: [loadedById], references: [id], onDelete: SetNull)

  // Billing "Hand" mark — the dealer collects from the depot (2026-09-24,
  // Schema v27.41, sql/2026-09-24-billing-mo-actions.sql). Carried from
  // mo_orders.handAt/ById by enrichment and dual-written by the billing actions
  // route. Timestamp + actor, the house shape for a decision.
  // 🔴 Hand is NEVER a dispatchStatus value — every board predicate pins
  // 'dispatch', so a new value would drop the bill off picking and billing.
  // Live FK orders_handById_fkey ON DELETE SET NULL (Prisma's default name, no
  // `map:`). The EIGHTH FK from `orders` to `users` — named on both sides.
  handAt   DateTime? @db.Timestamptz(6)
  handById Int?
  handBy   users?    @relation("OrderHandBy", fields: [handById], references: [id], onDelete: SetNull)

  // Picking Direct Loading (2026-10-03, Schema v27.52,
  // sql/2026-10-03-orders-direct-loaded.sql). A picking supervisor sent the bill
  // straight to pick_checked with no picker — loaded onto the vehicle from
  // stock. Timestamp + actor, the house shape for a decision: NOT a new
  // workflowStage value and NOT on pick_assignments (a bill with no picker has
  // no assignment row). 🔴 NOT loadedAt/loadedById above — those are reserved
  // for the future Vehicle Loading screen. No CHECK ties it to workflowStage:
  // Undo clears both columns. No index — every read is already narrowed by
  // workflowStage + a today window.
  // Live FK orders_directLoadedById_fkey ON DELETE SET NULL (Prisma's default
  // name, no `map:`). The NINTH FK from `orders` to `users` — named on both sides.
  directLoadedAt   DateTime? @db.Timestamptz(6)
  directLoadedById Int?
  directLoadedBy   users?    @relation("OrderDirectLoadedBy", fields: [directLoadedById], references: [id], onDelete: SetNull)

  // ── CHALLAN ORDERS (2026-10-06, Schema v27.60, sql/2026-10-06-challan-orders-ddl.sql,
  // run live by the owner the same day). Design:
  // docs/prompts/drafts/web-update-2026-10-06-challan-orders.md.
  //
  // isChallanOrder — TRUE on an ORB order (the challan itself, made on desktop
  // /place-order; obdNumber is ORB-YYYY-NNNNN). Live: boolean NOT NULL DEFAULT false.
  //
  // challanOrderId — on the SAP OBD that billing linked to a challan: the ORB
  // order it was billed against. The PER-OBD link (one SO can yield several
  // OBDs). Such a bill sits at workflowStage 'challan_linked' (lib/workflow-stages.ts),
  // which keeps it off every dispatch board.
  //
  // 🔴 A SELF-RELATION, so it is NAMED on both sides ("OrderChallanOrder").
  // onDelete: Restrict IS SPELLED OUT because the live FK orders_challanOrderId_fkey
  // is ON DELETE RESTRICT and Prisma's default for an OPTIONAL relation is SetNull.
  //
  // 🔴 THE FIRST CHECK CONSTRAINTS ON orders — NOT EXPRESSIBLE IN PRISMA. Live
  // pg_get_constraintdef text, read back 2026-10-06:
  //   chk_orders_challan_role:     CHECK ((NOT ("isChallanOrder" AND ("challanOrderId" IS NOT NULL))))
  //   chk_orders_challan_not_self: CHECK ((("challanOrderId" IS NULL) OR ("challanOrderId" <> id)))
  //   chk_orders_orb_number:       CHECK ((("isChallanOrder" AND ("obdNumber" ~ '^ORB-[0-9]{4}-[0-9]{5}$'::text)) OR ((NOT "isChallanOrder") AND ("obdNumber" !~ '^ORB-'::text))))
  // A writer that breaks one fails its write. The ORB shape is enforced by the
  // database: a SAP OBD can never carry an ORB- number, and an ORB order must.
  isChallanOrder      Boolean                  @default(false)
  challanOrderId      Int?
  challanOrder        orders?                  @relation("OrderChallanOrder", fields: [challanOrderId], references: [id], onDelete: Restrict)
  challanLinkedOrders orders[]                 @relation("OrderChallanOrder")
  // The SO-link rows (challan_order_so_links): TWO FKs from that table to
  // `orders`, so both relations are NAMED on both sides (CORE §7.3).
  challanSoLinks         challan_order_so_links[] @relation("ChallanSoLinkOrbOrder")
  challanSoLinksAsLinked challan_order_so_links[] @relation("ChallanSoLinkLinkedOrder")

  // Partial index created directly in Supabase, NOT expressible in Prisma
  // syntax — do NOT model it as @@index:
  //   orders_billing_pending_idx ON orders ("workflowStage")
  //   WHERE "invoicedAt" IS NULL AND "invoiceNo" IS NULL AND "isRemoved" = false
  // Backs the billing Pending list + its polled count badge.
  // Recorded by hand — db pull cannot run here (CORE §3).

  // Created directly in Supabase (orders_updatedAt_idx, "updatedAt" DESC).
  // Backs the picking change-marker's MAX(updatedAt) probe (app/api/picking/
  // marker/route.ts). Recorded here by hand — db pull cannot run on this
  // machine (CORE §3). Do NOT db push/pull.
  @@index([updatedAt(sort: Desc)])
  // Created directly in Supabase 2026-08-31 (orders_invoiceNo_idx) and mirrored
  // here so schema and database stay in step. Backs CI's stage-1 search, which
  // matches on invoiceNo OR obdNumber (spec §4): obdNumber already had two
  // indexes, invoiceNo had NONE, so half of every CI search was a sequential
  // scan. Prisma's default name for this is exactly `orders_invoiceNo_idx`, so
  // no `map:` is needed. Recorded by hand — db pull cannot run here (CORE §3).
  @@index([invoiceNo])
  // Created directly in Supabase 2026-09-09 (orders_tripDropId_idx). Pays for
  // "every order on this trip", which the trip band's progress bar, the derived
  // `ready` state and the trip sheet all ask. Prisma's default name for this
  // shape is exactly `orders_tripDropId_idx`, so no `map:` is needed.
  @@index([tripDropId])
  // Challan orders (2026-10-06, v27.60) — orders_challanOrderId_idx, Prisma's
  // default name, so no `map:`. Backs the FK and "the SAP bills of this challan".
  @@index([challanOrderId])
}

