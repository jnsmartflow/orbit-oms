// ─────────────────────────────────────────────
// BILLING v2 ROLLOUT (Phase 0 — 2026-07-30)
// ─────────────────────────────────────────────

/// Singleton settings row holding the Billing v2 master switch. Mirrors
/// attendance_settings' SHAPE (scope='GLOBAL' + rolloutStage) but is a SEPARATE
/// table on purpose: Billing's rollout must be pullable without touching the
/// attendance gate, and attendance_settings carries 20+ unrelated policy knobs.
///
/// `rolloutStage` is 'OFF' | 'TEST_USERS_ONLY' | 'ALL_USERS' — the same union as
/// auth.config.ts's RolloutStage. Enforced live by a CHECK constraint
/// (chk_billing_settings_rollout_stage), which Prisma cannot express — do NOT
/// try to model it. `scope` is UNIQUE (billing_settings_scope_key): that is what
/// keeps this a singleton and what the seed's ON CONFLICT targets.
///
/// Created by hand in the Supabase SQL Editor and hand-mirrored here — db pull
/// cannot run on this machine (CORE §3). Do NOT db push/pull.
model billing_settings {
  id           Int      @id @default(autoincrement())
  scope        String   @default("GLOBAL")
  rolloutStage String   @default("OFF")
  updatedAt    DateTime @updatedAt @db.Timestamptz(6)
  updatedById  Int?
  updatedBy    users?   @relation("BillingSettingsUpdatedBy", fields: [updatedById], references: [id])

  @@unique([scope])
}

/// Tag on/off switches, scoped (2026-09-11 · sql/2026-09-11-hide-tag-scope.sql).
/// One row per (tagKey, audience). `scope` says who the row is about:
///
///   'everyone' → roleSlug NULL, userId NULL
///   'role'     → roleSlug set,  userId NULL
///   'user'     → roleSlug NULL, userId set
///
/// Enforced live by chk_app_tag_settings_scope, which Prisma cannot express.
///
/// 🔴 `tagKey` IS NO LONGER @unique, AND THAT IS NOT AN OVERSIGHT. The live
/// uniqueness guarantee is THREE PARTIAL UNIQUE INDEXES, one per scope —
/// app_tag_settings_everyone_key ("tagKey") · _role_key ("tagKey","roleSlug") ·
/// _user_key ("tagKey","userId"). Prisma cannot model a partial index at all, so
/// there is nothing to write here; the old single-column UNIQUE was DROPPED on
/// live because it allowed only one row per tag and made exceptions impossible.
/// A plain composite @@unique would NOT be equivalent: Postgres treats NULLs as
/// distinct, so it would accept two 'everyone' rows for one tag.
///
/// ⚠ CONSEQUENCE FOR CODE: `upsert` is unavailable here — it needs a unique
/// Prisma knows about, and its native path emits ON CONFLICT against one. Writes
/// go findFirst → update-by-id / create / delete, as sequential awaits
/// (CORE §3). See app/api/admin/tag-settings/route.ts.
///
/// `userId` is a SCALAR with no relation, per the §7.10 convention for this
/// feature's tables (the live FK to users(id) ON DELETE CASCADE is real; it is
/// simply not modelled). Default-ON: no row for a tag ≡ the badge shows.
model app_tag_settings {
  id          Int       @id @default(autoincrement())
  tagKey      String
  scope       String    @default("everyone")
  roleSlug    String?
  userId      Int?
  isEnabled   Boolean   @default(true)
  updatedById Int?
  updatedAt   DateTime? @db.Timestamptz(6)

  @@index([userId])
  @@index([roleSlug])
}

/// Generic per-flag app settings (2026-09-09). One row per named switch,
/// keyed by `settingKey` (UNIQUE — app_settings_settingKey_key), which is what
/// keeps a flag a singleton and what any future seed ON CONFLICT would target.
///
/// ⚠ NOT the same table as `app_tag_settings` above, and not a replacement for
/// it. That one is per-BADGE (`tagKey`, default-ON: no row = badge shows,
/// CLAUDE_CORE.md §7.10). This one is per-FLAG and default-OFF, so an absent
/// row means the feature is off. Read the default before assuming either.
///
/// ⚠ NOTHING CONSUMES THIS YET — no query, route, component or seed entry.
///
/// `updatedById` carries a real FK to `users` (app_settings_updatedById_fkey),
/// unlike app_tag_settings' bare Int. Named on both sides, following
/// billing_settings' BillingSettingsUpdatedBy — the closest sibling that
/// actually has the relation.
///
/// Created by hand in the Supabase SQL Editor and hand-mirrored here — db pull
/// cannot run on this machine (CORE §3). Do NOT db push/pull.
model app_settings {
  id          Int      @id @default(autoincrement())
  settingKey  String   @unique
  isEnabled   Boolean  @default(false)
  updatedById Int?
  updatedBy   users?   @relation("AppSettingsUpdatedBy", fields: [updatedById], references: [id])
  // @default(now()) mirrors the live NOT NULL DEFAULT now(); @updatedAt is what
  // makes a Prisma UPDATE re-stamp it. Without the second directive the column
  // would fire on INSERT only and quietly go stale — the push_subscriptions /
  // sku_master_v2 trap. Neither directive changes the database.
  updatedAt   DateTime @default(now()) @updatedAt @db.Timestamptz(6)
}

model order_splits {
