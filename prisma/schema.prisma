  customerName             String?
  customerCode             String?
  deliveryRemarks          String?
  remarks                  String?
  billRemarks              String?
  soNumber                 String?
  dispatchStatus           String?                @default("Dispatch")
  dispatchPriority         String?                @default("Normal")
  shipToOverride           Boolean?               @default(false)
  slotToOverride           Boolean?               @default(false)
  shipToOverrideCustomerId Int?
  shipToOverrideCustomer   delivery_point_master? @relation("MoOrderShipToOverride", fields: [shipToOverrideCustomerId], references: [id])
  // Slot INTENT (Phase 2, 2026-07-30). The operator's dispatch-slot DECISION,
  // taken on the mail order before any OBD exists. Enrichment copies these into
  // orders.dispatchTargetDate/dispatchWindowId with dispatchSlotSource='manual'
  // BEFORE the dispatch-engine loop, so the engine's manual guard
  // (app/api/import/obd/route.ts:344) leaves the human's pick alone.
  // Both are meaningless alone — a date with no window is not a slot — so the
  // carry writes them together or not at all.
  // @db.Date (NOT Timestamptz): this is a calendar day, matching
  // orders.dispatchTargetDate. Live FK: mo_orders_dispatchwindowid_fkey
  // (lowercase — Postgres folded the unquoted name) ON DELETE SET NULL.
  dispatchTargetDate       DateTime?              @db.Date
  dispatchWindowId         Int?
  dispatchWindow           dispatch_slot_master?  @relation("MoOrderDispatchWindow", fields: [dispatchWindowId], references: [id])
  customerMatchStatus      String?                @default("unmatched")
  customerCandidates       String?
  status                   String                 @default("pending")
  punchedById              Int?
  punchedBy                users?                 @relation("MoOrderPunchedBy", fields: [punchedById], references: [id])
  punchedAt                DateTime?
  emailEntryId             String                 @unique
  totalLines               Int                    @default(0)
  matchedLines             Int                    @default(0)
  splitFromId              Int?
  splitLabel               String?
  isLocked                 Boolean                @default(false)
  notes                    String?
  // Billing marks (2026-09-24, Schema v27.41, sql/2026-09-24-billing-mo-actions.sql).
  // The INTENT, set on the mail order before any OBD exists:
  //   billOnlyAt/ById — billing pressed CI (bill-only; a full-bill CI is raised
  //                     when the OBD imports, via an so_tags row fromMailOrder)
  //   handAt/ById     — billing pressed Hand (the dealer collects); carried onto
  //                     orders.handAt/ById by enrichment
  // Timestamp + actor, never a status value. Live FKs mo_orders_billOnlyById_fkey
  // and mo_orders_handById_fkey, both ON DELETE SET NULL (Prisma default names).
  // mo_orders now has THREE FKs to `users` — every one named on both sides.
  //
  // 🔴 A PARTIAL INDEX — NOT EXPRESSIBLE IN PRISMA, recorded by hand:
  //   mo_orders_billOnly_soNumber_idx ON mo_orders ("soNumber")
  //     WHERE "billOnlyAt" IS NOT NULL
  //   Answers "is any mail order on this SO marked CI?" (enrichment skip,
  //   un-press, re-punch). It is NOT the @@index([soNumber]) at the foot of
  //   this model — that one is the FULL index mo_orders_soNumber_idx
  //   (2026-10-06, Schema v27.59); the partial one stays unmodelled. Same
  //   class as so_tags_soNumber_live_key.
  billOnlyAt               DateTime?              @db.Timestamptz(6)
  billOnlyById             Int?
  billOnlyBy               users?                 @relation("MoOrderBillOnlyBy", fields: [billOnlyById], references: [id], onDelete: SetNull)
  handAt                   DateTime?              @db.Timestamptz(6)
  handById                 Int?
  handBy                   users?                 @relation("MoOrderHandBy", fields: [handById], references: [id], onDelete: SetNull)
  // Who pressed ⚑ Hold on this mail order (2026-10-01, Schema v27.50,
  // sql/2026-10-01-mo-orders-held-by.sql). Set by the billing actions route on
  // a transition TO Hold, cleared on a transition off it. NULL with
  // dispatchStatus 'Hold' = the parser set it (or a pre-2026-10-01 press).
  // Enrichment reads heldById to log the bill's hold as billing's, not auto.
  // Live FK mo_orders_heldById_fkey ON DELETE SET NULL (Prisma default name).
  // mo_orders now has FOUR FKs to `users` — every one named on both sides.
  heldAt                   DateTime?              @db.Timestamptz(6)
  heldById                 Int?
  heldBy                   users?                 @relation("MoOrderHeldBy", fields: [heldById], references: [id], onDelete: SetNull)
  createdAt                DateTime               @default(now())
  // Maintained by the DATABASE, not by Prisma. Live column is
  // timestamptz NOT NULL DEFAULT now(), kept current by
  // trigger trg_mo_orders_updated_at (BEFORE UPDATE →
  // set_updated_at_mo_orders()). Verified against
  // information_schema 2026-08-10 before this line was written.
  //
  // ⚠ Deliberately NOT `@updatedAt`. That directive makes the
  // PRISMA CLIENT write the timestamp, which would only cover
  // writes that go through Prisma — the trigger already covers
  // every write, including raw SQL. Two writers for one column
  // is how they drift; the trigger is the single owner.
  //
  // This is the OPPOSITE case to push_subscriptions.updatedAt
  // (CORE §7.12 / §13), which is a plain @default(now()) with NO
  // trigger and therefore needs an explicit `updatedAt: new Date()`
  // on every write. Here the DB does it. Do not add either the
  // directive or manual writes.
  updatedAt                DateTime               @default(now())
  lines                    mo_order_lines[]
  remarks_list             mo_order_remarks[]

  // Full btree on "soNumber" (2026-10-06, Schema v27.59) — run by hand in the
  // Supabase SQL Editor: CREATE INDEX "mo_orders_soNumber_idx" ON
  // public.mo_orders USING btree ("soNumber"). Serves the Floor board's
  // Sales Officer read (salesOfficerByOrder, lib/floor/queries.ts) and
  // enrichment's findFirst by SO, which scanned all of mo_orders before it.
  @@index([soNumber], map: "mo_orders_soNumber_idx")
}

