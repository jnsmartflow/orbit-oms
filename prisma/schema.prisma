generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────

enum StatusDomain {
  dispatch
  tinting
  pick_list
  import
  workflow
  priority
}

enum SlotRuleType {
  time_based
  default
}

enum TinterType {
  TINTER
  ACOTONE
}

enum PackCode {
  ml_500  @map("500ml")
  L_0_9   @map("0.9L")
  L_0_925 @map("0.925L")
  L_1     @map("1L")
  L_3_6   @map("3.6L")
  L_3_7   @map("3.7L")
  L_4     @map("4L")
  L_9     @map("9L")
  L_9_25  @map("9.25L")
  L_10    @map("10L")
  L_15    @map("15L")
  L_18    @map("18L")
  L_18_5  @map("18.5L")
  L_20    @map("20L")
  L_22    @map("22L")
  L_30    @map("30L")
  L_40    @map("40L")
}

enum CustomerSalesOfficerRole {
  PRIMARY
  BACKUP
  JUNIOR
}

// ─────────────────────────────────────────────
// PHASE 1 — Config / Status
// ─────────────────────────────────────────────

model system_config {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

model role_master {
  id          Int          @id @default(autoincrement())
  name        String       @unique
  description String?
  users       users[]
  userRoles   user_roles[]
}

model user_roles {
  id          Int      @id @default(autoincrement())
  userId      Int
  roleId      Int
  isPrimary   Boolean  @default(false)
  createdAt   DateTime @default(now())
  createdById Int?

  user      users       @relation("UserRoleAssignments", fields: [userId], references: [id], onDelete: Cascade)
  role      role_master @relation(fields: [roleId], references: [id])
  createdBy users?      @relation("UserRoleCreator", fields: [createdById], references: [id])

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
}

model role_permissions {
  id        Int      @id @default(autoincrement())
  roleSlug  String // matches ROLES constants: "admin","dispatcher","support","tint_manager","tint_operator","floor_supervisor","picker"
  pageKey   String // e.g. "floor", "tint_manager", "import_obd", "customers", etc.
  canView   Boolean  @default(false)
  canImport Boolean  @default(false)
  canExport Boolean  @default(false)
  canEdit   Boolean  @default(false)
  canDelete Boolean  @default(false)
  updatedAt DateTime @updatedAt

  @@unique([roleSlug, pageKey])
}

model users {
  id                          Int                      @id @default(autoincrement())
  email                       String                   @unique
  phone                       String?                  @unique
  password                    String
  name                        String
  roleId                      Int
  role                        role_master              @relation(fields: [roleId], references: [id])
  isActive                    Boolean                  @default(true)
  // Superuser — the "may administer OrbitOMS" flag (2026-09-04, step 5 of the
  // role→user access conversion). Live column is boolean NOT NULL DEFAULT
  // false; hand-mirrored here, as CORE §3 requires (db push/pull are banned and
  // db pull additionally fails on this machine with P1001).
  //
  // 🔴 EVERY GATE THAT READS THIS ALSO ACCEPTS THE `admin` ROLE. See
  // isSuperuser()/requireSuperuser() in lib/rbac.ts. There is exactly ONE
  // superuser account and it is the only one that can reach the panic switch,
  // so the old role check is kept as a second arm until the flag is proven.
  // Do not drop the role arm here or anywhere else without a deliberate pass.
  isSuperuser                 Boolean                  @default(false)
  createdAt                   DateTime                 @default(now())
  updatedAt                   DateTime                 @updatedAt
  // Attendance fields (v27.0 + v27.1 rollout flag)
  attendanceConsentAt         DateTime?                @db.Timestamptz(6)
  attendanceConsentVersion    String?
  attendanceExempt            Boolean                  @default(false)
  attendanceTestUser          Boolean                  @default(false)
  // Billing v2 rollout (Phase 0, 2026-07-30) — per-USER opt-in for the new
  // Billing UI on /mail-orders. Column was created in the Supabase SQL Editor
  // and is hand-mirrored here; db push/pull are banned (CORE §3) and db pull
  // additionally fails on this machine with P1001.
  //
  // Deliberately NOT cached onto the JWT the way attendanceTestUser is — it is
  // read fresh per page load by lib/billing/flag.ts, so switching a user OFF
  // takes effect immediately instead of after the 5-minute token stale window.
  // See that file's header before "optimising" it into lib/auth.ts.
  billingV2TestUser           Boolean                  @default(false)
  // Notes-band text size on /mail-orders, in PIXELS (2026-08-07). Created in the
  // Supabase SQL Editor and hand-mirrored here — db push/pull are banned
  // (CORE §3) and db pull additionally fails on this machine with P1001.
  //
  // Live column: integer NOT NULL DEFAULT 11, with
  // chk_users_notes_font_size CHECK (notesFontSize >= 11 AND <= 20)
  // (widened from 15 on 2026-08-07).
  // Prisma cannot express that CHECK, so the 11-20 bound is enforced twice in
  // code — the API route rejects out-of-range writes, and
  // lib/mail-orders/notes-font-size.ts clamps on read. Widening the range means
  // changing the constraint AND both of those.
  //
  // Like billingV2TestUser above, deliberately NOT cached onto the JWT: it is
  // read fresh per page load in the mail-orders layout. Caching it behind the
  // 5-minute token stale window would let a reload show the OLD size after the
  // operator had already changed it.
  notesFontSize               Int                      @default(11)
  // Phase 2 back-relations
  importBatches               import_batches[]
  statusLogs                  order_status_logs[]
  manualTintEntries           manual_tint_entries[]    @relation("ManualTintEntryPerformedBy")
  tintAssignmentsAsOperator   tint_assignments[]       @relation("TintAssignmentOperator")
  tintAssignmentsAsManager    tint_assignments[]       @relation("TintAssignmentManager")
  tintLogs                    tint_logs[]
  // Phase 3 back-relations
  splitsAsOperator            order_splits[]           @relation("SplitOperator")
  splitsAsManager             order_splits[]           @relation("SplitManager")
  splitStatusLogs             split_status_logs[]      @relation("SplitStatusLogUser")
  tinterIssueEntries          tinter_issue_entries[]
  tinterIssueEntriesB         tinter_issue_entries_b[]
  shadeMasters                shade_master[]
  // Phase 3.5 back-relations
  challansPrinted             delivery_challans[]      @relation("ChallanPrintedBy")
  // Phase 4 back-relations
  plansCreated                dispatch_plans[]         @relation("PlanCreatedBy")
  plansConfirmed              dispatch_plans[]         @relation("PlanConfirmedBy")
  plansDispatched             dispatch_plans[]         @relation("PlanDispatchedBy")
  dispatchPlanOrders          dispatch_plan_orders[]   @relation("DPOrderAddedBy")
  pickListsAsPicker           pick_lists[]             @relation("PickListPicker")
  pickListsAssigned           pick_lists[]             @relation("PickListAssignedBy")
  pickListsVerified           pick_lists[]             @relation("PickListVerifiedBy")
  changesCreated              dispatch_change_queue[]  @relation("ChangeCreatedBy")
  changesAcknowledged         dispatch_change_queue[]  @relation("ChangeAcknowledgedBy")
  splitsPickedBy              order_splits[]           @relation("SplitPickedBy")
  ordersPickedBy              orders[]                 @relation("OrderPickedBy")
  pickAssignmentsAsPicker     pick_assignments[]       @relation("PickAssignmentPicker")
  pickAssignmentsAssigned     pick_assignments[]       @relation("PickAssignmentAssignedBy")
  pickAssignmentsChecked      pick_assignments[]       @relation("PickAssignmentCheckedBy")
  // Picking findings (2026-08-07) — TWO FKs from one table to `users`, so BOTH
  // sides must stay explicitly named or Prisma throws an ambiguity ERROR at
  // generate time. Same rule as the three PickAssignment* relations above.
  pickFindingsReported        pick_findings[]          @relation("PickFindingReportedBy")
  pickFindingsRecorded        pick_findings[]          @relation("PickFindingRecordedBy")
  // MRN back-relations (2026-08-20, v27.16 · extended 2026-09-01, v27.19) —
  // FIVE FKs from `mrn` to `users`, plus ONE from `mrn_lines` and ONE from
  // `mrn_photos`. All seven relations MUST stay explicitly named on BOTH sides
  // or Prisma throws an ambiguity ERROR at generate time, not a warning. Same
  // rule as the two PickFinding* above and the three PickAssignment* before
  // them — this is the largest such cluster in the schema, so it is also the
  // easiest one to half-edit.
  //
  // ⚠ The last two pairs (mrn_lines, mrn_photos) are each a SINGLE relation to
  // `users` and would generate without a name. They are named anyway, because
  // in this cluster the convention is: a link to an ACTOR is named, a
  // structural parent link is not (mrn_photos.mrn / .line, mrn_lines.mrn and
  // mrn_line_batches.line are all unnamed). Keep new ones on that side of the
  // line — an unnamed actor relation here reads as an oversight.
  mrnsCreated                 mrn[]                    @relation("MrnCreatedBy")
  mrnsUnloadingStarted        mrn[]                    @relation("MrnUnloadingStartedBy")
  mrnsUnloadingEnded          mrn[]                    @relation("MrnUnloadingEndedBy")
  mrnsRemoved                 mrn[]                    @relation("MrnRemovedBy")
  mrnsClosed                  mrn[]                    @relation("MrnClosedBy")
  mrnLinesChecked             mrn_lines[]              @relation("MrnLineCheckedBy")
  mrnPhotosCaptured           mrn_photos[]             @relation("MrnPhotoCapturedBy")
  // Mail Order back-relations
  mailOrdersPunched           mo_orders[]              @relation("MoOrderPunchedBy")
  // Billing CI / Hand marks (2026-09-24, Schema v27.41) — mo_orders now has
  // THREE FKs to `users` (punchedById, billOnlyById, handById), so all three
  // MUST stay explicitly named on BOTH sides or generate fails (CORE §7.3).
  mailOrdersBillOnly          mo_orders[]              @relation("MoOrderBillOnlyBy")
  mailOrdersHand              mo_orders[]              @relation("MoOrderHandBy")
  // Who pressed ⚑ Hold on a mail order (2026-10-01, Schema v27.50) — the FOURTH FK.
  moOrdersHeld                mo_orders[]              @relation("MoOrderHeldBy")
  // Freight Trips (2026-10-02, Schema v27.51) — all named on both sides.
  freightTripsCreated         freight_trips[]          @relation("FreightTripCreatedBy")
  freightTripsCancelled       freight_trips[]          @relation("FreightTripCancelledBy")
  freightBillsAdded           freight_trip_bills[]     @relation("FreightTripBillAddedBy")
  freightBillsRemoved         freight_trip_bills[]     @relation("FreightTripBillRemovedBy")
  freightTripActivity         freight_trip_activity[]  @relation("FreightTripActivityActor")
  lineStatuses                mo_line_status[]
  // Multi-role back-relations
  userRoles                   user_roles[]             @relation("UserRoleAssignments")
  userRolesCreated            user_roles[]             @relation("UserRoleCreator")
  // Attendance back-relations (v27.0)
  attendanceRecords           attendance_records[]     @relation("AttendanceUser")
  attendanceRecordsCreated    attendance_records[]     @relation("AttendanceCreatedBy")
  attendanceSummaries         attendance_summary[]
  attendanceSettingsUpdated   attendance_settings[]
  // OT (overtime) approval back-relations
  attendanceOtApprovals       attendance_records[]     @relation("AttendanceOtApprover")
  attendanceOtGraceCounters   attendance_ot_grace[]    @relation("AttendanceOtGraceUser")
  attendanceOtAudits          attendance_ot_audit[]    @relation("AttendanceOtAuditUser")
  attendanceOtAuditsPerformed attendance_ot_audit[]    @relation("AttendanceOtAuditPerformer")
  // TM Remove OBD / Operator Skip / Pause back-relations
  ordersRemoved               orders[]                 @relation("OrderRemovedBy")
  ordersRestored              orders[]                 @relation("OrderRestoredBy")
  // Picking early-release (5b, 2026-07-20) — FOURTH named users relation on
  // `orders`, alongside OrderPickedBy / OrderRemovedBy / OrderRestoredBy.
  // All four MUST stay explicitly named on both sides: an unnamed relation
  // here is a Prisma ambiguity ERROR, not a warning (CLAUDE_CORE.md §7.3).
  ordersPickEarlyReleased     orders[]                 @relation("OrderPickEarlyReleasedBy")
  ordersInvoicedBy            orders[]                 @relation("OrderInvoicedBy")
  // Picking visibility marker (2026-09-09) — another named users relation on
  // `orders`, same rule as the four above it. Named on both sides or generate
  // fails with an ambiguity error.
  ordersPickVisible           orders[]                 @relation("OrderPickVisibleBy")
  // The `loaded` stage's actor (2026-09-09) — the SEVENTH named users relation
  // on `orders`, alongside OrderPickedBy / OrderRemovedBy / OrderRestoredBy /
  // OrderPickEarlyReleasedBy / OrderInvoicedBy / OrderPickVisibleBy above.
  // Every one of the seven is explicitly named on BOTH sides; an unnamed one
  // makes the whole cluster ambiguous and Prisma ERRORS at generate time
  // (CORE §7.3). `orders.hiddenById` is deliberately a bare Int with no
  // relation at all and is not part of this count.
  ordersLoaded                orders[]                 @relation("OrderLoadedBy")
  // Billing Hand mark (2026-09-24, Schema v27.41) — the EIGHTH named users
  // relation on `orders`. Same rule: named on both sides or generate fails.
  ordersHand                  orders[]                 @relation("OrderHandBy")
  // Picking Direct Loading (2026-10-03, Schema v27.52) — the NINTH named users
  // relation on `orders`. Same rule: named on both sides or generate fails.
  ordersDirectLoaded          orders[]                 @relation("OrderDirectLoadedBy")
  // Trip module (2026-09-09) — FOUR FKs from `trips` to `users`. The largest
  // such cluster after Mrn*, and the same rule binds: all four MUST stay
  // explicitly named on BOTH sides or generate fails with an ambiguity ERROR.
  // Every one of the four is an ACTOR link, which is the side of the line this
  // schema's convention says to name (see the MRN note above).
  tripsCreated                trips[]                  @relation("TripCreatedBy")
  tripsReleased               trips[]                  @relation("TripReleasedBy")
  tripsDispatched             trips[]                  @relation("TripDispatchedBy")
  tripsCancelled              trips[]                  @relation("TripCancelledBy")
  tripsShown                  trips[]                  @relation("TripShownBy")
  tripsSentToBilling          trips[]                  @relation("TripSentToBillingBy")
  tripsBillingCopied          trips[]                  @relation("TripBillingCopiedBy")
  tripsBillingDone            trips[]                  @relation("TripBillingDoneBy")
  tripActivity               trip_activity[]          @relation("TripActivityActor")
  tripRedeliveriesCreated     trip_redeliveries[]      @relation("TripRedeliveryCreatedBy")
  tripBillCopies              trip_bill_copies[]       @relation("TripBillCopyCopiedBy")
  billingSettingsUpdated      billing_settings[]       @relation("BillingSettingsUpdatedBy")
  appSettingsUpdated          app_settings[]           @relation("AppSettingsUpdatedBy")
  tintSkipsAsActor            tint_skip_events[]       @relation("SkipActor")
  tintPausesAsOp              tint_pause_events[]      @relation("PauseOperator")
  tintPauseResumes            tint_pause_events[]      @relation("PauseResumer")
  // Sampling Library back-relations
  samplingRegisterCreated     sampling_register[]      @relation("SamplingRegisterCreatedBy")
  samplingUsageEntries        sampling_usage_log[]     @relation("SamplingUsageOperator")
  // Web Push — one user → many devices. Single FK to users, so no named relation.
  pushSubscriptions           push_subscriptions[]
  // Admin audit trail — one user → many logged actions. Single FK to users, so
  // no named relation (contrast the PickFinding*/Mrn* clusters above, which have
  // several FKs to `users` and MUST stay named on both sides — CORE §7.3).
  adminAuditLogs              admin_audit_log[]
  // CI (Goods Return Note) back-relations (2026-09-01) — THREE FKs from
  // `ci_returns` to `users`: supervisorId / billingOperatorId / voidedById.
  // ⚠ ALL THREE MUST STAY EXPLICITLY NAMED ON BOTH SIDES. Three FKs to the same
  // model is exactly the ambiguity CORE §7.3 records: an unnamed one is a Prisma
  // ERROR at generate time, not a warning. Same discipline as the Mrn*/
  // PickFinding* clusters above.
  ciReturnsAsSupervisor       ci_returns[]             @relation("CiReturnSupervisor")
  ciReturnsAsBillingOperator  ci_returns[]             @relation("CiReturnBillingOperator")
  ciReturnsVoided             ci_returns[]             @relation("CiReturnVoidedBy")
  // Billing · Telephonic SO tags (2026-09-22) — TWO FKs from `so_tags` to
  // `users`: addedById / removedById. BOTH MUST STAY EXPLICITLY NAMED ON BOTH
  // SIDES, or Prisma errors on ambiguity at generate time (CORE §7.3).
  soTagsAdded                 so_tags[]                @relation("SoTagAddedBy")
  soTagsRemoved               so_tags[]                @relation("SoTagRemovedBy")
  // Billing · Pick delete decisions (2026-09-27, Schema v27.42) — THREE FKs from
  // `pick_delete_decisions` to `users`: decidedById / undoneById /
  // deletedPickerId. ALL THREE MUST STAY EXPLICITLY NAMED ON BOTH SIDES (CORE §7.3).
  pickDeleteDecided           pick_delete_decisions[]  @relation("PickDeleteDecidedBy")
  pickDeleteUndone            pick_delete_decisions[]  @relation("PickDeleteUndoneBy")
  pickDeleteHeld              pick_delete_decisions[]  @relation("PickDeleteDeletedPicker")
  // Sales-officer order access (2026-09-29, Schema v27.43) — TWO FKs from
  // `so_order_access` to `users`: grantedById / revokedById. BOTH MUST STAY
  // EXPLICITLY NAMED ON BOTH SIDES (CORE §7.3).
  soAccessGranted             so_order_access[]        @relation("SoOrderAccessGrantedBy")
  soAccessRevoked             so_order_access[]        @relation("SoOrderAccessRevokedBy")
  // Challan orders — SO links (2026-10-06, Schema v27.60) — TWO FKs from
  // `challan_order_so_links` to `users`: linkedById / unlinkedById. BOTH MUST
  // STAY EXPLICITLY NAMED ON BOTH SIDES (CORE §7.3).
  challanSoLinksLinked        challan_order_so_links[] @relation("ChallanSoLinkLinkedBy")
  challanSoLinksUnlinked      challan_order_so_links[] @relation("ChallanSoLinkUnlinkedBy")
  // Per-user page access (2026-09-04). One FK to `users`, so the relation is
  // deliberately UNNAMED — same call as pushSubscriptions and adminAuditLogs
  // above, and the opposite of the Mrn*/PickFinding*/CiReturn* clusters, which
  // have several FKs each and MUST stay named on both sides (CORE §7.3).
  pageAccess                  user_page_access[]
}

// Per-user page permissions — the table the role→user access conversion is
// built on. Created and filled by sql/2026-09-04-user-page-access.sql (step 2),
// which verified all 1,053 rows byte-for-byte against what role_permissions
// grants today: 39 users x 27 ALL_PAGE_KEYS, PARITY OK, 0 diffs.
//
// 🔴 NOTHING READS THIS FOR ACCESS YET. Every gate and every menu still resolves
// through role_permissions (lib/permissions.ts). /admin/access reads and writes
// this table, and editing it changes what NOBODY can do until step 4 repoints
// the resolvers. Do not wire a gate to it early — a half-flipped source is how
// people lose access silently.
//
// Hand-mirrored from live, as CORE §3 requires: db push and db pull are banned,
// and db pull additionally fails on this machine with P1001.
model user_page_access {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      users    @relation(fields: [userId], references: [id], onDelete: Cascade)
  pageKey   String
  canView   Boolean  @default(false)
  canImport Boolean  @default(false)
  canExport Boolean  @default(false)
  canEdit   Boolean  @default(false)
  canDelete Boolean  @default(false)
  // ⚠ BOTH need @db.Timestamptz(6) or Prisma emits plain `timestamp` and
  // mismatches the live columns, which are `timestamp with time zone`.
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  // @updatedAt as well as the default: the live column is NOT NULL DEFAULT
  // now() (which covers inserts), and @updatedAt makes Prisma advance it on
  // every edit. This table is EDITED, unlike push_subscriptions, whose plain
  // @default(now()) CORE §7.12 records — the difference is deliberate.
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  // Explicit map: on both — the live names are hand-made by the step-2 SQL and
  // are not what Prisma would generate. Same reason admin_audit_log's three
  // indexes carry one (CORE §7.13).
  //
  // The UNIQUE is a real constraint, not just an index: it is the ON CONFLICT
  // target for the save route's upserts, and with userId LEADING its index also
  // serves "every page for one person" — which is every read this screen does.
  @@unique([userId, pageKey], map: "user_page_access_user_page_key")
  @@index([pageKey], map: "user_page_access_page_idx")
}

// Web Push device subscriptions. Table created by hand in Supabase (11 cols,
// endpoint UNIQUE). camelCase columns, no @map. Timestamps carry
// @db.Timestamptz(6) or Prisma emits plain `timestamp` and mismatches the live
// column (CLAUDE_CORE.md §7.1.c). `updatedAt` has a DB DEFAULT now() but NO
// trigger — it is a PLAIN field (NOT @updatedAt); every write sets it
// explicitly (see lib/push/send.ts + the subscribe/unsubscribe routes).
model push_subscriptions {
  id           Int       @id @default(autoincrement())
  userId       Int
  user         users     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint     String    @unique(map: "push_subscriptions_endpoint_key")
  p256dh       String
  auth         String
  userAgent    String?
  isActive     Boolean   @default(true)
  failureCount Int       @default(0)
  lastSeenAt   DateTime? @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime  @default(now()) @db.Timestamptz(6)
}

// Admin audit trail — WHO changed WHAT, for the admin writes that record no
// actor on the row itself (v27.18, 2026-09-01). Table created BY HAND in the
// Supabase SQL Editor by the owner and hand-mirrored here; never db push, never
// db pull (CORE §3 — db pull also fails P1001 on this machine). camelCase
// columns, NO @map — the live names already match.
//
// `createdAt` carries @db.Timestamptz(6) or Prisma emits plain `timestamp` and
// silently mismatches the live `timestamp with time zone` (CORE §7.1.c).
//
// APPEND-ONLY BY CONVENTION, not by constraint. Nothing in the schema stops an
// UPDATE or DELETE — the discipline lives in the fact that `lib/audit/log.ts` is
// the only writer and only ever inserts. Do not add an edit path.
//
// 🔴 `id` is BigInt, matching the live BIGSERIAL and the tint_skip_events /
// tint_pause_events precedent. JSON.stringify THROWS on a BigInt
// ("Do not know how to serialize a BigInt"), so a future read API must convert
// (`Number(row.id)` or `.toString()`) before returning rows. The write helper is
// safe today only because it never returns the created row.
//
// 🔴 beforeData / afterData MUST NEVER contain a password or a password hash.
// The redaction lives in lib/audit/log.ts, not here — Prisma cannot enforce it.
model admin_audit_log {
  id         BigInt   @id @default(autoincrement())
  userId     Int
  user       users    @relation(fields: [userId], references: [id])
  entity     String
  entityId   String?
  action     String
  summary    String?
  beforeData Json?
  afterData  Json?
  createdAt  DateTime @default(now()) @db.Timestamptz(6)

  // Explicit `map:` on all three — the live index names are hand-made and do
  // not match what Prisma would generate by default. Same reason
  // pick_findings_order_idx carries one (CORE §7.4).
  @@index([createdAt(sort: Desc)], map: "admin_audit_log_created_idx")
  @@index([entity, entityId], map: "admin_audit_log_entity_idx")
  @@index([userId], map: "admin_audit_log_user_idx")
}

model status_master {
  id          Int          @id @default(autoincrement())
  domain      StatusDomain
  code        String
  label       String
  sortOrder   Int
  isActive    Boolean      @default(true)
  description String?
  createdAt   DateTime     @default(now())

  @@unique([domain, code])
}

// ─────────────────────────────────────────────
// PHASE 1 — SKU Hierarchy
// ─────────────────────────────────────────────

model product_category {
  id           Int            @id @default(autoincrement())
  name         String         @unique
  isActive     Boolean        @default(true)
  createdAt    DateTime       @default(now())
  productNames product_name[]
  skus         sku_master[]
}

model product_name {
  id         Int              @id @default(autoincrement())
  name       String           @unique
  categoryId Int
  category   product_category @relation(fields: [categoryId], references: [id])
  isActive   Boolean          @default(true)
  createdAt  DateTime         @default(now())
  skus       sku_master[]
}

model base_colour {
  id        Int          @id @default(autoincrement())
  name      String       @unique
  isActive  Boolean      @default(true)
  createdAt DateTime     @default(now())
  skus      sku_master[]
}

model sku_master {
  id                Int                          @id @default(autoincrement())
  skuCode           String                       @unique
  skuName           String
  productCategoryId Int
  productCategory   product_category             @relation(fields: [productCategoryId], references: [id])
  productNameId     Int
  productName       product_name                 @relation(fields: [productNameId], references: [id])
  baseColourId      Int
  baseColour        base_colour                  @relation(fields: [baseColourId], references: [id])
  packSize          String
  containerType     String
  unitsPerCarton    Int?
  isActive          Boolean                      @default(true)
  createdAt         DateTime                     @default(now())
  updatedAt         DateTime                     @updatedAt
  // Phase 2 back-relation
  enrichedLineItems import_enriched_line_items[]
}

// ─────────────────────────────────────────────
// PHASE 1 — Transporter / Vehicle
// ─────────────────────────────────────────────

model transporter_master {
  id                Int              @id @default(autoincrement())
  name              String           @unique
  contactPerson     String?
  phone             String?
  email             String?
  isActive          Boolean          @default(true)
  // Trip module (2026-09-09). Live column: boolean NOT NULL DEFAULT false.
  //
  // TRUE = a real carrier, offered in the trip's transporter picker. FALSE = an
  // SAP status code that arrived as a name — DELETE, CANCEL, HAND, PORTER,
  // ewaybill, PICK DELETED, CI. Seven of the 25 live rows are that kind. They
  // are KEPT, not deleted: historical orders may point at them and CORE §3
  // forbids deleting anyway.
  //
  // ⚠ NOT the same question as `isActive` directly above, which means "is this
  // carrier still trading". A row can be real and inactive. Same distinction
  // sku_master_v2 draws between isPrimary and isActive (CORE §7.1.c) — do not
  // conflate them or fold one into the other.
  //
  // Default FALSE is the safe direction: an unmarked row is simply absent from
  // a picker, which is recoverable, rather than silently offered.
  isRealTransporter Boolean          @default(false)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  vehicles          vehicle_master[]
  // Trip module (2026-09-09). ONE FK from `trips` to this model, so the
  // relation is deliberately UNNAMED — same call as `vehicles` above.
  trips             trips[]
  // Freight Trips (2026-10-02) — ONE FK from freight_trips, so unnamed too.
  freightTrips      freight_trips[]
}

// ─────────────────────────────────────────────
// PHASE 1 — Geography & Delivery
// ─────────────────────────────────────────────

model delivery_type_master {
  id                      Int                         @id @default(autoincrement())
  name                    String                      @unique
  createdAt               DateTime                    @default(now())
  areas                   area_master[]
  slotConfigs             delivery_type_slot_config[]
  dispatchDeliveryPoints  delivery_point_master[]     @relation("DispatchDeliveryType")
  reportingDeliveryPoints delivery_point_master[]     @relation("ReportingDeliveryType")
  // Trip module (2026-09-09). ONE FK from `trips`, so deliberately UNNAMED —
  // unlike the two above, which are named because delivery_point_master carries
  // TWO FKs here and would otherwise be ambiguous (CORE §7.3).
  trips                   trips[]
  // Route clubs (2026-09-19) — a club belongs to ONE delivery type. One FK from
  // route_clubs, so unnamed.
  routeClubs              route_clubs[]
  // Load plan rules (2026-09-19) — one row per delivery type, PK = this FK.
  loadPlanConfig          load_plan_config?
}

model slot_master {
  id                 Int                         @id @default(autoincrement())
  name               String                      @unique
  slotTime           String
  isNextDay          Boolean                     @default(false)
  isActive           Boolean                     @default(true)
  sortOrder          Int
  createdAt          DateTime                    @default(now())
  updatedAt          DateTime                    @updatedAt
  slotConfigs        delivery_type_slot_config[]
  orders             orders[]                    @relation("OrderCurrentSlot")
  ordersOriginalSlot orders[]                    @relation("OrderOriginalSlot")
  ordersArrival      orders[]                    @relation("OrderArrivalSlot")
  dispatchPlans      dispatch_plans[]
}

model dispatch_slot_master {
  id         Int         @id @default(autoincrement())
  windowTime String
  label      String?
  sortOrder  Int
  isActive   Boolean     @default(true)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  orders     orders[]    @relation("OrderDispatchWindow")
  // Phase 2 slot intent on the mail order. A SECOND relation on this table, but
  // to a DIFFERENT model, so there is no ambiguity trap — named on both sides
  // anyway, matching the house pattern.
  moOrders   mo_orders[] @relation("MoOrderDispatchWindow")
  // Trip module (2026-09-09). A THIRD relation on this table, again to a
  // DIFFERENT model, so there is no ambiguity trap — named anyway, matching the
  // house pattern its two siblings above already follow.
  trips      trips[]     @relation("TripDispatchWindow")
}

model delivery_type_slot_config {
  id             Int                  @id @default(autoincrement())
  deliveryTypeId Int
  deliveryType   delivery_type_master @relation(fields: [deliveryTypeId], references: [id])
  slotId         Int
  slot           slot_master          @relation(fields: [slotId], references: [id])
  slotRuleType   SlotRuleType
  windowStart    String?
  windowEnd      String?
  isDefault      Boolean              @default(false)
  isActive       Boolean              @default(true)
  sortOrder      Int
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@unique([deliveryTypeId, slotId])
}

model route_master {
  id                    Int                     @id @default(autoincrement())
  name                  String                  @unique
  description           String?
  /// The loading bay this route's material is stacked at (2026-08-21).
  /// NULLABLE and NOT UNIQUE — several routes share a bay (bay 1 serves Adajan,
  /// Parvat, Navsari, Chikhli, Bhagal and Olpad), and HAND / No Route have none.
  /// It is NOT a route id and it is NOT per delivery type: bay 1 carries Local
  /// and Upcountry routes both, so the number alone never identifies a lane.
  /// Column already exists in Supabase and was hand-mirrored here — CORE §3
  /// (never db push, never db pull, ALTER in the SQL Editor then generate).
  bayNumber             Int?
  isActive              Boolean                 @default(true)
  createdAt             DateTime                @default(now())
  areaRoutes            area_route_map[]
  primaryAreas          area_master[]           @relation("AreaPrimaryRoute")
  customerPrimaryRoutes delivery_point_master[] @relation("CustomerPrimaryRoute")
  /// Route clubs this route belongs to — at most one per delivery type (2026-09-19).
  clubMemberships       route_club_members[]
}

// ─────────────────────────────────────────────────────────────────────────────
// ROUTE CLUBS (2026-09-19) — routes that share one truck on a light day, shown
// as one card on the floor's By route view. Created by
// sql/2026-09-19-route-clubs.sql in the Supabase SQL Editor and hand-mirrored
// here (CORE §3 — never db push, never db pull).
//
// 🔴 THE RULE: a route is in AT MOST ONE club PER DELIVERY TYPE. A route has no
// delivery type of its own (it lives on area_master), so the type is on the
// club — and COPIED onto each member, because a unique can only see its own
// table's columns. The composite FK (clubId, deliveryTypeId) → route_clubs(id,
// deliveryTypeId) stops the copy ever disagreeing with the club, and with that
// in place UNIQUE (deliveryTypeId, routeId) IS the rule.
//
// ⚠ MEMBERSHIP IS NOT CHECKED AGAINST AREAS, deliberately: Kamrej has no Local
// area and still sits in a Local club (owner, 2026-09-19).
// ─────────────────────────────────────────────────────────────────────────────

model route_clubs {
  id             Int                  @id @default(autoincrement())
  deliveryTypeId Int
  deliveryType   delivery_type_master @relation(fields: [deliveryTypeId], references: [id], onDelete: Restrict, map: "route_clubs_delivery_type_fkey")
  /// The card heading, e.g. "Adajan + Olpad".
  name           String
  /// The card's fixed place in row 1 for its delivery type, 1 = leftmost.
  sortOrder      Int
  createdAt      DateTime             @default(now()) @db.Timestamptz(6)
  members        route_club_members[]

  // Looks redundant beside `id`, and is load-bearing: the TARGET of the members'
  // composite FK. Do not drop it.
  @@unique([id, deliveryTypeId], map: "route_clubs_id_type_key")
  @@unique([deliveryTypeId, name], map: "route_clubs_type_name_key")
  @@unique([deliveryTypeId, sortOrder], map: "route_clubs_type_sort_key")
}

// ─────────────────────────────────────────────────────────────────────────────
// LOAD PLAN CONFIG (2026-09-19) — the rules the Upcountry "Load plan" view packs
// suggested truckloads by (lib/trips/load-plan.ts). One row per delivery type.
// Created by sql/2026-09-19-load-plan-config.sql in the Supabase SQL Editor and
// hand-mirrored here (CORE §3 — never db push, never db pull).
//
// `config` jsonb: { smallMaxKg, bigMaxKg, mainRouteIds, partners: [{ routeId,
// joins, pick }] } — route IDS, never names. Validated on read by
// parseLoadPlanConfig; a missing or malformed row reads as "not set up".
// The live CHECK chk_load_plan_config_object (jsonb_typeof = 'object') is not
// expressible in Prisma. `updatedAt` is a plain @default(now()) — the table is
// written by SQL only, so there is no app write for @updatedAt to stamp.
// ─────────────────────────────────────────────────────────────────────────────

model load_plan_config {
  deliveryTypeId Int                  @id
  deliveryType   delivery_type_master @relation(fields: [deliveryTypeId], references: [id], onDelete: Restrict, map: "load_plan_config_delivery_type_fkey")
  config         Json
  updatedAt      DateTime             @default(now()) @db.Timestamptz(6)
}

/// What the Upcountry load plan suggested (sql/2026-09-21-load-plan-snapshot.sql).
/// source 'auto' = the 21:00 IST cron, at most one per day (partial unique index
/// load_plan_snapshot_auto_key, not expressible here); 'replan' = every Replan.
/// cards: [{ cardNo, type, vehicle, billIds, kg, stops, places }] — no rates.
model load_plan_snapshot {
  id      Int      @id @default(autoincrement())
  date    DateTime @db.Date
  takenAt DateTime @default(now()) @db.Timestamptz(6)
  source  String
  cards   Json

  @@index([date, source, takenAt], map: "load_plan_snapshot_date_idx")
}

model route_club_members {
  id             Int          @id @default(autoincrement())
  clubId         Int
  /// A COPY of the club's type, held equal to it by the composite FK below.
  deliveryTypeId Int
  routeId        Int
  /// 1 = the main route, 2 = the sub. The card lists routes in this order.
  sortOrder      Int
  club           route_clubs  @relation(fields: [clubId, deliveryTypeId], references: [id, deliveryTypeId], onDelete: Cascade, map: "route_club_members_club_fkey")
  route          route_master @relation(fields: [routeId], references: [id], onDelete: Restrict, map: "route_club_members_route_fkey")

  @@unique([deliveryTypeId, routeId], map: "route_club_members_type_route_key")
  @@unique([clubId, sortOrder], map: "route_club_members_club_sort_key")
}

model area_master {
  id             Int                     @id @default(autoincrement())
  name           String
  deliveryTypeId Int
  deliveryType   delivery_type_master    @relation(fields: [deliveryTypeId], references: [id])
